@page "/account/wishlist"
@using Lapak.Models
@using Microsoft.EntityFrameworkCore
@inject Lapak.Data.LapakDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<div class="page-header"><h1 class="page-title">Wishlist Saya</h1><p class="page-subtitle">@_items.Count produk disimpan</p></div>
@if (!_items.Any()) { <div class="text-center mt-4"><div style="font-size:5rem;">❤️</div><h3>Wishlist kosong</h3><a href="/products" class="btn btn-primary mt-2">Jelajahi Produk</a></div> }
else { <div class="product-grid">
@foreach (var wi in _items) { var p = wi.Product; var url = "/products/" + p.Slug;
<div class="product-card"><div style="position:relative;">
<div class="product-image" style="display:flex;align-items:center;justify-content:center;font-size:4rem;background:var(--bg-tertiary);min-height:200px;" @onclick="() => Nav.NavigateTo(url)">📦</div>
<button style="position:absolute;top:8px;right:8px;background:var(--danger);color:white;border:none;border-radius:50%;width:32px;height:32px;cursor:pointer;" @onclick="() => RemoveWishlist(wi)">✕</button></div>
<div class="product-info" @onclick="() => Nav.NavigateTo(url)"><div class="product-name">@p.Name</div><div class="product-store">@p.Store?.Name</div><div class="product-price">Rp@(p.Price.ToString("N0"))</div></div>
<div style="padding:0 16px 16px;"><button class="btn btn-primary btn-sm btn-block" @onclick="() => AddToCart(p)">Masukkan Keranjang</button></div></div> }
</div> }

@code {
    private List<WishlistItem> _items = new(); private Guid _userId;
    protected override async Task OnInitializedAsync() {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(uid)) { Nav.NavigateTo("/account/login"); return; }
        _userId = Guid.Parse(uid);
        _items = Db.WishlistItems.Include(w => w.Product).ThenInclude(p => p.Store).Where(w => w.UserId == _userId).ToList();
    }
    private async Task RemoveWishlist(WishlistItem wi) { Db.WishlistItems.Remove(wi); Db.SaveChanges(); _items.Remove(wi); }
    private async Task AddToCart(Product p) { var ex = Db.CartItems.FirstOrDefault(c => c.UserId == _userId && c.ProductId == p.Id); if (ex != null) ex.Quantity++; else Db.CartItems.Add(new CartItem { UserId = _userId, ProductId = p.Id, Quantity = 1 }); Db.SaveChanges(); Nav.NavigateTo("/cart"); }
}
