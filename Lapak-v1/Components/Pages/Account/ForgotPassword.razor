@page "/account/forgot-password"

<div class="auth-container">
    <h2 class="auth-title">Lupa Password</h2>
    <p class="auth-subtitle">Masukkan email akunmu. Kami akan kirim link reset password.</p>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="toast success mb-2">@_message</div>
    }

    <div class="form-group">
        <label class="form-label">Email</label>
        <input class="form-input" @bind="_email" type="email" placeholder="nama@email.com" />
    </div>

    <button class="btn btn-primary btn-lg btn-block" @onclick="SendReset">Kirim Link Reset</button>
    <p class="text-center mt-3">Sudah ingat password? <a href="/account/login">Masuk</a></p>
</div>

@code {
    private string _email = string.Empty;
    private string _message = string.Empty;

    private void SendReset()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _message = "Email harus diisi.";
            return;
        }

        _message = "Jika email terdaftar, link reset password sudah kami kirim. Cek inbox/spam ya!";
    }
}
