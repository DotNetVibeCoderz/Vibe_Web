@using Lapak.Models

<div class="product-card" @onclick="OnClick">
    @if (Product.DiscountPercentage > 0)
    {
        <span class="product-badge">-@Product.DiscountPercentage%</span>
    }
    <div class="product-image" style="display:flex;align-items:center;justify-content:center;font-size:4rem;background:var(--bg-tertiary);min-height:200px;">
        @GetProductIcon()
    </div>
    <div class="product-info">
        <div class="product-name" title="@Product.Name">@Product.Name</div>
        <div class="product-store">🏪 @Product.Store?.Name</div>
        <div class="product-price-row">
            <span class="product-price">Rp@(Product.Price.ToString("N0"))</span>
            @if (Product.OriginalPrice > Product.Price)
            {
                <span class="product-original-price">Rp@(Product.OriginalPrice?.ToString("N0"))</span>
            }
        </div>
        <div class="product-stats">
            <span>⭐ @Product.AverageRating.ToString("F1")</span>
            <span>📦 @Product.SoldCount</span>
            <span>❤️ @Product.LikeCount</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public Product Product { get; set; } = null!;
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetProductIcon()
    {
        var cat = Product.Category?.Name?.ToLower() ?? "";
        if (cat.Contains("smartphone")) return "📱";
        if (cat.Contains("laptop")) return "💻";
        if (cat.Contains("audio") || cat.Contains("headphone")) return "🎧";
        if (cat.Contains("kamera")) return "📷";
        if (cat.Contains("pakaian") || cat.Contains("fashion")) return "👕";
        if (cat.Contains("sepatu")) return "👟";
        if (cat.Contains("tas")) return "👜";
        if (cat.Contains("jam")) return "⌚";
        if (cat.Contains("furniture") || cat.Contains("meja") || cat.Contains("kursi")) return "🪑";
        if (cat.Contains("dapur")) return "🍳";
        if (cat.Contains("skincare") || cat.Contains("makeup") || cat.Contains("kecantikan")) return "💄";
        if (cat.Contains("makanan")) return "🍔";
        if (cat.Contains("minuman") || cat.Contains("kopi")) return "☕";
        if (cat.Contains("buku")) return "📚";
        if (cat.Contains("olahraga") || cat.Contains("fitness")) return "🏋️";
        if (cat.Contains("otomotif")) return "🚗";
        return "📦";
    }
}
