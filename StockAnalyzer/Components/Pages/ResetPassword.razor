@page "/reset-password"
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@layout StockAnalyzer.Components.Layout.AuthLayout

<PageTitle>Reset Password - StockAnalyzer</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-logo">🔑</span>
            <h2>Reset Password</h2>
            <p>Enter your email to receive a password reset token</p>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-error" : "alert-success")">
                <span>@(isError ? "⚠️" : "✅")</span> @message
            </div>
        }

        @if (!showTokenStep)
        {
            <EditForm Model="emailModel" OnValidSubmit="SendResetToken" FormName="reset-email">
                <div class="form-group">
                    <label for="email">Email</label>
                    <InputText id="email" class="form-control" @bind-Value="emailModel.Email" placeholder="you@example.com" />
                </div>
                <button type="submit" class="btn btn-primary btn-full" disabled="@isLoading">
                    @(isLoading ? "Sending..." : "📧 Send Reset Link")
                </button>
            </EditForm>
        }
        else
        {
            <EditForm Model="resetModel" OnValidSubmit="HandleResetPassword" FormName="reset-pass">
                <div class="form-group">
                    <label for="token">Reset Token</label>
                    <InputText id="token" class="form-control" @bind-Value="resetModel.Token" placeholder="Paste reset token here" />
                </div>
                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <InputText id="newPassword" type="password" class="form-control" @bind-Value="resetModel.NewPassword" placeholder="New password" />
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password</label>
                    <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="resetModel.ConfirmPassword" placeholder="Confirm new password" />
                </div>
                <button type="submit" class="btn btn-primary btn-full" disabled="@isLoading">
                    @(isLoading ? "Resetting..." : "🔒 Reset Password")
                </button>
            </EditForm>
        }

        <div class="auth-footer">
            <p><a href="/login">Back to Login</a></p>
        </div>
    </div>
</div>

@code {
    private EmailModel emailModel = new();
    private ResetModel resetModel = new();
    private string? message;
    private bool isError;
    private bool isLoading;
    private bool showTokenStep;

    private class EmailModel { public string Email { get; set; } = ""; }
    private class ResetModel
    {
        public string Token { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    private async Task SendResetToken()
    {
        isLoading = true;
        isError = false;
        message = null;

        try
        {
            var user = await UserManager.FindByEmailAsync(emailModel.Email);
            if (user != null)
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                message = $"Reset token: {token[..20]}... (In production, this would be emailed)";
                resetModel.Token = token;
                showTokenStep = true;
            }
            else
            {
                message = "If the email exists, a reset token has been generated.";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleResetPassword()
    {
        isLoading = true;
        isError = false;
        message = null;

        if (resetModel.NewPassword != resetModel.ConfirmPassword)
        {
            isError = true;
            message = "Passwords do not match.";
            isLoading = false;
            return;
        }

        try
        {
            var user = await UserManager.FindByEmailAsync(emailModel.Email);
            if (user != null)
            {
                var result = await UserManager.ResetPasswordAsync(user, resetModel.Token, resetModel.NewPassword);
                if (result.Succeeded)
                {
                    message = "Password reset successful! Redirecting...";
                    await Task.Delay(1500);
                    Navigation.NavigateTo("/login");
                }
                else
                {
                    isError = true;
                    message = string.Join(", ", result.Errors.Select(e => e.Description));
                }
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
