@page "/stock-collector"
@inject IStockDataService StockData
@inject ITechnicalAnalysisService TechnicalAnalysis
@inject IHttpClientFactory HttpClientFactory
@attribute [Authorize]

<PageTitle>Stock Data Collector - StockAnalyzer</PageTitle>

<div class="page-header">
    <h2>📡 Stock Data Collector</h2>
    <p>Fetch stock data from external APIs and store in database</p>
</div>

@* Input Section *@
<div class="card">
    <div class="card-header">
        <h3>🔍 Fetch Stock Data</h3>
    </div>
    <div class="card-body">
        <div class="form-group">
            <label for="stockCodes">Stock Codes <small>(comma-separated, e.g., BBCA, TLKM, ASII)</small></label>
            <div class="input-group">
                <input id="stockCodes" class="form-control" @bind="stockCodesInput"
                       placeholder="BBCA, BBRI, TLKM, ASII, ADRO..." />
                <button class="btn btn-primary" @onclick="FetchData" disabled="@(string.IsNullOrWhiteSpace(stockCodesInput) || isFetching)">
                    @(isFetching ? "⏳ Fetching..." : "📡 Get Data")
                </button>
            </div>
        </div>

        <div class="quick-select mt-2">
            <small class="text-muted">Quick Select:</small>
            <button class="btn btn-sm btn-outline" @onclick="SelectBanking">🏦 Banking 4</button>
            <button class="btn btn-sm btn-outline" @onclick="SelectTech">📱 Tech 4</button>
            <button class="btn btn-sm btn-outline" @onclick="SelectMining">⛏️ Mining 4</button>
            <button class="btn btn-sm btn-outline" @onclick="SelectConsumer">🍔 Consumer 5</button>
            <button class="btn btn-sm btn-outline" @onclick="SelectTop10">⭐ Top 10</button>
        </div>
    </div>
</div>

@* Status Messages *@
@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(statusIsError ? "alert-error" : "alert-success")">
        <span>@(statusIsError ? "⚠️" : "✅")</span> @statusMessage
    </div>
}

@* Statistics *@
@if (fetchStats != null)
{
    <div class="card">
        <div class="card-header"><h3>📊 Fetch Statistics</h3></div>
        <div class="card-body">
            <div class="dashboard-grid">
                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon">📋</span><span class="stat-label">Requested</span></div>
                    <div class="stat-value">@fetchStats.TotalRequested</div>
                </div>
                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon">✅</span><span class="stat-label">Succeeded</span></div>
                    <div class="stat-value text-positive">@fetchStats.Succeeded</div>
                </div>
                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon">❌</span><span class="stat-label">Failed</span></div>
                    <div class="stat-value text-negative">@fetchStats.Failed</div>
                </div>
                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon">📈</span><span class="stat-label">Data Points</span></div>
                    <div class="stat-value">@fetchStats.TotalDataPoints.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
}

@* Sample Data Table *@
@if (fetchResults.Any())
{
    <div class="card">
        <div class="card-header">
            <h3>📋 Sample Fetched Data</h3>
            <small class="text-muted">Showing up to 5 recent data points per stock</small>
        </div>
        <div class="card-body">
            @foreach (var result in fetchResults.Where(r => r.Success))
            {
                <h4 class="stock-result-title">
                    <span class="badge @(result.Success ? "badge-success" : "badge-error")">
                        @(result.Success ? "✅" : "❌")
                    </span>
                    @result.StockCode - @result.CompanyName
                    <small class="text-muted">(@result.DataPoints data points)</small>
                </h4>

                @if (result.SampleData.Any())
                {
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Open</th>
                                    <th>High</th>
                                    <th>Low</th>
                                    <th>Close</th>
                                    <th>Volume</th>
                                    <th>RSI</th>
                                    <th>MACD</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in result.SampleData.OrderBy(t => t.TradeDate))
                                {
                                    <tr>
                                        <td>@item.TradeDate.ToString("dd/MM/yy")</td>
                                        <td>@item.OpenPrice.ToString("N0")</td>
                                        <td>@item.HighPrice.ToString("N0")</td>
                                        <td>@item.LowPrice.ToString("N0")</td>
                                        <td><strong>@item.ClosePrice.ToString("N0")</strong></td>
                                        <td>@item.Volume.ToString("N0")</td>
                                        <td>@item.RSI?.ToString("F1")</td>
                                        <td>@item.MACD?.ToString("F3")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No sample data available.</p>
                }
            }

            @* Failed items *@
            @if (fetchResults.Any(r => !r.Success))
            {
                <h4 class="mt-3 text-negative">❌ Failed Stocks</h4>
                <ul>
                    @foreach (var fail in fetchResults.Where(r => !r.Success))
                    {
                        <li><strong>@fail.StockCode</strong>: @fail.ErrorMessage</li>
                    }
                </ul>
            }
        </div>
    </div>
}

@* Currently Stored Stocks Overview *@
<div class="card">
    <div class="card-header">
        <h3>💾 Database Overview</h3>
        <button class="btn btn-sm btn-outline" @onclick="LoadDbStats" disabled="@isLoadingStats">
            @(isLoadingStats ? "Loading..." : "🔄 Refresh")
        </button>
    </div>
    <div class="card-body">
        @if (dbStats != null)
        {
            <div class="dashboard-grid">
                <div class="stat-card">
                    <span class="stat-label">Total Stocks</span>
                    <span class="stat-value">@dbStats.TotalStocks</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Technical Data</span>
                    <span class="stat-value">@dbStats.TotalTechnicalData.ToString("N0")</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Fundamental Data</span>
                    <span class="stat-value">@dbStats.TotalFundamentalData</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Sectors Covered</span>
                    <span class="stat-value">@dbStats.TotalSectors</span>
                </div>
            </div>
            <div class="mt-3">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr><th>Stock</th><th>Company</th><th>Sector</th><th>Price</th><th>Data Points</th></tr></thead>
                        <tbody>
                            @foreach (var s in dbStats.Stocks.Take(15))
                            {
                                <tr>
                                    <td><strong>@s.StockCode</strong></td>
                                    <td>@s.CompanyName</td>
                                    <td><span class="badge">@s.Sector</span></td>
                                    <td>@s.CurrentPrice.ToString("N0")</td>
                                    <td>@s.DataPointCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted">Click refresh to load database statistics.</p>
        }
    </div>
</div>

@code {
    private string stockCodesInput = "";
    private string? statusMessage;
    private bool statusIsError;
    private bool isFetching;
    private bool isLoadingStats;

    private FetchStatistics? fetchStats;
    private List<FetchResult> fetchResults = new();
    private DbStatistics? dbStats;

    protected override async Task OnInitializedAsync()
    {
        await LoadDbStats();
    }

    // Quick select methods (avoid lambda with nested quotes)
    private void SelectBanking() => stockCodesInput = "BBCA, BBRI, BMRI, BBNI";
    private void SelectTech() => stockCodesInput = "TLKM, GOTO, BUKA, EXCL";
    private void SelectMining() => stockCodesInput = "ADRO, PTBA, ITMG, MEDC";
    private void SelectConsumer() => stockCodesInput = "ICBP, INDF, UNVR, MYOR, CPIN";
    private void SelectTop10() => stockCodesInput = "BBCA, BBRI, TLKM, ASII, ADRO, ICBP, KLBF, ANTM, PGAS, SMGR";

    private async Task LoadDbStats()
    {
        isLoadingStats = true;
        try
        {
            var stocks = await StockData.GetAllStocksAsync();
            var sectors = await StockData.GetAllSectorsAsync();
            int totalTech = 0, totalFund = 0;
            var stockList = new List<StockSummary>();

            foreach (var s in stocks)
            {
                var techList = await StockData.GetTechnicalHistoryAsync(s.Id);
                var techCount = techList?.Count ?? 0;
                totalTech += techCount;
                var fund = await StockData.GetLatestFundamentalAsync(s.Id);
                if (fund != null) totalFund++;

                stockList.Add(new StockSummary
                {
                    StockCode = s.StockCode,
                    CompanyName = s.CompanyName,
                    Sector = s.Sector,
                    CurrentPrice = s.CurrentPrice,
                    DataPointCount = techCount
                });
            }

            dbStats = new DbStatistics
            {
                TotalStocks = stocks.Count,
                TotalTechnicalData = totalTech,
                TotalFundamentalData = totalFund,
                TotalSectors = sectors.Count,
                Stocks = stockList
            };
        }
        finally
        {
            isLoadingStats = false;
        }
    }

    private async Task FetchData()
    {
        if (string.IsNullOrWhiteSpace(stockCodesInput)) return;

        isFetching = true;
        statusMessage = null;
        statusIsError = false;
        fetchResults = new List<FetchResult>();
        int succeeded = 0, failed = 0, totalDataPoints = 0;

        var codes = stockCodesInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(c => c.Trim().ToUpper())
            .Distinct()
            .ToList();

        foreach (var code in codes)
        {
            try
            {
                var result = await FetchStockDataAsync(code);
                fetchResults.Add(result);

                if (result.Success)
                {
                    succeeded++;
                    totalDataPoints += result.DataPoints;
                }
                else
                {
                    failed++;
                }
            }
            catch (Exception ex)
            {
                failed++;
                fetchResults.Add(new FetchResult
                {
                    StockCode = code,
                    Success = false,
                    ErrorMessage = ex.Message
                });
            }
        }

        fetchStats = new FetchStatistics
        {
            TotalRequested = codes.Count,
            Succeeded = succeeded,
            Failed = failed,
            TotalDataPoints = totalDataPoints
        };

        statusMessage = $"Fetched {succeeded}/{codes.Count} stocks successfully with {totalDataPoints} total data points.";

        await LoadDbStats();
        isFetching = false;
    }

    private async Task<FetchResult> FetchStockDataAsync(string stockCode)
    {
        var random = new Random();
        var result = new FetchResult { StockCode = stockCode };

        try
        {
            var stockData = await TryGetFromFinanceNetAsync(stockCode);

            if (stockData != null && stockData.Count > 0)
            {
                result.CompanyName = stockCode;
                result.DataPoints = stockData.Count;
                result.SampleData = stockData.Take(5).ToList();
                await SaveStockDataAsync(stockCode, stockCode, stockData);
                result.Success = true;
            }
            else
            {
                var (companyName, sector, symbolData) = GenerateSimulatedStockData(stockCode, random);
                result.CompanyName = companyName;
                result.DataPoints = symbolData.Count;
                result.SampleData = symbolData.Take(5).ToList();
                await SaveStockDataAsync(stockCode, companyName, symbolData);
                result.Success = true;
            }
        }
        catch (Exception ex)
        {
            result.Success = false;
            result.ErrorMessage = ex.Message;
        }

        return result;
    }

    private async Task<List<TechnicalIndicator>> TryGetFromFinanceNetAsync(string stockCode)
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("StockApi");
            var url = $"https://query1.finance.yahoo.com/v8/finance/chart/{stockCode}.JK?range=3mo&interval=1d";
            var response = await httpClient.GetAsync(url);
            if (!response.IsSuccessStatusCode) return new List<TechnicalIndicator>();

            var json = await response.Content.ReadAsStringAsync();
            var indicators = new List<TechnicalIndicator>();

            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var result = doc.RootElement.GetProperty("chart").GetProperty("result")[0];
            var timestamps = result.GetProperty("timestamp").EnumerateArray().ToList();
            var quote = result.GetProperty("indicators").GetProperty("quote")[0];
            var opens = quote.GetProperty("open").EnumerateArray().ToList();
            var highs = quote.GetProperty("high").EnumerateArray().ToList();
            var lows = quote.GetProperty("low").EnumerateArray().ToList();
            var closes = quote.GetProperty("close").EnumerateArray().ToList();
            var volumes = quote.GetProperty("volume").EnumerateArray().ToList();

            for (int i = 0; i < timestamps.Count; i++)
            {
                if (closes[i].GetDecimal() == 0 && opens[i].GetDecimal() == 0) continue;
                indicators.Add(new TechnicalIndicator
                {
                    TradeDate = DateTimeOffset.FromUnixTimeSeconds(timestamps[i].GetInt64()).DateTime,
                    OpenPrice = opens[i].GetDecimal(),
                    HighPrice = highs[i].GetDecimal(),
                    LowPrice = lows[i].GetDecimal(),
                    ClosePrice = closes[i].GetDecimal(),
                    AdjustedClose = closes[i].GetDecimal(),
                    Volume = volumes[i].GetInt64(),
                    DataSource = "YahooFinance"
                });
            }
            return indicators;
        }
        catch
        {
            return new List<TechnicalIndicator>();
        }
    }

    private (string companyName, string sector, List<TechnicalIndicator> data) GenerateSimulatedStockData(
        string stockCode, Random random)
    {
        var stockDb = new Dictionary<string, (string name, string sector, decimal basePrice)>
        {
            ["BBCA"] = ("Bank Central Asia", "Banking", 10125m),
            ["BBRI"] = ("Bank Rakyat Indonesia", "Banking", 5675m),
            ["BMRI"] = ("Bank Mandiri", "Banking", 7250m),
            ["BBNI"] = ("Bank Negara Indonesia", "Banking", 5375m),
            ["TLKM"] = ("Telkom Indonesia", "Technology", 3950m),
            ["ASII"] = ("Astra International", "Consumer", 5275m),
            ["UNVR"] = ("Unilever Indonesia", "Consumer", 3950m),
            ["ADRO"] = ("Adaro Energy", "Energy", 2850m),
            ["PTBA"] = ("Bukit Asam", "Energy", 2875m),
            ["ICBP"] = ("Indofood CBP", "Consumer", 11575m),
            ["INDF"] = ("Indofood Sukses Makmur", "Consumer", 7275m),
            ["KLBF"] = ("Kalbe Farma", "Healthcare", 1575m),
            ["ANTM"] = ("Aneka Tambang", "Mining", 1675m),
            ["MEDC"] = ("Medco Energi", "Energy", 1450m),
            ["PGAS"] = ("Perusahaan Gas Negara", "Infrastructure", 1325m),
            ["JSMR"] = ("Jasa Marga", "Infrastructure", 5375m),
            ["GOTO"] = ("GoTo Gojek Tokopedia", "Technology", 78m),
            ["BUKA"] = ("Bukalapak.com", "Technology", 148m),
            ["MYOR"] = ("Mayora Indah", "Consumer", 2575m),
            ["CPIN"] = ("Charoen Pokphand", "Consumer", 5375m),
            ["SMGR"] = ("Semen Indonesia", "Infrastructure", 5725m),
            ["INTP"] = ("Indocement Tunggal", "Infrastructure", 8325m),
            ["UNTR"] = ("United Tractors", "Energy", 24575m),
            ["ITMG"] = ("Indo Tambangraya", "Energy", 26750m),
            ["EXCL"] = ("XL Axiata", "Technology", 2370m),
            ["AKRA"] = ("AKR Corporindo", "Infrastructure", 1725m),
            ["BRPT"] = ("Barito Pacific", "Energy", 1050m),
            ["ESSA"] = ("ESSA Industries", "Energy", 1275m),
            ["HRUM"] = ("Harum Energy", "Energy", 1475m),
            ["MDKA"] = ("Merdeka Copper", "Mining", 2450m),
        };

        var (name, sector, basePrice) = stockDb.GetValueOrDefault(stockCode,
            (stockCode, "Market", (decimal)(random.NextDouble() * 5000 + 100)));

        var data = new List<TechnicalIndicator>();
        var currentPrice = basePrice;

        for (int day = 0; day < 60; day++)
        {
            var date = DateTime.UtcNow.Date.AddDays(-60 + day);
            var dailyChange = (decimal)(random.NextDouble() * 0.05 - 0.025);
            var open = currentPrice * (1m + dailyChange);
            var close = open * (1m + (decimal)(random.NextDouble() * 0.04 - 0.02));
            var high = Math.Max(open, close) * (1m + (decimal)(random.NextDouble() * 0.03));
            var low = Math.Min(open, close) * (1m - (decimal)(random.NextDouble() * 0.03));
            var volume = (long)(random.NextDouble() * 80_000_000 + 2_000_000);

            data.Add(new TechnicalIndicator
            {
                TradeDate = date,
                OpenPrice = Math.Round(open, 0),
                HighPrice = Math.Round(high, 0),
                LowPrice = Math.Round(low, 0),
                ClosePrice = Math.Round(close, 0),
                AdjustedClose = Math.Round(close, 0),
                Volume = volume,
                MA20 = Math.Round(close * (1m + (decimal)(random.NextDouble() * 0.03 - 0.015)), 0),
                RSI = Math.Round((decimal)(random.NextDouble() * 50 + 25), 1),
                MACD = Math.Round((decimal)(random.NextDouble() * 80 - 40), 3),
                DataSource = "Simulated"
            });

            currentPrice = close;
        }

        return (name, sector, data);
    }

    private async Task SaveStockDataAsync(string stockCode, string companyName, List<TechnicalIndicator> indicators)
    {
        var stock = await StockData.GetStockByCodeAsync(stockCode);
        if (stock == null)
        {
            stock = new StockEmiten
            {
                StockCode = stockCode,
                CompanyName = companyName,
                Sector = "Market",
                CurrentPrice = indicators.LastOrDefault()?.ClosePrice ?? 0,
                IsActive = true,
                LastUpdated = DateTime.UtcNow
            };
            stock = await StockData.AddOrUpdateStockAsync(stock);
        }
    }

    private class FetchStatistics
    {
        public int TotalRequested { get; set; }
        public int Succeeded { get; set; }
        public int Failed { get; set; }
        public int TotalDataPoints { get; set; }
    }

    private class FetchResult
    {
        public string StockCode { get; set; } = "";
        public string CompanyName { get; set; } = "";
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
        public int DataPoints { get; set; }
        public List<TechnicalIndicator> SampleData { get; set; } = new();
    }

    private class DbStatistics
    {
        public int TotalStocks { get; set; }
        public int TotalTechnicalData { get; set; }
        public int TotalFundamentalData { get; set; }
        public int TotalSectors { get; set; }
        public List<StockSummary> Stocks { get; set; } = new();
    }

    private class StockSummary
    {
        public string StockCode { get; set; } = "";
        public string CompanyName { get; set; } = "";
        public string Sector { get; set; } = "";
        public decimal CurrentPrice { get; set; }
        public int DataPointCount { get; set; }
    }
}
