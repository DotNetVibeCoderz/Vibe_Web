@page "/not-found"
@inject NavigationManager Nav

<PageTitle>404 - StockAnalyzer</PageTitle>

<div class="error-box" style="text-align: center; padding: 60px 20px; max-width: 500px; margin: 60px auto;">
    <div style="font-size: 64px; margin-bottom: 16px;">📈</div>
    <h2 style="font-size: 28px; margin-bottom: 8px;">404 - Page Not Found</h2>
    <p class="text-muted" style="margin-bottom: 24px;">
        Halaman yang Anda cari tidak ditemukan. Mungkin sudah dipindahkan atau dihapus.
    </p>
    <button class="btn btn-primary" @onclick="GoHome">
        🏠 Back to Dashboard
    </button>
</div>

@code {
    private void GoHome()
    {
        Nav.NavigateTo("/");
    }
}
