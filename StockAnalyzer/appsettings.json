{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ============================================
  // DATABASE CONFIGURATION
  // Supported providers: SQLite, SqlServer, MySQL
  // ============================================
  "Database": {
    "Provider": "SQLite",
    "ConnectionString": "Data Source=Data/stockanalyzer.db"
  },

  // ============================================
  // STORAGE CONFIGURATION
  // Supported providers: FileSystem, MinIO, S3, AzureBlob
  // ============================================
  "Storage": {
    "Provider": "FileSystem",
    "BasePath": "Data/Storage",
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "stockanalyzer"
  },

  // ============================================
  // LLM PROVIDER CONFIGURATION
  // Supported: OpenAI, Gemini, Anthropic, Ollama, OpenAICompatible
  // ============================================
  "LLM": {
    "DefaultProvider": "OpenAI",
    "EnableLLMAnalysis": true,
    "TechnicalWeight": 0.35,
    "FundamentalWeight": 0.35,
    "SentimentWeight": 0.30,

    "Providers": {
      "OpenAI": {
        "ApiKey": "sk-proj-your-openai-key",
        "ApiBaseUrl": "https://api.openai.com/v1",
        "ModelName": "gpt-4o-mini",
        "FallbackModelName": "gpt-3.5-turbo",
        "MaxTokens": 4096,
        "Temperature": 0.7,
        "TimeoutSeconds": 60,
        "IsEnabled": true
      },
      "Gemini": {
        "ApiKey": "your-gemini-api-key",
        "ApiBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "ModelName": "gemini-2.0-flash",
        "FallbackModelName": "gemini-1.5-flash",
        "MaxTokens": 4096,
        "Temperature": 0.7,
        "TimeoutSeconds": 60,
        "IsEnabled": false
      },
      "Anthropic": {
        "ApiKey": "your-anthropic-api-key",
        "ApiBaseUrl": "https://api.anthropic.com/v1",
        "ModelName": "claude-3-sonnet-20240229",
        "FallbackModelName": "claude-3-haiku-20240307",
        "MaxTokens": 4096,
        "Temperature": 0.7,
        "TimeoutSeconds": 60,
        "IsEnabled": false
      },
      "Ollama": {
        "ApiKey": "",
        "ApiBaseUrl": "http://localhost:11434",
        "ModelName": "llama3.1",
        "FallbackModelName": "llama3",
        "MaxTokens": 4096,
        "Temperature": 0.7,
        "TimeoutSeconds": 120,
        "IsEnabled": false
      },
      "OpenAICompatible": {
        "ApiKey": "not-needed",
        "ApiBaseUrl": "http://localhost:1234/v1",
        "ModelName": "local-model",
        "FallbackModelName": "",
        "MaxTokens": 4096,
        "Temperature": 0.7,
        "TimeoutSeconds": 120,
        "IsEnabled": false
      }
    },

    // Analysis type to provider mapping
    "AnalysisMappings": {
      "TechnicalReview": "OpenAI",
      "FundamentalReview": "OpenAI",
      "SentimentAnalysis": "OpenAI",
      "StockRecommendation": "OpenAI"
    }
  },

  // ============================================
  // STOCK DATA API CONFIGURATION
  // ============================================
  "StockApi": {
    "Provider": "YahooFinance",
    "ApiKey": "",
    "BaseUrl": "",
    "RefreshIntervalMinutes": 15,
    "AutoRefresh": false
  },

  // ============================================
  // NEWS SCRAPING CONFIGURATION
  // ============================================
  "NewsScraping": {
    "Enabled": true,
    "Sources": [
      "https://www.cnbcindonesia.com/market",
      "https://market.bisnis.com/",
      "https://investasi.kontan.co.id/"
    ],
    "MaxArticlesPerSource": 10,
    "ScrapingIntervalHours": 1
  }
}
