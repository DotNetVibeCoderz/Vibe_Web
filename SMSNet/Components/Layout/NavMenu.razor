@using SMSNet.Services
@using System.Security.Claims

@* Renders only what the signed-in user's roles can actually open, straight from
   NavigationRegistry — so the menu and the [Authorize] attributes agree. *@

<nav class="sms-sidebar__nav" aria-label="Navigasi utama">
    @foreach (var group in _groups)
    {
        <div class="sms-nav-group">
            <span class="sms-nav-group__label">@group.Label</span>
            @foreach (var item in group.Items)
            {
                <NavLink class="sms-nav-link" href="@item.Href"
                         Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         @onclick="OnNavigate">
                    <Icon Name="@item.Icon" Class="sms-nav-link__icon" />
                    <span>@item.Label</span>
                </NavLink>
            }
        </div>
    }
</nav>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Lets the shell close the mobile drawer when a destination is chosen.</summary>
    [Parameter] public EventCallback OnNavigate { get; set; }

    private IReadOnlyList<NavigationRegistry.NavGroup> _groups = Array.Empty<NavigationRegistry.NavGroup>();

    protected override async Task OnParametersSetAsync()
    {
        var roles = await CurrentRolesAsync();
        _groups = NavigationRegistry.VisibleTo(roles).ToList();
    }

    private async Task<string[]> CurrentRolesAsync()
    {
        if (AuthState is null)
        {
            return Array.Empty<string>();
        }

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return Array.Empty<string>();
        }

        return user.FindAll(ClaimTypes.Role).Select(c => c.Value).ToArray();
    }
}
