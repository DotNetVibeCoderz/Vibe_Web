@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="sms-shell">

    @if (_drawerOpen)
    {
        <div class="sms-scrim lg:hidden" @onclick="CloseDrawer" aria-hidden="true"></div>
    }

    <aside class="sms-sidebar @(_drawerOpen ? "is-open" : "")">
        <div class="sms-sidebar__brand">
            <div class="sms-sidebar__mark" aria-hidden="true">SN</div>
            <div class="min-w-0">
                <p class="font-display font-bold text-[0.98rem] leading-tight" style="color: var(--fg-strong)">SMSNet</p>
                <p class="text-[0.7rem] truncate" style="color: var(--fg-faint)">Sistem Manajemen Sekolah</p>
            </div>
            <button type="button" class="sms-btn sms-btn--quiet ml-auto lg:hidden"
                    @onclick="CloseDrawer" aria-label="Tutup menu">
                <Icon Name="close" />
            </button>
        </div>

        <NavMenu OnNavigate="CloseDrawer" />

        <div class="px-4 py-3 border-t text-[0.7rem]" style="border-color: var(--rule); color: var(--fg-faint)">
            <p>SMSNet &middot; Gravicode Studios</p>
        </div>
    </aside>

    <div class="sms-main">
        <header class="sms-topbar">
            <div class="flex items-center gap-3 min-w-0">
                <button type="button" class="sms-btn sms-btn--ghost lg:hidden"
                        @onclick="OpenDrawer" aria-label="Buka menu navigasi">
                    <Icon Name="menu" />
                </button>

                <div class="min-w-0">
                    <AuthorizeView>
                        <Authorized>
                            <p class="text-[0.72rem]" style="color: var(--fg-faint)">@Greeting()</p>
                            <p class="font-display font-semibold text-[0.95rem] leading-tight truncate"
                               style="color: var(--fg-strong)">@DisplayName(context)</p>
                        </Authorized>
                        <NotAuthorized>
                            <p class="font-display font-semibold text-[0.95rem]" style="color: var(--fg-strong)">
                                Sistem Manajemen Sekolah
                            </p>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" class="sms-btn sms-btn--ghost sms-btn--sm"
                        @onclick="ToggleTheme"
                        title="@(_isDark ? "Beralih ke tema terang" : "Beralih ke tema gelap")"
                        aria-label="@(_isDark ? "Beralih ke tema terang" : "Beralih ke tema gelap")">
                    <Icon Name="@(_isDark ? "sun" : "moon")" />
                    <span class="hidden sm:inline">@(_isDark ? "Terang" : "Gelap")</span>
                </button>

                <AuthorizeView>
                    <Authorized>
                        <a href="/auth/profile" class="sms-avatar" title="@DisplayName(context)"
                           aria-label="Profil saya">@Initials(context)</a>

                        <form method="post" action="/account/logout" class="contents">
                            <AntiforgeryToken />
                            <button type="submit" class="sms-btn sms-btn--ghost sms-btn--sm" title="Keluar">
                                <Icon Name="logout" />
                                <span class="hidden sm:inline">Keluar</span>
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="sms-btn sms-btn--primary sms-btn--sm" href="/auth/login">
                            <Icon Name="login" />
                            <span>Masuk</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="sms-content" id="konten-utama">
            @Body
        </main>
    </div>

    <Toaster />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Terjadi kesalahan tak terduga.
    <a href="." class="reload">Muat ulang</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen;
    private bool _isDark;

    protected override void OnInitialized()
    {
        // Close the drawer on navigation so a deep link never lands behind a scrim.
        Nav.LocationChanged += (_, _) =>
        {
            if (_drawerOpen)
            {
                _drawerOpen = false;
                InvokeAsync(StateHasChanged);
            }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The theme itself is resolved pre-paint in App.razor; this only syncs the
        // toggle's label with whatever that decided.
        try
        {
            var theme = await JS.InvokeAsync<string>("smsnetTheme.current");
            _isDark = theme == "dark";
            StateHasChanged();
        }
        catch (JSException)
        {
            // Prerender or a torn-down circuit — the default label is fine.
        }
    }

    private async Task ToggleTheme()
    {
        var theme = await JS.InvokeAsync<string>("smsnetTheme.toggle");
        _isDark = theme == "dark";
    }

    private void OpenDrawer() => _drawerOpen = true;

    private void CloseDrawer() => _drawerOpen = false;

    private static string DisplayName(AuthenticationState state)
    {
        var user = state.User;
        var full = user.FindFirst("FullName")?.Value;
        return !string.IsNullOrWhiteSpace(full) ? full : user.Identity?.Name ?? "Pengguna";
    }

    private static string Initials(AuthenticationState state)
    {
        var name = DisplayName(state).Trim();
        if (name.Length == 0)
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string Greeting()
    {
        return SchoolClock.Now.Hour switch
        {
            >= 4 and < 11 => "Selamat pagi,",
            >= 11 and < 15 => "Selamat siang,",
            >= 15 and < 19 => "Selamat sore,",
            _ => "Selamat malam,"
        };
    }
}
