@page "/admin/inventory"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits CrudPageBase<InventoryItem>

<PageTitle>Inventory — SMSNet</PageTitle>

<PageHeader Eyebrow="Administrasi & Keuangan" Title="Inventory"
            Subtitle="Pengelolaan aset sekolah: buku, laboratorium, dan fasilitas.">
    <Actions>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Tambah Aset</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-4 mb-6">
    <StatTile Label="Jenis Aset" Value="@Items.Count.ToString()" Icon="box" Tone="brand" />
    <StatTile Label="Total Unit" Value="@Items.Sum(i => i.Quantity).ToString()" Icon="layers" />
    <StatTile Label="Kondisi Baik" Value="@Items.Count(i => i.Condition == "Good").ToString()" Icon="check" Tone="good" />
    <StatTile Label="Perlu Perhatian" Value="@Items.Count(i => i.Condition != "Good").ToString()" Icon="warning" Tone="warn" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Nama aset atau kategori…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-kategori">Kategori</label>
            <select id="f-kategori" class="sms-select" @bind="CategoryFilter" @bind:after="ResetPage">
                <option value="">Semua kategori</option>
                @foreach (var kategori in Items.Select(i => i.Category).Distinct().OrderBy(c => c))
                {
                    <option value="@kategori">@kategori</option>
                }
            </select>
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-kondisi">Kondisi</label>
            <select id="f-kondisi" class="sms-select" @bind="ConditionFilter" @bind:after="ResetPage">
                <option value="">Semua kondisi</option>
                <option value="Good">Baik</option>
                <option value="Fair">Cukup</option>
                <option value="Poor">Rusak</option>
            </select>
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">@for (var i = 0; i < 5; i++) { <div class="sms-skeleton h-10"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="box" Title="Tidak ada aset" Hint="Catat aset sekolah agar dapat dipantau kondisinya." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("nama")'>Aset <span class="sort-caret">@SortCaret("nama")</span></th>
                        <th class="is-sortable" @onclick='() => SortBy("kategori")'>Kategori <span class="sort-caret">@SortCaret("kategori")</span></th>
                        <th class="is-sortable sms-table__num" @onclick='() => SortBy("jumlah")'>Jumlah <span class="sort-caret">@SortCaret("jumlah")</span></th>
                        <th>Kondisi</th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aset in Paged)
                    {
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@aset.Name</td>
                            <td>@aset.Category</td>
                            <td class="sms-table__num">@aset.Quantity</td>
                            <td><span class="sms-badge @ConditionTone(aset.Condition)">@ConditionLabel(aset.Condition)</span></td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(aset)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)" @onclick="() => AskDelete(aset)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="aset" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Tambah Aset" : "Ubah Aset")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveAsync" id="form-aset">
            <DataAnnotationsValidator />
            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Nama aset</label>
                    <InputText class="sms-input" @bind-Value="Form.Name" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Kategori</label>
                    <InputText class="sms-input" @bind-Value="Form.Category" placeholder="contoh: Lab Komputer" />
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="sms-field">
                        <label class="sms-label">Jumlah</label>
                        <InputNumber class="sms-input" @bind-Value="Form.Quantity" />
                    </div>
                    <div class="sms-field">
                        <label class="sms-label">Kondisi</label>
                        <InputSelect class="sms-select" @bind-Value="Form.Condition">
                            <option value="Good">Baik</option>
                            <option value="Fair">Cukup</option>
                            <option value="Poor">Rusak</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="submit" form="form-aset" class="sms-btn sms-btn--primary">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen" Title="Hapus aset"
               Message="Data aset ini akan dihapus permanen dari inventaris."
               Detail="@PendingDeleteLabel" OnConfirm="ConfirmDeleteAsync" />

@code {
    private string CategoryFilter = string.Empty;
    private string ConditionFilter = string.Empty;

    protected override string EntityLabel => "aset";

    protected override DbSet<InventoryItem> Table(ApplicationDbContext db) => db.InventoryItems;

    protected override IEnumerable<string?> SearchableText(InventoryItem i) =>
        new[] { i.Name, i.Category, i.Condition };

    protected override string Describe(InventoryItem i) => i.Name;

    protected override int IdOf(InventoryItem i) => i.Id;

    protected override InventoryItem NewEntity() => new() { Condition = "Good", Quantity = 1 };

    protected override InventoryItem CloneForEdit(InventoryItem i) => new()
    {
        Id = i.Id, Name = i.Name, Category = i.Category, Quantity = i.Quantity, Condition = i.Condition
    };

    protected override IEnumerable<InventoryItem> ApplyFilters(IEnumerable<InventoryItem> items)
    {
        if (!string.IsNullOrWhiteSpace(CategoryFilter)) items = items.Where(i => i.Category == CategoryFilter);
        if (!string.IsNullOrWhiteSpace(ConditionFilter)) items = items.Where(i => i.Condition == ConditionFilter);
        return items;
    }

    protected override IEnumerable<InventoryItem> ApplySort(IEnumerable<InventoryItem> items) => SortColumn switch
    {
        "kategori" => SortAscending ? items.OrderBy(i => i.Category) : items.OrderByDescending(i => i.Category),
        "jumlah" => SortAscending ? items.OrderBy(i => i.Quantity) : items.OrderByDescending(i => i.Quantity),
        _ => SortAscending ? items.OrderBy(i => i.Name) : items.OrderByDescending(i => i.Name)
    };

    protected override string CsvHeader => "Id,Aset,Kategori,Jumlah,Kondisi";

    protected override string CsvRow(InventoryItem i) =>
        $"{i.Id},{Csv(i.Name)},{Csv(i.Category)},{i.Quantity},{Csv(i.Condition)}";

    private void ResetPage() => CurrentPage = 1;

    private static string ConditionLabel(string c) => c switch
    {
        "Good" => "Baik", "Fair" => "Cukup", "Poor" => "Rusak", _ => c
    };

    private static string ConditionTone(string c) => c switch
    {
        "Good" => "sms-badge--good", "Poor" => "sms-badge--bad", _ => "sms-badge--warn"
    };
}
