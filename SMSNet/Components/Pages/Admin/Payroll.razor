@page "/admin/payroll"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits CrudPageBase<PayrollRecord>

<PageTitle>Payroll — SMSNet</PageTitle>

<PageHeader Eyebrow="Administrasi & Keuangan" Title="Payroll"
            Subtitle="Penggajian guru dan staff beserta rekapitulasi per periode.">
    <Actions>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Tambah Gaji</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-4 mb-6">
    <StatTile Label="Total Pegawai" Value="@Items.Select(p => p.EmployeeName).Distinct().Count().ToString()" Icon="users" Tone="brand" />
    <StatTile Label="Total Gaji" Value="@Money(Items.Sum(p => p.Salary))" Icon="coins" />
    <StatTile Label="Rata-rata Gaji"
              Value="@(Items.Count == 0 ? "—" : Money(Items.Average(p => p.Salary)))" Icon="chart" />
    <StatTile Label="Periode Tercatat"
              Value="@Items.Select(p => p.Period.ToString("yyyy-MM")).Distinct().Count().ToString()" Icon="calendar" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Nama pegawai…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-peran">Peran</label>
            <select id="f-peran" class="sms-select" @bind="RoleFilter" @bind:after="ResetPage">
                <option value="">Semua</option>
                @foreach (var peran in Items.Select(p => p.Role).Distinct().OrderBy(r => r))
                {
                    <option value="@peran">@peran</option>
                }
            </select>
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">@for (var i = 0; i < 5; i++) { <div class="sms-skeleton h-10"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="receipt" Title="Belum ada data gaji" Hint="Tambahkan data penggajian per periode." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("nama")'>Pegawai <span class="sort-caret">@SortCaret("nama")</span></th>
                        <th>Peran</th>
                        <th class="is-sortable sms-table__num" @onclick='() => SortBy("gaji")'>Gaji <span class="sort-caret">@SortCaret("gaji")</span></th>
                        <th class="is-sortable" @onclick='() => SortBy("periode")'>Periode <span class="sort-caret">@SortCaret("periode")</span></th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var gaji in Paged)
                    {
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@gaji.EmployeeName</td>
                            <td><span class="sms-badge">@gaji.Role</span></td>
                            <td class="sms-table__num font-semibold">@Money(gaji.Salary)</td>
                            <td class="tabular">@gaji.Period.ToString("MMMM yyyy")</td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(gaji)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)" @onclick="() => AskDelete(gaji)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="data gaji" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Tambah Data Gaji" : "Ubah Data Gaji")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveAsync" id="form-gaji">
            <DataAnnotationsValidator />
            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Nama pegawai</label>
                    <InputText class="sms-input" @bind-Value="Form.EmployeeName" />
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="sms-field">
                        <label class="sms-label">Peran</label>
                        <InputSelect class="sms-select" @bind-Value="Form.Role">
                            <option value="Guru">Guru</option>
                            <option value="Staff">Staff</option>
                            <option value="Kepala Sekolah">Kepala Sekolah</option>
                        </InputSelect>
                    </div>
                    <div class="sms-field">
                        <label class="sms-label">Periode</label>
                        <InputDate class="sms-input" @bind-Value="Form.Period" />
                    </div>
                </div>
                <div class="sms-field">
                    <label class="sms-label">Gaji (IDR)</label>
                    <InputNumber class="sms-input" @bind-Value="Form.Salary" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="submit" form="form-gaji" class="sms-btn sms-btn--primary">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen" Title="Hapus data gaji"
               Message="Data penggajian ini akan dihapus permanen."
               Detail="@PendingDeleteLabel" OnConfirm="ConfirmDeleteAsync" />

@code {
    private string RoleFilter = string.Empty;

    protected override string EntityLabel => "data gaji";

    protected override DbSet<PayrollRecord> Table(ApplicationDbContext db) => db.PayrollRecords;

    protected override IEnumerable<string?> SearchableText(PayrollRecord p) => new[] { p.EmployeeName, p.Role };

    protected override string Describe(PayrollRecord p) => $"{p.EmployeeName} ({p.Period:MMMM yyyy})";

    protected override int IdOf(PayrollRecord p) => p.Id;

    protected override PayrollRecord NewEntity() => new()
    {
        Period = new DateTime(SchoolClock.Today.Year, SchoolClock.Today.Month, 1),
        Role = "Guru"
    };

    protected override PayrollRecord CloneForEdit(PayrollRecord p) => new()
    {
        Id = p.Id, EmployeeName = p.EmployeeName, Role = p.Role, Salary = p.Salary, Period = p.Period
    };

    protected override IEnumerable<PayrollRecord> ApplyFilters(IEnumerable<PayrollRecord> items) =>
        string.IsNullOrWhiteSpace(RoleFilter) ? items : items.Where(p => p.Role == RoleFilter);

    protected override IEnumerable<PayrollRecord> ApplySort(IEnumerable<PayrollRecord> items) => SortColumn switch
    {
        "gaji" => SortAscending ? items.OrderBy(p => p.Salary) : items.OrderByDescending(p => p.Salary),
        "nama" => SortAscending ? items.OrderBy(p => p.EmployeeName) : items.OrderByDescending(p => p.EmployeeName),
        _ => SortAscending ? items.OrderBy(p => p.Period) : items.OrderByDescending(p => p.Period)
    };

    protected override string CsvHeader => "Id,Pegawai,Peran,Gaji,Periode";

    protected override string CsvRow(PayrollRecord p) =>
        $"{p.Id},{Csv(p.EmployeeName)},{Csv(p.Role)},{p.Salary:0},{p.Period:yyyy-MM}";

    private void ResetPage() => CurrentPage = 1;

    private static string Money(decimal amount) => $"Rp{amount:N0}";
}
