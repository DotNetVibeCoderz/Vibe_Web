@page "/admin/financial-report"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits CrudPageBase<FinancialReport>

<PageTitle>Laporan Keuangan Periode — SMSNet</PageTitle>

<PageHeader Eyebrow="Administrasi & Keuangan" Title="Laporan Keuangan Periode"
            Subtitle="Rekapitulasi pendapatan dan pengeluaran sekolah per periode.">
    <Actions>
        <a href="/reports/finance" class="sms-btn sms-btn--ghost">
            <Icon Name="trend" /><span>Analisis Lengkap</span>
        </a>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Tambah Laporan</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-4 mb-6">
    <StatTile Label="Total Pendapatan" Value="@Money(Items.Sum(r => r.Income))" Icon="coins" Tone="good" />
    <StatTile Label="Total Pengeluaran" Value="@Money(Items.Sum(r => r.Expense))" Icon="receipt" Tone="warn" />
    <StatTile Label="Surplus" Value="@Money(Surplus)"
              Meta="pendapatan − pengeluaran" Icon="trend"
              Tone="@(Surplus >= 0 ? "good" : "warn")" />
    <StatTile Label="Periode Tercatat" Value="@Items.Count.ToString()" Icon="calendar" Tone="brand" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Judul laporan…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">@for (var i = 0; i < 4; i++) { <div class="sms-skeleton h-10"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="trend" Title="Belum ada laporan periode"
                    Hint="Tambahkan rekapitulasi bulanan atau triwulanan." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("judul")'>Laporan <span class="sort-caret">@SortCaret("judul")</span></th>
                        <th class="is-sortable" @onclick='() => SortBy("periode")'>Periode <span class="sort-caret">@SortCaret("periode")</span></th>
                        <th class="sms-table__num">Pendapatan</th>
                        <th class="sms-table__num">Pengeluaran</th>
                        <th class="sms-table__num">Surplus</th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Paged)
                    {
                        var surplus = report.Income - report.Expense;
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@report.Title</td>
                            <td class="tabular">@report.Period.ToString("MMMM yyyy")</td>
                            <td class="sms-table__num">@Money(report.Income)</td>
                            <td class="sms-table__num">@Money(report.Expense)</td>
                            <td class="sms-table__num font-semibold"
                                style="color: @(surplus >= 0 ? "var(--daun)" : "var(--bata)")">
                                @Money(surplus)
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(report)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)" @onclick="() => AskDelete(report)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="laporan" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Tambah Laporan" : "Ubah Laporan")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveAsync" id="form-laporan">
            <DataAnnotationsValidator />
            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Judul laporan</label>
                    <InputText class="sms-input" @bind-Value="Form.Title" placeholder="Laporan Bulanan" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Periode</label>
                    <InputDate class="sms-input" @bind-Value="Form.Period" />
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="sms-field">
                        <label class="sms-label">Pendapatan (IDR)</label>
                        <InputNumber class="sms-input" @bind-Value="Form.Income" />
                    </div>
                    <div class="sms-field">
                        <label class="sms-label">Pengeluaran (IDR)</label>
                        <InputNumber class="sms-input" @bind-Value="Form.Expense" />
                    </div>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="submit" form="form-laporan" class="sms-btn sms-btn--primary">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen" Title="Hapus laporan"
               Message="Laporan periode ini akan dihapus permanen."
               Detail="@PendingDeleteLabel" OnConfirm="ConfirmDeleteAsync" />

@code {
    private decimal Surplus => Items.Sum(r => r.Income) - Items.Sum(r => r.Expense);

    protected override string EntityLabel => "laporan keuangan";

    protected override DbSet<FinancialReport> Table(ApplicationDbContext db) => db.FinancialReports;

    protected override IEnumerable<string?> SearchableText(FinancialReport r) => new[] { r.Title };

    protected override string Describe(FinancialReport r) => $"{r.Title} ({r.Period:MMMM yyyy})";

    protected override int IdOf(FinancialReport r) => r.Id;

    protected override FinancialReport NewEntity() => new()
    {
        Period = new DateTime(SchoolClock.Today.Year, SchoolClock.Today.Month, 1)
    };

    protected override FinancialReport CloneForEdit(FinancialReport r) => new()
    {
        Id = r.Id, Title = r.Title, Income = r.Income, Expense = r.Expense, Period = r.Period
    };

    protected override IEnumerable<FinancialReport> ApplySort(IEnumerable<FinancialReport> items) => SortColumn switch
    {
        "judul" => SortAscending ? items.OrderBy(r => r.Title) : items.OrderByDescending(r => r.Title),
        _ => SortAscending ? items.OrderBy(r => r.Period) : items.OrderByDescending(r => r.Period)
    };

    protected override string CsvHeader => "Id,Laporan,Periode,Pendapatan,Pengeluaran,Surplus";

    protected override string CsvRow(FinancialReport r) =>
        $"{r.Id},{Csv(r.Title)},{r.Period:yyyy-MM},{r.Income:0},{r.Expense:0},{r.Income - r.Expense:0}";

    private static string Money(decimal amount) => $"Rp{amount:N0}";
}
