@page "/master/classes"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Guru)]
@inherits CrudPageBase<ClassRoom>

<PageTitle>Master Data Kelas — SMSNet</PageTitle>

<PageHeader Eyebrow="Master Data" Title="Kelas"
            Subtitle="Rombongan belajar, wali kelas, dan daya tampung ruang.">
    <Actions>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Tambah Kelas</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-3 mb-6">
    <StatTile Label="Jumlah Kelas" Value="@Items.Count.ToString()" Icon="grid" Tone="brand" />
    <StatTile Label="Total Daya Tampung" Value="@Items.Sum(c => c.Capacity).ToString()" Icon="users" />
    <StatTile Label="Terisi" Value="@($"{OccupiedCount} siswa")" Meta="@OccupancyLabel"
              Icon="check" Tone="@(OccupancyRate > 95 ? "warn" : "good")" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Nama kelas atau wali kelas…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">@for (var i = 0; i < 5; i++) { <div class="sms-skeleton h-10"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="grid" Title="Belum ada kelas"
                    Hint="Tambahkan rombongan belajar agar siswa dapat ditempatkan." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("nama")'>Kelas <span class="sort-caret">@SortCaret("nama")</span></th>
                        <th>Wali Kelas</th>
                        <th class="is-sortable sms-table__num" @onclick='() => SortBy("kapasitas")'>Kapasitas <span class="sort-caret">@SortCaret("kapasitas")</span></th>
                        <th class="sms-table__num">Terisi</th>
                        <th>Keterisian</th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kelas in Paged)
                    {
                        var terisi = OccupancyOf(kelas.Name);
                        var persen = kelas.Capacity == 0 ? 0 : Math.Min(100, terisi * 100.0 / kelas.Capacity);
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@kelas.Name</td>
                            <td>@(kelas.HomeroomTeacher ?? "—")</td>
                            <td class="sms-table__num">@kelas.Capacity</td>
                            <td class="sms-table__num">@terisi</td>
                            <td style="min-width: 9rem">
                                <div class="flex items-center gap-2">
                                    <div class="sms-meter flex-1">
                                        <div class="sms-meter__fill" style="width: @persen.ToString("0")%"></div>
                                    </div>
                                    <span class="tabular text-xs" style="color: var(--fg-muted)">@persen.ToString("0")%</span>
                                </div>
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(kelas)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)" @onclick="() => AskDelete(kelas)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="kelas" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Tambah Kelas" : "Ubah Kelas")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveAsync" id="form-kelas">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Nama kelas</label>
                    <InputText class="sms-input" @bind-Value="Form.Name" placeholder="contoh: 8A" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Wali kelas</label>
                    <InputText class="sms-input" @bind-Value="Form.HomeroomTeacher" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Daya tampung</label>
                    <InputNumber class="sms-input" @bind-Value="Form.Capacity" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="submit" form="form-kelas" class="sms-btn sms-btn--primary">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen"
               Title="Hapus kelas"
               Message="Kelas ini akan dihapus permanen. Siswa yang terdaftar di dalamnya tidak ikut terhapus."
               Detail="@PendingDeleteLabel"
               OnConfirm="ConfirmDeleteAsync" />

@code {
    // Occupancy is counted by matching the student's ClassName string — the schema
    // stores the relationship as a name rather than a foreign key.
    private Dictionary<string, int> _occupancy = new();

    private int OccupiedCount => _occupancy.Values.Sum();

    private double OccupancyRate
    {
        get
        {
            var capacity = Items.Sum(c => c.Capacity);
            return capacity == 0 ? 0 : OccupiedCount * 100.0 / capacity;
        }
    }

    private string OccupancyLabel => $"{OccupancyRate:0.#}% dari daya tampung";

    private int OccupancyOf(string className) =>
        _occupancy.TryGetValue(className, out var count) ? count : 0;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await using var db = await DbFactory.CreateDbContextAsync();
        _occupancy = await db.Students.AsNoTracking()
            .Where(s => s.ClassName != null && s.Status == "Active")
            .GroupBy(s => s.ClassName!)
            .Select(g => new { Kelas = g.Key, Jumlah = g.Count() })
            .ToDictionaryAsync(x => x.Kelas, x => x.Jumlah);
    }

    protected override string EntityLabel => "kelas";

    protected override DbSet<ClassRoom> Table(ApplicationDbContext db) => db.ClassRooms;

    protected override IEnumerable<string?> SearchableText(ClassRoom c) => new[] { c.Name, c.HomeroomTeacher };

    protected override string Describe(ClassRoom c) => $"Kelas {c.Name}";

    protected override int IdOf(ClassRoom c) => c.Id;

    protected override ClassRoom NewEntity() => new() { Capacity = 32 };

    protected override ClassRoom CloneForEdit(ClassRoom c) => new()
    {
        Id = c.Id,
        Name = c.Name,
        HomeroomTeacher = c.HomeroomTeacher,
        Capacity = c.Capacity
    };

    protected override IEnumerable<ClassRoom> ApplySort(IEnumerable<ClassRoom> items) => SortColumn switch
    {
        "kapasitas" => SortAscending ? items.OrderBy(c => c.Capacity) : items.OrderByDescending(c => c.Capacity),
        _ => SortAscending ? items.OrderBy(c => c.Name) : items.OrderByDescending(c => c.Name)
    };

    protected override string CsvHeader => "Id,Kelas,WaliKelas,Kapasitas,Terisi";

    protected override string CsvRow(ClassRoom c) =>
        $"{c.Id},{Csv(c.Name)},{Csv(c.HomeroomTeacher)},{c.Capacity},{OccupancyOf(c.Name)}";
}
