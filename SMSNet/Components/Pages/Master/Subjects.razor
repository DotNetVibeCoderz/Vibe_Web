@page "/master/subjects"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Guru)]
@inherits CrudPageBase<Subject>

<PageTitle>Master Data Mata Pelajaran — SMSNet</PageTitle>

<PageHeader Eyebrow="Master Data" Title="Mata Pelajaran"
            Subtitle="Daftar mata pelajaran beserta bobot jam dan keterangannya.">
    <Actions>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Tambah Mata Pelajaran</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-3 mb-6">
    <StatTile Label="Mata Pelajaran" Value="@Items.Count.ToString()" Icon="book" Tone="brand" />
    <StatTile Label="Total Kredit" Value="@Items.Sum(s => s.Credits).ToString()" Icon="layers" />
    <StatTile Label="Rata-rata Kredit"
              Value="@(Items.Count == 0 ? "0" : Items.Average(s => s.Credits).ToString("0.#"))" Icon="chart" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Nama mata pelajaran…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">@for (var i = 0; i < 5; i++) { <div class="sms-skeleton h-10"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="book" Title="Belum ada mata pelajaran"
                    Hint="Tambahkan mata pelajaran agar dapat dipakai pada jadwal dan penilaian." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("nama")'>Mata Pelajaran <span class="sort-caret">@SortCaret("nama")</span></th>
                        <th class="is-sortable sms-table__num" @onclick='() => SortBy("kredit")'>Kredit <span class="sort-caret">@SortCaret("kredit")</span></th>
                        <th>Keterangan</th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mapel in Paged)
                    {
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@mapel.Name</td>
                            <td class="sms-table__num">@mapel.Credits</td>
                            <td style="color: var(--fg-muted)">@(mapel.Description ?? "—")</td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(mapel)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)" @onclick="() => AskDelete(mapel)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="mata pelajaran" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Tambah Mata Pelajaran" : "Ubah Mata Pelajaran")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveAsync" id="form-mapel">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Nama mata pelajaran</label>
                    <InputText class="sms-input" @bind-Value="Form.Name" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Kredit / jam pelajaran</label>
                    <InputNumber class="sms-input" @bind-Value="Form.Credits" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Keterangan</label>
                    <InputTextArea class="sms-textarea" @bind-Value="Form.Description" rows="3" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="submit" form="form-mapel" class="sms-btn sms-btn--primary">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen"
               Title="Hapus mata pelajaran"
               Message="Mata pelajaran ini akan dihapus permanen. Jadwal dan nilai yang memakai namanya tidak ikut terhapus."
               Detail="@PendingDeleteLabel"
               OnConfirm="ConfirmDeleteAsync" />

@code {
    protected override string EntityLabel => "mata pelajaran";

    protected override DbSet<Subject> Table(ApplicationDbContext db) => db.Subjects;

    protected override IEnumerable<string?> SearchableText(Subject s) => new[] { s.Name, s.Description };

    protected override string Describe(Subject s) => s.Name;

    protected override int IdOf(Subject s) => s.Id;

    protected override Subject NewEntity() => new() { Credits = 2 };

    protected override Subject CloneForEdit(Subject s) => new()
    {
        Id = s.Id,
        Name = s.Name,
        Credits = s.Credits,
        Description = s.Description
    };

    protected override IEnumerable<Subject> ApplySort(IEnumerable<Subject> items) => SortColumn switch
    {
        "kredit" => SortAscending ? items.OrderBy(s => s.Credits) : items.OrderByDescending(s => s.Credits),
        _ => SortAscending ? items.OrderBy(s => s.Name) : items.OrderByDescending(s => s.Name)
    };

    protected override string CsvHeader => "Id,MataPelajaran,Kredit,Keterangan";

    protected override string CsvRow(Subject s) =>
        $"{s.Id},{Csv(s.Name)},{s.Credits},{Csv(s.Description)}";
}
