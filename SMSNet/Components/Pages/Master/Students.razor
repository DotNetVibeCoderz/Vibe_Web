@page "/master/students"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Guru)]
@inherits CrudPageBase<Student>

<PageTitle>Master Data Siswa — SMSNet</PageTitle>

<PageHeader Eyebrow="Master Data" Title="Siswa"
            Subtitle="Data induk peserta didik: identitas, kelas, wali, dan status keaktifan.">
    <Actions>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Tambah Siswa</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-4 mb-6">
    <StatTile Label="Total Siswa" Value="@Items.Count.ToString()" Icon="users" Tone="brand" />
    <StatTile Label="Aktif" Value="@Items.Count(s => s.Status == "Active").ToString()" Icon="check" Tone="good" />
    <StatTile Label="Tidak Aktif" Value="@Items.Count(s => s.Status != "Active").ToString()" Icon="warning" Tone="warn" />
    <StatTile Label="Jumlah Kelas" Value="@Items.Select(s => s.ClassName).Distinct().Count(c => !string.IsNullOrWhiteSpace(c)).ToString()" Icon="grid" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Nama atau kelas…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="sms-field">
            <label class="sms-label" for="filter-kelas">Kelas</label>
            <select id="filter-kelas" class="sms-select" @bind="ClassFilter" @bind:after="ResetPage">
                <option value="">Semua kelas</option>
                @foreach (var kelas in Items.Select(s => s.ClassName).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c))
                {
                    <option value="@kelas">@kelas</option>
                }
            </select>
        </div>
        <div class="sms-field">
            <label class="sms-label" for="filter-status">Status</label>
            <select id="filter-status" class="sms-select" @bind="StatusFilter" @bind:after="ResetPage">
                <option value="">Semua status</option>
                <option value="Active">Aktif</option>
                <option value="Inactive">Tidak aktif</option>
            </select>
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">
            @for (var i = 0; i < 6; i++)
            {
                <div class="sms-skeleton h-10"></div>
            }
        </div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="users"
                    Title="Tidak ada siswa yang cocok"
                    Hint="Ubah kata kunci atau filter, atau tambahkan siswa baru.">
            <Action>
                <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
                    <Icon Name="plus" /><span>Tambah Siswa</span>
                </button>
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("nama")'>Nama <span class="sort-caret">@SortCaret("nama")</span></th>
                        <th class="is-sortable" @onclick='() => SortBy("kelas")'>Kelas <span class="sort-caret">@SortCaret("kelas")</span></th>
                        <th>Tanggal Lahir</th>
                        <th>Gender</th>
                        <th>Orang Tua</th>
                        <th class="is-sortable" @onclick='() => SortBy("status")'>Status <span class="sort-caret">@SortCaret("status")</span></th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var siswa in Paged)
                    {
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@siswa.FullName</td>
                            <td>@(siswa.ClassName ?? "—")</td>
                            <td class="tabular">@siswa.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td>@(siswa.Gender ?? "—")</td>
                            <td>@(siswa.ParentName ?? "—")</td>
                            <td>
                                <span class="sms-badge @(siswa.Status == "Active" ? "sms-badge--good" : "")">
                                    @(siswa.Status == "Active" ? "Aktif" : "Tidak aktif")
                                </span>
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(siswa)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)"
                                            @onclick="() => AskDelete(siswa)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="siswa" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()" Wide="true"
       Title="@(IdOf(Form) == 0 ? "Tambah Siswa" : "Ubah Data Siswa")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveAsync" id="form-siswa">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="grid gap-4 md:grid-cols-2">
                <div class="sms-field">
                    <label class="sms-label">Nama lengkap</label>
                    <InputText class="sms-input" @bind-Value="Form.FullName" />
                    <ValidationMessage For="() => Form.FullName" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Kelas</label>
                    <InputText class="sms-input" @bind-Value="Form.ClassName" placeholder="contoh: 8A" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Tanggal lahir</label>
                    <InputDate class="sms-input" @bind-Value="Form.DateOfBirth" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Gender</label>
                    <InputSelect class="sms-select" @bind-Value="Form.Gender">
                        <option value="Laki-laki">Laki-laki</option>
                        <option value="Perempuan">Perempuan</option>
                    </InputSelect>
                </div>
                <div class="sms-field">
                    <label class="sms-label">Nama orang tua</label>
                    <InputText class="sms-input" @bind-Value="Form.ParentName" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Telepon</label>
                    <InputText class="sms-input" @bind-Value="Form.Phone" placeholder="0812-…" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Status</label>
                    <InputSelect class="sms-select" @bind-Value="Form.Status">
                        <option value="Active">Aktif</option>
                        <option value="Inactive">Tidak aktif</option>
                    </InputSelect>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="submit" form="form-siswa" class="sms-btn sms-btn--primary">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen"
               Title="Hapus data siswa"
               Message="Data siswa ini akan dihapus permanen dari basis data."
               Detail="@PendingDeleteLabel"
               OnConfirm="ConfirmDeleteAsync" />

@code {
    private string ClassFilter = string.Empty;
    private string StatusFilter = string.Empty;

    protected override string EntityLabel => "siswa";

    protected override DbSet<Student> Table(ApplicationDbContext db) => db.Students;

    protected override IEnumerable<string?> SearchableText(Student s) =>
        new[] { s.FullName, s.ClassName, s.ParentName, s.Phone };

    protected override string Describe(Student s) => s.FullName;

    protected override int IdOf(Student s) => s.Id;

    protected override Student NewEntity() => new()
    {
        DateOfBirth = SchoolClock.Today.AddYears(-13),
        Gender = "Laki-laki",
        Status = "Active"
    };

    protected override Student CloneForEdit(Student s) => new()
    {
        Id = s.Id,
        FullName = s.FullName,
        ClassName = s.ClassName,
        DateOfBirth = s.DateOfBirth,
        Gender = s.Gender,
        ParentName = s.ParentName,
        Phone = s.Phone,
        Status = s.Status
    };

    protected override IEnumerable<Student> ApplyFilters(IEnumerable<Student> items)
    {
        if (!string.IsNullOrWhiteSpace(ClassFilter))
        {
            items = items.Where(s => s.ClassName == ClassFilter);
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            items = items.Where(s => s.Status == StatusFilter);
        }

        return items;
    }

    protected override IEnumerable<Student> ApplySort(IEnumerable<Student> items) => SortColumn switch
    {
        "kelas" => SortAscending ? items.OrderBy(s => s.ClassName) : items.OrderByDescending(s => s.ClassName),
        "status" => SortAscending ? items.OrderBy(s => s.Status) : items.OrderByDescending(s => s.Status),
        _ => SortAscending ? items.OrderBy(s => s.FullName) : items.OrderByDescending(s => s.FullName)
    };

    protected override string CsvHeader => "Id,Nama,Kelas,TanggalLahir,Gender,OrangTua,Telepon,Status";

    protected override string CsvRow(Student s) =>
        $"{s.Id},{Csv(s.FullName)},{Csv(s.ClassName)},{s.DateOfBirth:yyyy-MM-dd},{Csv(s.Gender)},{Csv(s.ParentName)},{Csv(s.Phone)},{Csv(s.Status)}";

    private void ResetPage() => CurrentPage = 1;
}
