@page "/academic/attendance"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Guru)]
@inherits CrudPageBase<AttendanceRecord>

<PageTitle>Absensi — SMSNet</PageTitle>

<PageHeader Eyebrow="Akademik" Title="Absensi"
            Subtitle="Pencatatan kehadiran siswa dan guru — barcode, RFID, biometrik, atau manual.">
    <Actions>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Catat Kehadiran</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-4 mb-6">
    <StatTile Label="Total Catatan" Value="@Items.Count.ToString()" Icon="check" Tone="brand" />
    <StatTile Label="Hadir" Value="@Items.Count(a => a.Status == "Present").ToString()"
              Meta="@RateLabel" Icon="check" Tone="good" />
    <StatTile Label="Tidak Hadir" Value="@Items.Count(a => a.Status != "Present").ToString()"
              Icon="warning" Tone="warn" />
    <StatTile Label="Hari Ini" Value="@Items.Count(a => a.Date.Date == SchoolClock.Today).ToString()" Icon="calendar" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Nama…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-peran">Peran</label>
            <select id="f-peran" class="sms-select" @bind="RoleFilter" @bind:after="ResetPage">
                <option value="">Semua</option>
                <option value="Siswa">Siswa</option>
                <option value="Guru">Guru</option>
            </select>
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-status">Status</label>
            <select id="f-status" class="sms-select" @bind="StatusFilter" @bind:after="ResetPage">
                <option value="">Semua</option>
                <option value="Present">Hadir</option>
                <option value="Absent">Tidak hadir</option>
                <option value="Sick">Sakit</option>
                <option value="Permit">Izin</option>
            </select>
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-metode">Metode</label>
            <select id="f-metode" class="sms-select" @bind="MethodFilter" @bind:after="ResetPage">
                <option value="">Semua</option>
                <option value="Barcode">Barcode</option>
                <option value="RFID">RFID</option>
                <option value="Biometrik">Biometrik</option>
                <option value="Manual">Manual</option>
            </select>
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">@for (var i = 0; i < 6; i++) { <div class="sms-skeleton h-10"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="check" Title="Tidak ada catatan kehadiran"
                    Hint="Catat kehadiran atau ubah filter pencarian." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("nama")'>Nama <span class="sort-caret">@SortCaret("nama")</span></th>
                        <th>Peran</th>
                        <th class="is-sortable" @onclick='() => SortBy("tanggal")'>Tanggal <span class="sort-caret">@SortCaret("tanggal")</span></th>
                        <th>Status</th>
                        <th>Metode</th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Paged)
                    {
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@record.PersonName</td>
                            <td>@record.Role</td>
                            <td class="tabular">@record.Date.ToString("dd MMM yyyy")</td>
                            <td><span class="sms-badge @StatusTone(record.Status)">@StatusLabel(record.Status)</span></td>
                            <td><span class="sms-badge">@record.Method</span></td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(record)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)" @onclick="() => AskDelete(record)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="catatan" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Catat Kehadiran" : "Ubah Catatan Kehadiran")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveAsync" id="form-absensi">
            <DataAnnotationsValidator />
            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Nama</label>
                    <InputText class="sms-input" @bind-Value="Form.PersonName" />
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="sms-field">
                        <label class="sms-label">Peran</label>
                        <InputSelect class="sms-select" @bind-Value="Form.Role">
                            <option value="Siswa">Siswa</option>
                            <option value="Guru">Guru</option>
                        </InputSelect>
                    </div>
                    <div class="sms-field">
                        <label class="sms-label">Tanggal</label>
                        <InputDate class="sms-input" @bind-Value="Form.Date" />
                    </div>
                    <div class="sms-field">
                        <label class="sms-label">Status</label>
                        <InputSelect class="sms-select" @bind-Value="Form.Status">
                            <option value="Present">Hadir</option>
                            <option value="Absent">Tidak hadir</option>
                            <option value="Sick">Sakit</option>
                            <option value="Permit">Izin</option>
                        </InputSelect>
                    </div>
                    <div class="sms-field">
                        <label class="sms-label">Metode</label>
                        <InputSelect class="sms-select" @bind-Value="Form.Method">
                            <option value="Barcode">Barcode</option>
                            <option value="RFID">RFID</option>
                            <option value="Biometrik">Biometrik</option>
                            <option value="Manual">Manual</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="submit" form="form-absensi" class="sms-btn sms-btn--primary">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen" Title="Hapus catatan kehadiran"
               Message="Catatan kehadiran ini akan dihapus permanen."
               Detail="@PendingDeleteLabel" OnConfirm="ConfirmDeleteAsync" />

@code {
    private string RoleFilter = string.Empty;
    private string StatusFilter = string.Empty;
    private string MethodFilter = string.Empty;

    private string RateLabel => Items.Count == 0
        ? "belum ada data"
        : $"{Items.Count(a => a.Status == "Present") * 100.0 / Items.Count:0.#}% kehadiran";

    protected override string EntityLabel => "kehadiran";

    protected override DbSet<AttendanceRecord> Table(ApplicationDbContext db) => db.AttendanceRecords;

    protected override IEnumerable<string?> SearchableText(AttendanceRecord a) =>
        new[] { a.PersonName, a.Role, a.Status, a.Method };

    protected override string Describe(AttendanceRecord a) => $"{a.PersonName} ({a.Date:dd MMM yyyy})";

    protected override int IdOf(AttendanceRecord a) => a.Id;

    protected override AttendanceRecord NewEntity() => new()
    {
        Date = SchoolClock.Today,
        Role = "Siswa",
        Status = "Present",
        Method = "Barcode"
    };

    protected override AttendanceRecord CloneForEdit(AttendanceRecord a) => new()
    {
        Id = a.Id, PersonName = a.PersonName, Role = a.Role,
        Date = a.Date, Status = a.Status, Method = a.Method
    };

    protected override IEnumerable<AttendanceRecord> ApplyFilters(IEnumerable<AttendanceRecord> items)
    {
        if (!string.IsNullOrWhiteSpace(RoleFilter)) items = items.Where(a => a.Role == RoleFilter);
        if (!string.IsNullOrWhiteSpace(StatusFilter)) items = items.Where(a => a.Status == StatusFilter);
        if (!string.IsNullOrWhiteSpace(MethodFilter)) items = items.Where(a => a.Method == MethodFilter);
        return items;
    }

    protected override IEnumerable<AttendanceRecord> ApplySort(IEnumerable<AttendanceRecord> items) => SortColumn switch
    {
        "nama" => SortAscending ? items.OrderBy(a => a.PersonName) : items.OrderByDescending(a => a.PersonName),
        _ => SortAscending ? items.OrderBy(a => a.Date) : items.OrderByDescending(a => a.Date)
    };

    protected override string CsvHeader => "Id,Nama,Peran,Tanggal,Status,Metode";

    protected override string CsvRow(AttendanceRecord a) =>
        $"{a.Id},{Csv(a.PersonName)},{Csv(a.Role)},{a.Date:yyyy-MM-dd},{Csv(a.Status)},{Csv(a.Method)}";

    private void ResetPage() => CurrentPage = 1;

    private static string StatusLabel(string status) => status switch
    {
        "Present" => "Hadir",
        "Absent" => "Tidak hadir",
        "Sick" => "Sakit",
        "Permit" => "Izin",
        _ => status
    };

    private static string StatusTone(string status) => status switch
    {
        "Present" => "sms-badge--good",
        "Absent" => "sms-badge--bad",
        _ => "sms-badge--warn"
    };
}
