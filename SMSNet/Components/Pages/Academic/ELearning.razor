@page "/academic/elearning"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Guru + "," + AppRoles.Siswa)]
@inherits CrudPageBase<ELearningContent>

<PageTitle>E-Learning — SMSNet</PageTitle>

<PageHeader Eyebrow="Akademik" Title="E-Learning"
            Subtitle="Modul pembelajaran daring, video, kuis, dan ujian berbasis sistem.">
    <Actions>
        <AuthorizeView Roles="@(AppRoles.Admin + "," + AppRoles.Guru)">
            <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
                <Icon Name="download" /><span>Ekspor CSV</span>
            </button>
            <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
                <Icon Name="plus" /><span>Tambah Materi</span>
            </button>
        </AuthorizeView>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-4 mb-6">
    <StatTile Label="Total Materi" Value="@Items.Count.ToString()" Icon="book" Tone="brand" />
    <StatTile Label="Video" Value="@Items.Count(c => c.ModuleType == "Video").ToString()" Icon="image" />
    <StatTile Label="Kuis" Value="@Items.Count(c => c.ModuleType == "Quiz").ToString()" Icon="clipboard" />
    <StatTile Label="Modul" Value="@Items.Count(c => c.ModuleType == "Modul").ToString()" Icon="layers" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Judul materi…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-jenis">Jenis</label>
            <select id="f-jenis" class="sms-select" @bind="TypeFilter" @bind:after="ResetPage">
                <option value="">Semua jenis</option>
                @foreach (var jenis in Items.Select(c => c.ModuleType).Distinct().OrderBy(t => t))
                {
                    <option value="@jenis">@jenis</option>
                }
            </select>
        </div>
    </div>

    @if (Loading)
    {
        <div class="grid gap-4 md:grid-cols-2">@for (var i = 0; i < 4; i++) { <div class="sms-skeleton h-24"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="book" Title="Belum ada materi"
                    Hint="Tambahkan modul, video, atau kuis untuk diakses siswa." />
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var materi in Paged)
            {
                <article class="rounded-xl border p-4 transition sms-reveal"
                         style="border-color: var(--rule); background: var(--bg-inset)">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="font-display font-semibold m-0" style="color: var(--fg-strong)">@materi.Title</p>
                            <span class="sms-badge mt-1">@materi.ModuleType</span>
                        </div>
                        <AuthorizeView Roles="@(AppRoles.Admin + "," + AppRoles.Guru)">
                            <div class="flex flex-none gap-1">
                                <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                        @onclick="() => StartEdit(materi)"><Icon Name="edit" /></button>
                                <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                        style="color: var(--bata)" @onclick="() => AskDelete(materi)"><Icon Name="trash" /></button>
                            </div>
                        </AuthorizeView>
                    </div>
                    <p class="text-sm mt-2 m-0" style="color: var(--fg-muted)">@(materi.Description ?? "Tanpa keterangan.")</p>

                    <div class="flex items-center gap-2 mt-3">
                        @if (string.IsNullOrWhiteSpace(materi.LinkUrl))
                        {
                            <span class="text-xs" style="color: var(--fg-faint)">Belum ada tautan materi.</span>
                        }
                        else
                        {
                            <LinkButton Url="@materi.LinkUrl" Label="@OpenLabel(materi.ModuleType)" />
                            <span class="text-xs truncate" style="color: var(--fg-faint)">@HostOf(materi.LinkUrl)</span>
                        }
                    </div>
                </article>
            }
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="materi" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Tambah Materi" : "Ubah Materi")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveMaterialAsync" id="form-materi">
            <DataAnnotationsValidator />
            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Judul</label>
                    <InputText class="sms-input" @bind-Value="Form.Title" />
                </div>
                <div class="sms-field">
                    <label class="sms-label">Jenis</label>
                    <InputSelect class="sms-select" @bind-Value="Form.ModuleType">
                        <option value="Modul">Modul</option>
                        <option value="Video">Video</option>
                        <option value="Quiz">Kuis</option>
                        <option value="Ujian">Ujian</option>
                    </InputSelect>
                </div>
                <div class="sms-field">
                    <label class="sms-label">Tautan materi</label>
                    <input class="sms-input" type="url" placeholder="https://… (video, dokumen, atau formulir kuis)"
                           value="@Form.LinkUrl"
                           @oninput="e => OnLinkChanged(e.Value?.ToString())" />
                    @if (_linkError is not null)
                    {
                        <p class="text-xs m-0" style="color: var(--bata)">@_linkError</p>
                    }
                    else
                    {
                        <p class="text-xs m-0" style="color: var(--fg-faint)">
                            Opsional. Siswa membukanya lewat tombol pada kartu materi.
                        </p>
                    }
                </div>
                <div class="sms-field">
                    <label class="sms-label">Keterangan</label>
                    <InputTextArea class="sms-textarea" rows="3" @bind-Value="Form.Description" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="SaveMaterialAsync">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen" Title="Hapus materi"
               Message="Materi e-learning ini akan dihapus permanen."
               Detail="@PendingDeleteLabel" OnConfirm="ConfirmDeleteAsync" />

@code {
    private string TypeFilter = string.Empty;
    private string? _linkError;

    protected override void OnFormOpened() => _linkError = null;

    private void OnLinkChanged(string? value)
    {
        Form.LinkUrl = value;

        // Validate as they type rather than only on save: a mistyped link is far
        // easier to fix while the address is still on screen.
        _linkError = string.IsNullOrWhiteSpace(value) || LinkButton.Normalize(value) is not null
            ? null
            : "Gunakan alamat http:// atau https://.";
    }

    private async Task SaveMaterialAsync()
    {
        if (string.IsNullOrWhiteSpace(Form.Title))
        {
            _linkError = "Judul materi belum diisi.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(Form.LinkUrl))
        {
            var normalised = LinkButton.Normalize(Form.LinkUrl);

            if (normalised is null)
            {
                _linkError = "Gunakan alamat http:// atau https://.";
                return;
            }

            // Store the normalised form so "drive.google.com/…" doesn't end up
            // resolving against this app when it is rendered.
            Form.LinkUrl = normalised;
        }

        _linkError = null;
        await SaveAsync();
    }

    private static string OpenLabel(string moduleType) => moduleType switch
    {
        "Video" => "Tonton",
        "Quiz" => "Kerjakan kuis",
        "Ujian" => "Mulai ujian",
        _ => "Buka materi"
    };

    /// <summary>The host alone, so a long link doesn't blow out the card.</summary>
    private static string HostOf(string? url) =>
        Uri.TryCreate(LinkButton.Normalize(url) ?? string.Empty, UriKind.Absolute, out var parsed)
            ? parsed.Host
            : string.Empty;

    protected override string EntityLabel => "materi e-learning";

    protected override DbSet<ELearningContent> Table(ApplicationDbContext db) => db.ELearningContents;

    protected override IEnumerable<string?> SearchableText(ELearningContent c) =>
        new[] { c.Title, c.ModuleType, c.Description, c.LinkUrl };

    protected override string Describe(ELearningContent c) => c.Title;

    protected override int IdOf(ELearningContent c) => c.Id;

    protected override ELearningContent NewEntity() => new() { ModuleType = "Modul" };

    protected override ELearningContent CloneForEdit(ELearningContent c) => new()
    {
        Id = c.Id, Title = c.Title, ModuleType = c.ModuleType,
        Description = c.Description, LinkUrl = c.LinkUrl
    };

    protected override IEnumerable<ELearningContent> ApplyFilters(IEnumerable<ELearningContent> items) =>
        string.IsNullOrWhiteSpace(TypeFilter) ? items : items.Where(c => c.ModuleType == TypeFilter);

    protected override IEnumerable<ELearningContent> ApplySort(IEnumerable<ELearningContent> items) =>
        SortAscending ? items.OrderBy(c => c.Title) : items.OrderByDescending(c => c.Title);

    protected override string CsvHeader => "Id,Judul,Jenis,Tautan,Keterangan";

    protected override string CsvRow(ELearningContent c) =>
        $"{c.Id},{Csv(c.Title)},{Csv(c.ModuleType)},{Csv(c.LinkUrl)},{Csv(c.Description)}";

    private void ResetPage() => CurrentPage = 1;
}
