@page "/auth/access-denied"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Akses Ditolak — SMSNet</PageTitle>

<div class="text-center">
    <span style="color: var(--kunyit)"><Icon Name="shield" Class="w-11 h-11 mx-auto" /></span>

    <h1 class="sms-auth__title mt-4">Akses Ditolak</h1>
    <p class="sms-auth__sub">
        Akun Anda tidak memiliki izin untuk membuka halaman tersebut.
        Hubungi administrator sekolah bila Anda merasa seharusnya memiliki akses.
    </p>

    <div class="grid gap-2">
        <a href="/" class="sms-btn sms-btn--primary sms-btn--block">Kembali ke Dashboard</a>
        <a href="/asisten" class="sms-btn sms-btn--ghost sms-btn--block">Tanya Pak Dedi</a>
    </div>
</div>
