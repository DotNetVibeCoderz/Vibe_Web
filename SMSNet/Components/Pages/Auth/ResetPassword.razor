@page "/auth/reset-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@inject UserManager<AppUser> UserManager
@inject ToastService Toasts

<PageTitle>Reset Kata Sandi — SMSNet</PageTitle>

<h1 class="sms-auth__title">Reset Kata Sandi</h1>
<p class="sms-auth__sub">Masukkan username dan kata sandi baru Anda.</p>

@if (_errors.Count > 0)
{
    <div class="sms-auth__error" role="alert">
        <ul class="list-none m-0 p-0 space-y-1">
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (_done)
{
    <div class="text-center py-4">
        <span style="color: var(--daun)"><Icon Name="check" Class="w-10 h-10 mx-auto" /></span>
        <p class="font-semibold mt-3 mb-1" style="color: var(--fg-strong)">Kata sandi diperbarui</p>
        <p class="text-sm m-0" style="color: var(--fg-muted)">Silakan masuk dengan kata sandi baru Anda.</p>
        <a href="/auth/login" class="sms-btn sms-btn--primary sms-btn--block mt-5">Ke halaman masuk</a>
    </div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="ResetAsync">
        <DataAnnotationsValidator />

        <div class="grid gap-4">
            <div class="sms-field">
                <label class="sms-label">Username</label>
                <InputText class="sms-input" @bind-Value="_model.UserName" autocomplete="username" />
                <ValidationMessage For="() => _model.UserName" />
            </div>

            <div class="sms-field">
                <label class="sms-label">Kata sandi baru</label>
                <InputText type="password" class="sms-input" @bind-Value="_model.NewPassword"
                           autocomplete="new-password" />
                <ValidationMessage For="() => _model.NewPassword" />
            </div>

            <div class="sms-field">
                <label class="sms-label">Ulangi kata sandi baru</label>
                <InputText type="password" class="sms-input" @bind-Value="_model.ConfirmPassword"
                           autocomplete="new-password" />
                <ValidationMessage For="() => _model.ConfirmPassword" />
            </div>

            <button type="submit" class="sms-btn sms-btn--primary sms-btn--block mt-1" disabled="@_busy">
                @(_busy ? "Memproses…" : "Reset kata sandi")
            </button>
        </div>
    </EditForm>

    <p class="sms-auth__hint">
        Pada instalasi produksi, langkah ini sebaiknya diganti dengan tautan reset
        sekali pakai yang dikirim melalui email. Alur langsung ini disediakan agar
        sekolah tetap dapat memulihkan akses sebelum layanan email dikonfigurasi.
    </p>
}

<p class="sms-auth__foot">
    Ingat kata sandi Anda? <a href="/auth/login">Masuk di sini</a>
</p>

@code {
    private readonly ResetInput _model = new();
    private readonly List<string> _errors = new();
    private bool _busy;
    private bool _done;

    private async Task ResetAsync()
    {
        _busy = true;
        _errors.Clear();

        try
        {
            var user = await UserManager.FindByNameAsync(_model.UserName);

            if (user is null)
            {
                _errors.Add("Username tidak ditemukan.");
                return;
            }

            // Generate and immediately redeem the token: without an email service
            // there is nowhere to send a link, and Identity requires a valid token.
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var result = await UserManager.ResetPasswordAsync(user, token, _model.NewPassword);

            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors.Select(e => e.Description));
                return;
            }

            _done = true;
            Toasts.Success("Kata sandi berhasil diperbarui.");
        }
        catch (Exception ex)
        {
            _errors.Add($"Reset gagal: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class ResetInput
    {
        [Required(ErrorMessage = "Username wajib diisi.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Kata sandi baru wajib diisi.")]
        [MinLength(6, ErrorMessage = "Kata sandi minimal 6 karakter.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ulangi kata sandi baru.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Kedua kata sandi tidak sama.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
