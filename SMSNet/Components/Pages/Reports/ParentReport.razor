@page "/reports/parent"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Guru)]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Laporan Orang Tua — SMSNet</PageTitle>

<PageHeader Eyebrow="Analitik & Laporan" Title="Laporan Orang Tua & Siswa"
            Subtitle="Ringkasan keterlibatan wali, tagihan, dan kondisi belajar per siswa." />

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-6">
    <StatTile Label="Wali Terdaftar" Value="@_parents.ToString()"
              Meta="@($"{_students} siswa aktif")" Icon="users" Tone="brand" />
    <StatTile Label="Kontak Lengkap" Value="@($"{_contactRate:0.#}%")"
              Meta="wali dengan email & telepon" Icon="bell"
              Tone="@(_contactRate >= 80 ? "good" : "warn")" />
    <StatTile Label="Siswa Menunggak" Value="@_studentsWithDebt.ToString()"
              Meta="@($"Rp{_outstanding:N0}")" Icon="coins"
              Tone="@(_studentsWithDebt > 0 ? "warn" : "good")" />
    <StatTile Label="Notifikasi Terkirim" Value="@_notifications.ToString()" Icon="bell" />
</div>

<div class="grid gap-6 lg:grid-cols-2 mb-6">
    <div class="sms-card">
        <div class="sms-card__head"><h2 class="sms-card__title">Status Tagihan per Siswa</h2></div>
        <div style="height: 16rem"><canvas id="pr-tagihan"></canvas></div>
    </div>
    <div class="sms-card">
        <div class="sms-card__head"><h2 class="sms-card__title">Sasaran Notifikasi</h2></div>
        <div style="height: 16rem"><canvas id="pr-notif"></canvas></div>
    </div>
</div>

<div class="sms-card">
    <div class="sms-card__head"><h2 class="sms-card__title">Perlu Perhatian</h2></div>

    @if (_attention.Count == 0)
    {
        <EmptyState Icon="check" Title="Tidak ada yang perlu ditindaklanjuti"
                    Hint="Seluruh siswa tuntas secara akademik dan administratif." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th>Siswa</th>
                        <th>Kelas</th>
                        <th>Wali</th>
                        <th class="sms-table__num">Tunggakan</th>
                        <th class="sms-table__num">Rata-rata Nilai</th>
                        <th>Alasan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _attention)
                    {
                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@row.Student</td>
                            <td>@row.ClassName</td>
                            <td>@row.Parent</td>
                            <td class="sms-table__num" style="color: @(row.Debt > 0 ? "var(--bata)" : "var(--fg-muted)")">
                                @(row.Debt > 0 ? $"Rp{row.Debt:N0}" : "—")
                            </td>
                            <td class="sms-table__num">@(row.Average > 0 ? row.Average.ToString("0.##") : "—")</td>
                            <td><span class="sms-badge sms-badge--warn">@row.Reason</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private sealed record AttentionRow(string Student, string ClassName, string Parent,
        decimal Debt, decimal Average, string Reason);

    private int _parents, _students, _studentsWithDebt, _notifications;
    private double _contactRate;
    private decimal _outstanding;

    private List<AttentionRow> _attention = new();
    private List<string> _notifLabels = new();
    private List<int> _notifSeries = new();
    private int _paidStudents, _unpaidStudents;

    private bool _rendered;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var parents = await db.Parents.AsNoTracking().ToListAsync();
        var students = await db.Students.AsNoTracking().Where(s => s.Status == "Active").ToListAsync();
        var payments = await db.PaymentRecords.AsNoTracking().ToListAsync();
        var grades = await db.GradeRecords.AsNoTracking().ToListAsync();

        _parents = parents.Count;
        _students = students.Count;
        _notifications = await db.Notifications.CountAsync();

        var complete = parents.Count(p => !string.IsNullOrWhiteSpace(p.Email) && !string.IsNullOrWhiteSpace(p.Phone));
        _contactRate = parents.Count == 0 ? 0 : complete * 100.0 / parents.Count;

        var unpaid = payments.Where(p => p.Status != "Paid").ToList();
        _outstanding = unpaid.Sum(p => p.Amount);
        _studentsWithDebt = unpaid.Select(p => p.StudentName).Distinct().Count();

        _unpaidStudents = _studentsWithDebt;
        _paidStudents = Math.Max(0, students.Count - _studentsWithDebt);

        // A student needs following up when they owe money or are below the pass mark.
        foreach (var student in students)
        {
            var debt = unpaid.Where(p => p.StudentName == student.FullName).Sum(p => p.Amount);
            var studentGrades = grades.Where(g => g.StudentName == student.FullName).ToList();
            var average = studentGrades.Count == 0 ? 0 : studentGrades.Average(g => g.Score);

            var reasons = new List<string>();
            if (debt > 0) reasons.Add("Tunggakan");
            if (studentGrades.Count > 0 && average < 75) reasons.Add("Nilai di bawah KKM");

            if (reasons.Count > 0)
            {
                _attention.Add(new AttentionRow(
                    student.FullName,
                    student.ClassName ?? "—",
                    student.ParentName ?? "—",
                    debt,
                    average,
                    string.Join(" · ", reasons)));
            }
        }

        _attention = _attention.OrderByDescending(a => a.Debt).ThenBy(a => a.Average).Take(25).ToList();

        var byAudience = await db.Notifications.AsNoTracking()
            .GroupBy(n => n.Audience)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToListAsync();
        _notifLabels = byAudience.Select(x => x.Key).ToList();
        _notifSeries = byAudience.Select(x => x.Count).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendered)
        {
            return;
        }

        _rendered = true;

        try
        {
            await JS.InvokeVoidAsync("smsnetChart.render", "pr-tagihan", "doughnut",
                new[] { "Lunas", "Menunggak" }, new[] { _paidStudents, _unpaidStudents }, "Siswa");

            await JS.InvokeVoidAsync("smsnetChart.render", "pr-notif", "bar",
                _notifLabels, _notifSeries, "Notifikasi");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
}
