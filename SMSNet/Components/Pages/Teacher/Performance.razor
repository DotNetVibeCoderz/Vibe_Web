@page "/teacher/performance"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Guru)]
@inherits CrudPageBase<PerformanceReview>
@inject CommentService Comments

<PageTitle>Evaluasi Kinerja — SMSNet</PageTitle>

<PageHeader Eyebrow="Guru & Staff" Title="Evaluasi Kinerja"
            Subtitle="Indikator kinerja (KPI) guru dan staff beserta capaiannya.">
    <Actions>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="ExportCsvAsync">
            <Icon Name="download" /><span>Ekspor CSV</span>
        </button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="StartAdd">
            <Icon Name="plus" /><span>Tambah Penilaian</span>
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-4 md:grid-cols-4 mb-6">
    <StatTile Label="Total Penilaian" Value="@Items.Count.ToString()" Icon="gauge" Tone="brand" />
    <StatTile Label="Guru Dinilai" Value="@Items.Select(p => p.TeacherName).Distinct().Count().ToString()" Icon="teacher" />
    <StatTile Label="Jenis KPI" Value="@Items.Select(p => p.KPI).Distinct().Count().ToString()" Icon="layers" />
    <StatTile Label="Catatan" Value="@_commentCounts.Values.Sum().ToString()" Icon="chat" />
</div>

<div class="sms-card">
    <div class="sms-toolbar">
        <div class="sms-field">
            <label class="sms-label" for="cari">Pencarian bebas</label>
            <input id="cari" class="sms-input" placeholder="Nama guru atau KPI…"
                   value="@Search" @oninput="e => OnSearchChanged(e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="sms-field">
            <label class="sms-label" for="f-kpi">KPI</label>
            <select id="f-kpi" class="sms-select" @bind="KpiFilter" @bind:after="ResetPage">
                <option value="">Semua KPI</option>
                @foreach (var kpi in Items.Select(p => p.KPI).Distinct().OrderBy(k => k))
                {
                    <option value="@kpi">@kpi</option>
                }
            </select>
        </div>
    </div>

    @if (Loading)
    {
        <div class="space-y-2">@for (var i = 0; i < 5; i++) { <div class="sms-skeleton h-10"></div> }</div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="gauge" Title="Belum ada penilaian kinerja"
                    Hint="Tambahkan indikator kinerja untuk guru dan staff." />
    }
    else
    {
        <div class="sms-table-wrap">
            <table class="sms-table">
                <thead>
                    <tr>
                        <th class="is-sortable" @onclick='() => SortBy("guru")'>Guru <span class="sort-caret">@SortCaret("guru")</span></th>
                        <th>Indikator (KPI)</th>
                        <th>Capaian</th>
                        <th style="min-width: 10rem">Grafik</th>
                        <th class="text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Paged)
                    {
                        var persen = MeterPercent(review);
                        var open = _openReviewId == review.Id;
                        var count = _commentCounts.GetValueOrDefault(review.Id);

                        <tr>
                            <td class="font-medium" style="color: var(--fg-strong)">@review.TeacherName</td>
                            <td>@review.KPI</td>
                            <td class="tabular font-semibold">
                                @review.Score
                                @if (review.Unit == "Skala")
                                {
                                    <span class="text-xs font-normal" style="color: var(--fg-faint)"> / 5</span>
                                }
                            </td>
                            <td>
                                @if (persen is null)
                                {
                                    <span class="text-xs" style="color: var(--fg-faint)">tidak terukur</span>
                                }
                                else
                                {
                                    <div class="sms-meter" title="@persen%">
                                        <div class="sms-meter__fill" style="width: @persen%"></div>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" class="sms-btn sms-btn--quiet"
                                            title="@(count == 0 ? "Komentari indikator" : $"{count} komentar")"
                                            @onclick="() => ToggleThread(review.Id)">
                                        <Icon Name="chat" />
                                        @if (count > 0)
                                        {
                                            <span class="text-xs">@count</span>
                                        }
                                    </button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Ubah"
                                            @onclick="() => StartEdit(review)"><Icon Name="edit" /></button>
                                    <button type="button" class="sms-btn sms-btn--quiet" title="Hapus"
                                            style="color: var(--bata)" @onclick="() => AskDelete(review)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>

                        @if (open)
                        {
                            <tr>
                                <td colspan="5" style="background: var(--bg-inset)">
                                    <div class="px-1 pb-2">
                                        <p class="text-xs m-0 mb-1" style="color: var(--fg-faint)">
                                            Catatan untuk <strong>@review.KPI</strong> — @review.TeacherName
                                        </p>
                                        <CommentThread ThreadType="@CommentThreads.Performance" ThreadId="review.Id"
                                                       OnCountChanged="c => OnCommentCountChanged(review.Id, c)" />
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <Pager Showing="Paged.Count" Total="Filtered.Count" Current="CurrentPage" TotalPages="TotalPages"
               Noun="penilaian" OnPrevious="PreviousPage" OnNext="NextPage" />
    }
</div>

<Modal Open="ShowForm" OpenChanged="_ => CancelForm()"
       Title="@(IdOf(Form) == 0 ? "Tambah Penilaian" : "Ubah Penilaian")">
    <ChildContent>
        <EditForm Model="Form" OnValidSubmit="SaveReviewAsync" id="form-kinerja">
            <DataAnnotationsValidator />
            <div class="grid gap-4">
                <div class="sms-field">
                    <label class="sms-label">Nama guru</label>
                    <LookupInput Value="@Form.TeacherName" ValueChanged="v => Form.TeacherName = v"
                                 Options="_teacherNames" Noun="guru"
                                 Placeholder="Ketik nama guru…" />
                </div>

                <div class="sms-field">
                    <label class="sms-label">Indikator kinerja</label>
                    <LookupInput Value="@Form.KPI" ValueChanged="v => Form.KPI = v"
                                 Options="IndicatorTemplates" Noun="indikator" ShowHint="false"
                                 Placeholder="Pilih dari daftar atau tulis sendiri…" />

                    <div class="flex flex-wrap gap-1 mt-2">
                        @foreach (var template in IndicatorTemplates.Take(6))
                        {
                            <button type="button"
                                    class="sms-pilih-kelas__item @(Form.KPI == template ? "is-aktif" : "")"
                                    @onclick="() => ApplyTemplate(template)">
                                @template
                            </button>
                        }
                    </div>
                    <p class="text-xs m-0 mt-1" style="color: var(--fg-faint)">
                        Templat di atas hanya pintasan — indikator lain boleh ditulis bebas.
                    </p>
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                    <div class="sms-field">
                        <label class="sms-label">Satuan capaian</label>
                        <InputSelect class="sms-select" @bind-Value="Form.Unit">
                            <option value="Persen">Persen (0–100%)</option>
                            <option value="Skala">Skala (0–5)</option>
                            <option value="Teks">Teks / huruf</option>
                        </InputSelect>
                    </div>
                    <div class="sms-field">
                        <label class="sms-label">Capaian</label>
                        <input class="sms-input" placeholder="@PlaceholderFor(Form.Unit)"
                               value="@Form.Score"
                               @oninput="e => OnScoreChanged(e.Value?.ToString())" />
                        @if (_scoreError is not null)
                        {
                            <p class="text-xs m-0" style="color: var(--bata)">@_scoreError</p>
                        }
                        else
                        {
                            <p class="text-xs m-0" style="color: var(--fg-faint)">@HintFor(Form.Unit)</p>
                        }
                    </div>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="sms-btn sms-btn--ghost" @onclick="CancelForm">Batal</button>
        <button type="button" class="sms-btn sms-btn--primary" @onclick="SaveReviewAsync">Simpan</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="ConfirmDeleteOpen" Title="Hapus penilaian"
               Message="Data penilaian kinerja ini akan dihapus permanen beserta catatannya."
               Detail="@PendingDeleteLabel" OnConfirm="DeleteReviewAsync" />

@code {
    private string KpiFilter = string.Empty;

    private List<string> _teacherNames = new();
    private string? _scoreError;

    private int? _openReviewId;
    private Dictionary<int, int> _commentCounts = new();

    /// <summary>Common indicators, offered as shortcuts. Not a closed list — a school
    /// evaluates on whatever it has agreed to, so the field stays free text.</summary>
    private static readonly string[] IndicatorTemplates =
    {
        "Kehadiran",
        "Ketepatan Waktu Mengajar",
        "Kelengkapan Perangkat Ajar",
        "Penilaian Siswa",
        "Kedisiplinan Administrasi",
        "Partisipasi Kegiatan Sekolah",
        "Pengembangan Diri",
        "Kerja Sama Tim"
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadTeachersAsync();
        await LoadCommentCountsAsync();
    }

    private async Task LoadTeachersAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _teacherNames = await db.Teachers.AsNoTracking()
                .Where(t => t.Status == "Active")
                .OrderBy(t => t.FullName)
                .Select(t => t.FullName)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Gagal memuat daftar guru: {ex.Message}");
        }
    }

    private async Task LoadCommentCountsAsync()
    {
        try
        {
            _commentCounts = await Comments.CountsAsync(CommentThreads.Performance, Items.Select(IdOf));
        }
        catch
        {
            _commentCounts = new Dictionary<int, int>();
        }
    }

    private void ToggleThread(int id) => _openReviewId = _openReviewId == id ? null : id;

    private void OnCommentCountChanged(int reviewId, int count) => _commentCounts[reviewId] = count;

    private void ApplyTemplate(string template) => Form.KPI = template;

    protected override void OnFormOpened() => _scoreError = null;

    private void OnScoreChanged(string? value)
    {
        Form.Score = value ?? string.Empty;
        _scoreError = ValidateScore(Form.Score, Form.Unit);
    }

    /// <summary>
    /// Checks the achievement against its declared unit.
    /// <para>
    /// Only measurable units are checked: a letter grade has no range to violate,
    /// and rejecting one would stop a school recording the scheme it actually uses.
    /// </para>
    /// </summary>
    private static string? ValidateScore(string? score, string unit)
    {
        var raw = (score ?? string.Empty).Trim();

        if (raw.Length == 0)
        {
            return null;   // reported on save, not while the field is still empty
        }

        if (unit == "Teks")
        {
            return raw.Length > 40 ? "Terlalu panjang — maksimal 40 karakter." : null;
        }

        var numeric = raw.TrimEnd('%', ' ').Replace(',', '.');

        if (!decimal.TryParse(numeric, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            return unit == "Persen"
                ? "Capaian harus berupa angka, contoh: 95 atau 95%."
                : "Capaian harus berupa angka, contoh: 4.2.";
        }

        return unit switch
        {
            "Persen" when value < 0 || value > 100 => "Persentase harus di antara 0 dan 100.",
            "Skala" when value < 0 || value > 5 => "Skala harus di antara 0 dan 5.",
            _ => null
        };
    }

    private async Task SaveReviewAsync()
    {
        if (string.IsNullOrWhiteSpace(Form.TeacherName))
        {
            _scoreError = "Nama guru belum diisi.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Form.KPI))
        {
            _scoreError = "Indikator kinerja belum diisi.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Form.Score))
        {
            _scoreError = "Capaian belum diisi.";
            return;
        }

        var error = ValidateScore(Form.Score, Form.Unit);

        if (error is not null)
        {
            _scoreError = error;
            return;
        }

        _scoreError = null;
        Form.Score = Form.Score.Trim();

        await SaveAsync();
        await LoadCommentCountsAsync();
    }

    private async Task DeleteReviewAsync()
    {
        var id = PendingDelete is null ? 0 : IdOf(PendingDelete);

        await ConfirmDeleteAsync();

        if (id > 0)
        {
            await Comments.DeleteThreadAsync(CommentThreads.Performance, id);
            _commentCounts.Remove(id);

            if (_openReviewId == id)
            {
                _openReviewId = null;
            }
        }
    }

    private static string PlaceholderFor(string unit) => unit switch
    {
        "Skala" => "contoh: 4.2",
        "Teks" => "contoh: Sangat Baik",
        _ => "contoh: 95%"
    };

    private static string HintFor(string unit) => unit switch
    {
        "Skala" => "Angka 0 sampai 5.",
        "Teks" => "Tidak diukur pada grafik.",
        _ => "Angka 0 sampai 100, tanda % boleh disertakan."
    };

    protected override string EntityLabel => "penilaian kinerja";

    protected override DbSet<PerformanceReview> Table(ApplicationDbContext db) => db.PerformanceReviews;

    protected override IEnumerable<string?> SearchableText(PerformanceReview p) =>
        new[] { p.TeacherName, p.KPI, p.Score };

    protected override string Describe(PerformanceReview p) => $"{p.TeacherName} — {p.KPI}";

    protected override int IdOf(PerformanceReview p) => p.Id;

    protected override PerformanceReview NewEntity() => new() { Unit = "Persen" };

    protected override PerformanceReview CloneForEdit(PerformanceReview p) => new()
    {
        Id = p.Id, TeacherName = p.TeacherName, KPI = p.KPI, Score = p.Score, Unit = p.Unit
    };

    protected override IEnumerable<PerformanceReview> ApplyFilters(IEnumerable<PerformanceReview> items) =>
        string.IsNullOrWhiteSpace(KpiFilter) ? items : items.Where(p => p.KPI == KpiFilter);

    protected override IEnumerable<PerformanceReview> ApplySort(IEnumerable<PerformanceReview> items) =>
        SortAscending ? items.OrderBy(p => p.TeacherName) : items.OrderByDescending(p => p.TeacherName);

    protected override string CsvHeader => "Id,Guru,KPI,Capaian,Satuan,Catatan";

    protected override string CsvRow(PerformanceReview p) =>
        $"{p.Id},{Csv(p.TeacherName)},{Csv(p.KPI)},{Csv(p.Score)},{Csv(p.Unit)}," +
        $"{_commentCounts.GetValueOrDefault(p.Id)}";

    private void ResetPage() => CurrentPage = 1;

    /// <summary>
    /// The meter position, or null when the achievement is not measurable.
    /// <para>
    /// The unit is what makes this correct: read as a bare number, "4.2" out of 5
    /// would fill the bar to 4%.
    /// </para>
    /// </summary>
    private static int? MeterPercent(PerformanceReview review)
    {
        if (review.Unit == "Teks")
        {
            return null;
        }

        var raw = (review.Score ?? string.Empty).Trim().TrimEnd('%', ' ').Replace(',', '.');

        if (!decimal.TryParse(raw, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            return null;
        }

        var percent = review.Unit == "Skala" ? value / 5m * 100m : value;

        return (int)Math.Clamp(percent, 0, 100);
    }
}
