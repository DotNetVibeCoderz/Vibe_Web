@using SMSNet.Components.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    @* Anonymous visitors are sent to sign in with a return path;
                       signed-in users who simply lack the role are told so in place,
                       because bouncing them to a login form they already passed is
                       confusing. *@
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <LayoutView Layout="typeof(MainLayout)">
                            <div class="sms-card max-w-xl mx-auto text-center py-10">
                                <span style="color: var(--kunyit)">
                                    <Icon Name="shield" Class="w-10 h-10 mx-auto" />
                                </span>
                                <h1 class="font-display text-xl font-bold mt-4 mb-2"
                                    style="color: var(--fg-strong)">Akses Ditolak</h1>
                                <p class="text-sm m-0" style="color: var(--fg-muted)">
                                    Peran akun Anda tidak mencakup halaman ini.
                                    Hubungi administrator sekolah bila Anda memerlukan aksesnya.
                                </p>
                                <div class="flex justify-center gap-2 mt-5">
                                    <a class="sms-btn sms-btn--primary" href="/">Ke Dashboard</a>
                                    <a class="sms-btn sms-btn--ghost" href="/asisten">Tanya Pak Dedi</a>
                                </div>
                            </div>
                        </LayoutView>
                    }
                </NotAuthorized>
                <Authorizing>
                    <LayoutView Layout="typeof(MainLayout)">
                        <div class="space-y-3">
                            <div class="sms-skeleton h-8 w-64"></div>
                            <div class="sms-skeleton h-32"></div>
                        </div>
                    </LayoutView>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
