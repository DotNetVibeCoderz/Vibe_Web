      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1",
      "BucketName": "simplebidding-uploads"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
