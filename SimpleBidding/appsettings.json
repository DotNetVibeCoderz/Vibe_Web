{
  "DatabaseProvider": "Sqlite",
  "StorageProvider": "FileSystem",
  "CurrencySymbol": "Rp",
  "CurrencyCulture": "id-ID",
  "ConnectionStrings": {
    "Sqlite": "Data Source=SimpleBidding.db",
    "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=SimpleBidding;Trusted_Connection=True;MultipleActiveResultSets=true",
