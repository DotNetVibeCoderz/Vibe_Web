@page "/admin/reports"
@attribute [Authorize(Roles = "Admin")]
@inject AuditService AuditService
@inject ReportService ReportService

<h3 class="fw-bold mb-4">📜 System Reports</h3>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Audit Logs</h5>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadLogs">Refresh</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">Timestamp</th>
                                <th>User ID</th>
                                <th>Action</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (logs == null)
                            {
                                <tr><td colspan="4" class="text-center py-3">Loading...</td></tr>
                            }
                            else
                            {
                                @foreach (var log in logs)
                                {
                                    <tr>
                                        <td class="ps-3 small">@log.Timestamp.ToLocalTime().ToString("g")</td>
                                        <td class="small">@log.UserId</td>
                                        <td><span class="badge bg-info text-dark">@log.Action</span></td>
                                        <td class="small">@log.Details</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AuditLog>? logs;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        logs = await AuditService.GetAllLogsAsync();
    }
}
