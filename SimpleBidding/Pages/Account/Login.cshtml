@page
@model SimpleBidding.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-warning text-dark text-center py-3">
                <h4 class="mb-0 fw-bold">Login to SimpleBidder</h4>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email Address</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" type="password" placeholder="Password" />
                        <label asp-for="Input.Password">Password</label>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label class="form-check-label" asp-for="Input.RememberMe">Remember Me</label>
                    </div>
                    <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">SIGN IN</button>
                </form>
                <div class="mt-4 text-center border-top pt-3">
                    <p class="text-muted small">Don't have an account? <a href="/Account/Register" class="text-warning fw-bold">Register Here</a></p>
                </div>
            </div>
        </div>
        <div class="mt-4 alert alert-info shadow-sm">
            <h6 class="fw-bold"><i class="bi bi-info-circle"></i> Demo Accounts:</h6>
            <ul class="list-unstyled mb-0 small">
                <li><strong>Admin:</strong> admin@bidding.com</li>
                <li><strong>Seller:</strong> seller@bidding.com</li>
                <li><strong>Bidder:</strong> bidder@bidding.com</li>
                <li class="mt-1"><strong>Password:</strong> <code class="bg-light p-1">Password123!</code></li>
            </ul>
        </div>
    </div>
</div>
