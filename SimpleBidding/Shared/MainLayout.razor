@inherits LayoutComponentBase

<div class="page">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <span class="fs-3 me-2">🔨</span>
                <span class="fw-bold text-warning">SimpleBidder</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" href="/winners">Winners</a></li>
                            <AuthorizeView Roles="Admin,Seller" Context="inner">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Management
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow mt-2" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" href="/admin/items"><i class="bi bi-box me-2"></i>Inventory</a></li>
                                        <li><a class="dropdown-item" href="/admin/winners"><i class="bi bi-trophy me-2"></i>Tentukan Pemenang</a></li>
                                        <AuthorizeView Roles="Admin" Context="adminInner">
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="/admin/reports"><i class="bi bi-file-earmark-bar-graph me-2"></i>Reports</a></li>
                                        </AuthorizeView>
                                    </ul>
                                </li>
                            </AuthorizeView>
                        </Authorized>
                    </AuthorizeView>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-warning" @onclick="ToggleTheme" title="Ganti Tema">
                        <i class="bi @(isDarkMode ? "bi-sun" : "bi-moon")"></i>
                    </button>
                    <AuthorizeView>
                        <Authorized>
                            <div class="dropdown">
                                <button class="btn btn-link text-light text-decoration-none dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" id="userDropdown">
                                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                                        @context.User.Identity?.Name?[0].ToString().ToUpper()
                                    </div>
                                    <span class="d-none d-md-inline">@context.User.Identity?.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header">User Menu</h6></li>
                                    <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                    <li><a class="dropdown-item" href="/Account/ChangePassword"><i class="bi bi-key me-2"></i>Security</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="Account/Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                                <i class="bi bi-box-arrow-right me-2"></i>Logout (Keluar)
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <a href="Account/Login" class="btn btn-warning btn-sm px-4 fw-bold shadow-sm">LOGIN</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </nav>

    <main class="container mb-5" style="min-height: 70vh;">
        @Body
    </main>

    <footer class="footer mt-auto py-4 bg-dark text-light border-top border-warning border-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start">
                    <h5 class="text-warning fw-bold">SimpleBidder</h5>
                    <p class="small text-muted mb-0">Platform lelang terpercaya untuk semua barang impianmu.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <AuthorizeView>
                        <Authorized>
                            <form action="Account/Logout" method="post" class="mb-2">
                                <button type="submit" class="btn btn-sm btn-outline-danger px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout Sekarang
                                </button>
                            </form>
                        </Authorized>
                    </AuthorizeView>
                    <small class="text-muted">Developed by <strong>Jacky the Code Bender</strong></small><br/>
                    <small class="text-muted">Gravicode Studios &copy; 2024</small>
                </div>
            </div>
        </div>
    </footer>
</div>

@code {
    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "theme");
            isDarkMode = theme == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("setTheme", isDarkMode ? "dark" : "light");
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}
