@page "/kategori"
@page "/categories"
@using Microsoft.EntityFrameworkCore
@using MyPoS.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ExportService ExportService
@inject SettingsService SettingsService
@inject MyPoS.Services.Import.CategoryImporter Importer
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Kategori — @_settings.StoreName</PageTitle>

<div class="d-flex flex-wrap align-end justify-space-between mb-6" style="gap:1rem;">
    <div>
        <div class="eyebrow">Data master</div>
        <h1 class="page-title mt-1">Kategori</h1>
        <p class="page-subtitle">Kategori menjadi tab penyaring di halaman kasir.</p>
    </div>

    <div class="d-flex" style="gap:.5rem;">
        <MudButton Variant="Variant.Outlined" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.UploadFile" OnClick="() => _importDialog?.Open()">
            Impor Excel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">Tambah kategori</MudButton>
    </div>
</div>

<ImportDialog @ref="_importDialog" Importer="Importer" OnImported="LoadAsync" />

<div class="panel panel--flush">
    <div class="toolbar">
        <MudTextField @bind-Value="_search" Placeholder="Cari kategori…" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Clearable="true" Style="min-width:240px;" />
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportExcel">Excel</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv" Class="ml-2">CSV</MudButton>
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="empty">
            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" />
            <div>Belum ada kategori.</div>
        </div>
    }
    else
    {
        <MudTable Items="Filtered" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Dense="true">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<Row, object>(x => x.Name)">Nama</MudTableSortLabel></MudTh>
                <MudTh Class="cell-num"><MudTableSortLabel SortBy="new Func<Row, object>(x => x.ProductCount)">Jumlah produk</MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nama" Style="font-weight:600;">@context.Name</MudTd>
                <MudTd DataLabel="Jumlah produk" Class="cell-num"><span class="num">@context.ProductCount</span></MudTd>
                <MudTd>
                    <div class="d-flex justify-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEdit(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => Delete(context)" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

<MudDialog @bind-Visible="_dialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Ubah kategori" : "Kategori baru")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Nama kategori" Variant="Variant.Outlined" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogOpen = false">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public record Row(int Id, string Name, int ProductCount);

    private PosSettings _settings = new();
    private List<Row> _rows = new();
    private string _search = "";

    private int _editingId;
    private string _name = "";
    private bool _dialogOpen;
    private bool _isEdit;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
    private ImportDialog? _importDialog;

    private List<Row> Filtered => _rows
        .Where(r => string.IsNullOrWhiteSpace(_search) || r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.Categories
            .OrderBy(c => c.Name)
            .Select(c => new { c.Id, c.Name, ProductCount = c.Products.Count })
            .ToListAsync();

        _rows = rows.Select(c => new Row(c.Id, c.Name, c.ProductCount)).ToList();
    }

    private void OpenNew()
    {
        _editingId = 0;
        _name = "";
        _isEdit = false;
        _dialogOpen = true;
    }

    private void OpenEdit(Row row)
    {
        _editingId = row.Id;
        _name = row.Name;
        _isEdit = true;
        _dialogOpen = true;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Nama kategori wajib diisi.", Severity.Warning);
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var name = _name.Trim();

        if (await db.Categories.AnyAsync(c => c.Name == name && c.Id != _editingId))
        {
            Snackbar.Add($"Kategori \"{name}\" sudah ada.", Severity.Warning);
            return;
        }

        if (_isEdit)
        {
            var entity = await db.Categories.FindAsync(_editingId);
            if (entity is null) return;
            entity.Name = name;
        }
        else
        {
            db.Categories.Add(new Category { Name = name });
        }

        await db.SaveChangesAsync();
        Snackbar.Add("Kategori tersimpan.", Severity.Success);
        _dialogOpen = false;
        await LoadAsync();
    }

    private async Task Delete(Row row)
    {
        // Relasi produk-kategori memakai DeleteBehavior.Restrict, jadi penghapusan dicegah
        // di sini dengan pesan yang jelas alih-alih dibiarkan gagal di tingkat database.
        if (row.ProductCount > 0)
        {
            Snackbar.Add($"Kategori \"{row.Name}\" masih dipakai {row.ProductCount} produk.", Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Hapus kategori \"{row.Name}\"?");
        if (!confirmed) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Categories.FindAsync(row.Id);
        if (entity is null) return;

        db.Categories.Remove(entity);
        await db.SaveChangesAsync();
        Snackbar.Add("Kategori dihapus.", Severity.Info);
        await LoadAsync();
    }

    private IEnumerable<object> ExportRows() => Filtered.Select(r => new { r.Id, Nama = r.Name, JumlahProduk = r.ProductCount });

    private async Task ExportExcel()
    {
        var bytes = ExportService.ExportToExcel(ExportRows(), "Kategori");
        using var stream = new MemoryStream(bytes);
        await JS.InvokeVoidAsync("downloadFileFromStream", "Kategori.xlsx", new DotNetStreamReference(stream));
    }

    private async Task ExportCsv()
    {
        var bytes = ExportService.ExportToCsv(ExportRows());
        using var stream = new MemoryStream(bytes);
        await JS.InvokeVoidAsync("downloadFileFromStream", "Kategori.csv", new DotNetStreamReference(stream));
    }
}
