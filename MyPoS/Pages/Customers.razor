@page "/pelanggan"
@page "/customers"
@using Microsoft.EntityFrameworkCore
@using MyPoS.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ExportService ExportService
@inject MoneyFormatter Money
@inject SettingsService SettingsService
@inject MyPoS.Services.Import.CustomerImporter Importer
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Pelanggan — @_settings.StoreName</PageTitle>

<div class="d-flex flex-wrap align-end justify-space-between mb-6" style="gap:1rem;">
    <div>
        <div class="eyebrow">Data master</div>
        <h1 class="page-title mt-1">Pelanggan</h1>
        <p class="page-subtitle">
            @if (_settings.LoyaltyEnabled)
            {
                <text>Setiap belanja @Money.Format(_settings.LoyaltyAmountPerPoint) memberi 1 poin.</text>
            }
            else
            {
                <text>Program loyalitas sedang nonaktif.</text>
            }
        </p>
    </div>

    <div class="d-flex" style="gap:.5rem;">
        <MudButton Variant="Variant.Outlined" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.UploadFile" OnClick="() => _importDialog?.Open()">
            Impor Excel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenNew">Tambah pelanggan</MudButton>
    </div>
</div>

<ImportDialog @ref="_importDialog" Importer="Importer" OnImported="LoadAsync" />

<div class="panel panel--flush">
    <div class="toolbar">
        <MudTextField @bind-Value="_search" Placeholder="Cari nama, telepon, email…" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Clearable="true" Style="min-width:260px;" Class="flex-grow-1" />
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportExcel">Excel</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv" Class="ml-2">CSV</MudButton>
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="empty">
            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" />
            <div>Belum ada pelanggan.</div>
        </div>
    }
    else
    {
        <MudTable Items="Filtered" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Dense="true" RowsPerPage="15">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<Row, object>(x => x.Customer.Name)">Nama</MudTableSortLabel></MudTh>
                <MudTh>Telepon</MudTh>
                <MudTh>Email</MudTh>
                <MudTh Class="cell-num"><MudTableSortLabel SortBy="new Func<Row, object>(x => x.TotalSpent)">Total belanja</MudTableSortLabel></MudTh>
                <MudTh Class="cell-num">Transaksi</MudTh>
                <MudTh Class="cell-num"><MudTableSortLabel SortBy="new Func<Row, object>(x => x.Customer.LoyaltyPoints)">Poin</MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nama" Style="font-weight:600;">@context.Customer.Name</MudTd>
                <MudTd DataLabel="Telepon"><span class="num" style="font-size:.8rem;">@context.Customer.Phone</span></MudTd>
                <MudTd DataLabel="Email">@context.Customer.Email</MudTd>
                <MudTd DataLabel="Total belanja" Class="cell-num"><span class="num">@Money.Format(context.TotalSpent)</span></MudTd>
                <MudTd DataLabel="Transaksi" Class="cell-num"><span class="num">@context.OrderCount</span></MudTd>
                <MudTd DataLabel="Poin" Class="cell-num">
                    <span class="badge badge--leaf"><span class="num">@context.Customer.LoyaltyPoints</span></span>
                </MudTd>
                <MudTd>
                    <div class="d-flex justify-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEdit(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => Delete(context)" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Baris per halaman" InfoFormat="{first_item}-{last_item} dari {all_items}" />
            </PagerContent>
        </MudTable>
    }
</div>

<MudDialog @bind-Visible="_dialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Ubah pelanggan" : "Pelanggan baru")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editing.Name" Label="Nama" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_editing.Phone" Label="Telepon" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_editing.Email" Label="Email" Variant="Variant.Outlined" Class="mb-3"
                      HelperText="Dipakai penyedia pembayaran untuk mengirim tautan tagihan." />
        <MudNumericField @bind-Value="_editing.LoyaltyPoints" Label="Poin loyalitas" Variant="Variant.Outlined" Min="0" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogOpen = false">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public record Row(Customer Customer, decimal TotalSpent, int OrderCount);

    private PosSettings _settings = new();
    private List<Row> _rows = new();
    private string _search = "";

    private Customer _editing = new();
    private bool _dialogOpen;
    private bool _isEdit;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
    private ImportDialog? _importDialog;

    private List<Row> Filtered => _rows
        .Where(r => string.IsNullOrWhiteSpace(_search)
                    || r.Customer.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (r.Customer.Phone?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Customer.Email?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Riwayat belanja diringkas di sisi database supaya halaman tidak perlu
        // menarik seluruh transaksi hanya untuk menghitung dua angka.
        var totals = await db.Transactions
            .Where(t => t.Status == TransactionStatus.Paid && t.CustomerId != null)
            .GroupBy(t => t.CustomerId!.Value)
            .Select(g => new { CustomerId = g.Key, Total = g.Sum(t => t.TotalAmount), Count = g.Count() })
            .ToDictionaryAsync(x => x.CustomerId);

        var customers = await db.Customers.OrderBy(c => c.Name).AsNoTracking().ToListAsync();

        _rows = customers
            .Select(c => totals.TryGetValue(c.Id, out var t)
                ? new Row(c, t.Total, t.Count)
                : new Row(c, 0m, 0))
            .ToList();
    }

    private void OpenNew()
    {
        _editing = new Customer();
        _isEdit = false;
        _dialogOpen = true;
    }

    private void OpenEdit(Row row)
    {
        _editing = new Customer
        {
            Id = row.Customer.Id,
            Name = row.Customer.Name,
            Phone = row.Customer.Phone,
            Email = row.Customer.Email,
            LoyaltyPoints = row.Customer.LoyaltyPoints
        };
        _isEdit = true;
        _dialogOpen = true;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            Snackbar.Add("Nama pelanggan wajib diisi.", Severity.Warning);
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();

        if (_isEdit)
        {
            var entity = await db.Customers.FindAsync(_editing.Id);
            if (entity is null) return;

            entity.Name = _editing.Name.Trim();
            entity.Phone = _editing.Phone?.Trim();
            entity.Email = _editing.Email?.Trim();
            entity.LoyaltyPoints = _editing.LoyaltyPoints;
        }
        else
        {
            _editing.Name = _editing.Name.Trim();
            db.Customers.Add(_editing);
        }

        await db.SaveChangesAsync();
        Snackbar.Add("Pelanggan tersimpan.", Severity.Success);
        _dialogOpen = false;
        await LoadAsync();
    }

    private async Task Delete(Row row)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            row.OrderCount > 0
                ? $"\"{row.Customer.Name}\" punya {row.OrderCount} transaksi. Transaksi tetap tersimpan tanpa nama pelanggan. Lanjutkan?"
                : $"Hapus pelanggan \"{row.Customer.Name}\"?");

        if (!confirmed) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Customers.FindAsync(row.Customer.Id);
        if (entity is null) return;

        // Relasi transaksi memakai DeleteBehavior.SetNull, jadi riwayatnya tetap ada.
        db.Customers.Remove(entity);
        await db.SaveChangesAsync();
        Snackbar.Add("Pelanggan dihapus.", Severity.Info);
        await LoadAsync();
    }

    private IEnumerable<object> ExportRows() => Filtered.Select(r => new
    {
        r.Customer.Id,
        Nama = r.Customer.Name,
        Telepon = r.Customer.Phone ?? "",
        Email = r.Customer.Email ?? "",
        TotalBelanja = r.TotalSpent,
        JumlahTransaksi = r.OrderCount,
        Poin = r.Customer.LoyaltyPoints
    });

    private async Task ExportExcel()
    {
        var bytes = ExportService.ExportToExcel(ExportRows(), "Pelanggan");
        using var stream = new MemoryStream(bytes);
        await JS.InvokeVoidAsync("downloadFileFromStream", "Pelanggan.xlsx", new DotNetStreamReference(stream));
    }

    private async Task ExportCsv()
    {
        var bytes = ExportService.ExportToCsv(ExportRows());
        using var stream = new MemoryStream(bytes);
        await JS.InvokeVoidAsync("downloadFileFromStream", "Pelanggan.csv", new DotNetStreamReference(stream));
    }
}
