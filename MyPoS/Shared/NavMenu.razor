<MudNavMenu Class="pb-4">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Dasbor</MudNavLink>

    <AuthorizeView Roles="Admin,Operator">
        <MudNavLink Href="/pos" Icon="@Icons.Material.Filled.PointOfSale">Kasir</MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Manager">
        <MudNavGroup Title="Data Master" Icon="@Icons.Material.Filled.Inventory2" Expanded="true">
            <MudNavLink Href="/produk" Icon="@Icons.Material.Filled.Sell">Produk</MudNavLink>
            <MudNavLink Href="/kategori" Icon="@Icons.Material.Filled.Category">Kategori</MudNavLink>
            <MudNavLink Href="/pelanggan" Icon="@Icons.Material.Filled.People">Pelanggan</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Manager,Operator">
        <MudNavGroup Title="Laporan" Icon="@Icons.Material.Filled.Assessment" Expanded="true">
            <MudNavLink Href="/transaksi" Icon="@Icons.Material.Filled.ReceiptLong">Transaksi</MudNavLink>
            <AuthorizeView Roles="Admin,Manager" Context="reports">
                <MudNavLink Href="/laporan-penjualan" Icon="@Icons.Material.Filled.QueryStats">Laporan Penjualan</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <MudDivider Class="my-2" />
        <MudNavLink Href="/pengguna" Icon="@Icons.Material.Filled.ManageAccounts">Pengguna</MudNavLink>
        <MudNavLink Href="/pengaturan" Icon="@Icons.Material.Filled.Tune">Pengaturan</MudNavLink>
    </AuthorizeView>
</MudNavMenu>
