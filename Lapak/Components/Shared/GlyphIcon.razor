@* Line-art icon set for products, categories, and stores.

   The catalogue has no photography, so these stand in for it. They are drawn
   rather than borrowed from an emoji font: emoji render differently on every
   platform, carry their own colours, and never match a brand palette. These
   inherit `currentColor`, so a single CSS rule tints a whole grid. *@

<svg class="glyph" viewBox="0 0 24 24" width="@Size" height="@Size"
     fill="none" stroke="currentColor" stroke-width="1.5"
     stroke-linecap="round" stroke-linejoin="round"
     role="img" aria-hidden="@(string.IsNullOrEmpty(Label) ? "true" : "false")">
    @if (!string.IsNullOrEmpty(Label))
    {
        <title>@Label</title>
    }
    @Paths
</svg>

