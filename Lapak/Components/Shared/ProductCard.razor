@using Lapak.Models

@* The catalogue ships without photography, so each card weaves its own anyaman
   tile and draws a line-art glyph for its category. Hue comes from the category,
   which makes the grid read as a varied market stall rather than a wall of
   identical grey placeholders. *@

<div class="product-card" @onclick="OnClick" role="button" tabindex="0" @onkeydown="HandleKey">
    <div class="product-image" style="--weave-hue: @Hue;">
        @if (Product.DiscountPercentage > 0)
        {
            <span class="product-badge">−@(((int)Product.DiscountPercentage!.Value))%</span>
        }
        <span class="product-glyph">
            <GlyphIcon Name="@IconName" Size="2rem" />
        </span>
    </div>

    <div class="product-info">
        <div class="product-name" title="@Product.Name">@Product.Name</div>

        @if (Product.Store is not null)
        {
            <div class="product-store">
                <GlyphIcon Name="toko" Size="0.95rem" />
                <span class="product-store-name">@Product.Store.Name</span>
                @if (Product.Store.IsVerified)
                {
                    <span class="badge-verified" title="Toko terverifikasi">✓</span>
                }
            </div>
        }

        <div class="product-price-row">
            <span class="product-price">Rp@(Product.Price.ToString("N0"))</span>
            @if (Product.OriginalPrice > Product.Price)
            {
                <span class="product-original-price">Rp@(Product.OriginalPrice?.ToString("N0"))</span>
            }
        </div>

        <div class="product-stats">
            <span title="Rating">★ @Product.AverageRating.ToString("F1")</span>
            <span title="Terjual">@Product.SoldCount terjual</span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = null!;
    [Parameter] public EventCallback OnClick { get; set; }

    private string IconName => ProductIcons.For(Product.Category?.Name);
    private int Hue => ProductIcons.HueFor(Product.Category?.Name, Product.Slug);

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") await OnClick.InvokeAsync();
    }
}
