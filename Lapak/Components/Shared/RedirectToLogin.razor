@inject NavigationManager Nav

@* Sends an anonymous visitor to the login page and remembers where they were heading. *@

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/account/login?redirect={Uri.EscapeDataString(returnUrl)}", forceLoad: false);
    }
}
