@page "/promos"
@using Lapak.Models
@using Microsoft.EntityFrameworkCore
@inject Lapak.Data.LapakDbContext Db
@inject NavigationManager Nav

<PageTitle>Promo & voucher — Lapak</PageTitle>

<div class="page-header">
    <h1 class="page-title">Promo &amp; voucher</h1>
    <p class="page-subtitle">Semua potongan yang bisa kamu pakai hari ini, di satu halaman.</p>
</div>

<section class="section">
    <div class="section-header">
        <h2>Voucher</h2>
        <span class="text-muted text-sm">@_activeVouchers.Count aktif</span>
    </div>

    @if (!_activeVouchers.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">🎟️</div>
            <h3>Belum ada voucher aktif</h3>
            <p>Cek lagi nanti — voucher baru biasanya keluar tiap awal bulan.</p>
        </div>
    }
    else
    {
        <div class="voucher-grid">
            @foreach (var v in _activeVouchers)
            {
                var remaining = Math.Max(0, v.MaxUsage - v.CurrentUsage);
                var usedPct = v.MaxUsage > 0 ? v.CurrentUsage * 100.0 / v.MaxUsage : 0;
                <div class="voucher-card">
                    <div class="voucher-value">
                        @(v.Type switch
                        {
                            "Percentage" => $"{v.Value:0.#}%",
                            "Shipping" => "Gratis ongkir",
                            _ => $"Rp{v.Value:N0}"
                        })
                    </div>
                    <div class="voucher-body">
                        <h3>@v.Name</h3>
                        @if (!string.IsNullOrEmpty(v.Description))
                        {
                            <p class="text-sm text-muted">@v.Description</p>
                        }
                        <div class="mt-2"><span class="voucher-code">@v.Code</span></div>

                        <ul class="voucher-terms">
                            @if (v.MinPurchase.HasValue)
                            {
                                <li>Minimal belanja Rp@(v.MinPurchase.Value.ToString("N0"))</li>
                            }
                            @if (v.MaxDiscount.HasValue && v.Type == "Percentage")
                            {
                                <li>Potongan maksimal Rp@(v.MaxDiscount.Value.ToString("N0"))</li>
                            }
                            @if (!string.IsNullOrEmpty(v.TargetTier))
                            {
                                <li>Khusus member @v.TargetTier ke atas</li>
                            }
                            <li>Berlaku sampai @v.EndDate.ToString("d MMMM yyyy")</li>
                        </ul>

                        <div class="mt-2">
                            <div class="meter"><div class="meter-fill" style="width:@(usedPct.ToString("F0"))%; background:var(--gold);"></div></div>
                            <div class="text-xs text-muted mt-1">Sisa @remaining dari @v.MaxUsage kuota</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="section">
    <div class="section-header">
        <h2>Promo produk</h2>
        <span class="text-muted text-sm">@_activePromos.Count sedang jalan</span>
    </div>

    @if (!_activePromos.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">🏷️</div>
            <h3>Belum ada promo produk</h3>
            <p>Promo produk otomatis terpasang di harga — tidak perlu kode.</p>
            <a href="/products" class="btn btn-primary">Lihat produk</a>
        </div>
    }
    else
    {
        <div class="promo-grid">
            @foreach (var promo in _activePromos)
            {
                <a class="promo-card" href="/products/@promo.Product?.Slug">
                    <div class="promo-card-type @(promo.Type == "Cashback" ? "promo-fixed" : "promo-percent")">
                        @(promo.Type switch
                        {
                            "Discount" => $"Diskon {promo.Value:0.#}%",
                            "Cashback" => $"Cashback {promo.Value:0.#}%",
                            _ => promo.Name
                        })
                    </div>
                    <div class="promo-card-body">
                        <div class="promo-card-name">@promo.Product?.Name</div>
                        <div class="flex gap-1 items-baseline mt-1">
                            <span class="text-price">Rp@(promo.Product?.Price.ToString("N0"))</span>
                            @if (promo.Product?.OriginalPrice > promo.Product?.Price)
                            {
                                <span class="product-original-price">Rp@(promo.Product?.OriginalPrice?.ToString("N0"))</span>
                            }
                        </div>
                        <div class="promo-card-expire">Sampai @promo.EndDate.ToString("d MMM yyyy")</div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<section class="section">
    <div class="section-header"><h2>Tier &amp; loyalty points</h2></div>
    <div class="card">
        <div class="card-body">
            <p class="text-secondary">Setiap transaksi menambah poin. Makin tinggi tier, makin banyak yang kamu dapat.</p>
            <div class="tier-list mt-3">
                @foreach (var tier in Tiers)
                {
                    <div class="tier-row">
                        <span class="badge-tier @tier.Key.ToLower()">@tier.Key</span>
                        <span class="tier-range text-sm text-muted">@tier.Range</span>
                        <span class="tier-benefit text-sm">@tier.Benefit</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<div class="card">
    <div class="card-body">
        <h3>Cara pakai voucher</h3>
        <ol class="usage-steps">
            <li>Masukkan barang ke keranjang, lalu lanjut ke checkout.</li>
            <li>Di langkah pembayaran, ketik kode voucher dan tekan <strong>Pakai</strong>.</li>
            <li>Potongan langsung terlihat di ringkasan sebelum kamu membayar.</li>
        </ol>
        <p class="text-sm text-muted mt-2">
            Satu transaksi hanya bisa memakai satu voucher. Promo produk terpasang otomatis dan bisa digabung dengan voucher.
            Ada yang belum jelas? <a href="/chat/siti-bohay">Tanya Siti Bohay</a>.
        </p>
    </div>
</div>

<style>
    .voucher-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
    .voucher-card {
        display: flex;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }
    /* Perforated stub, like a torn market coupon */
    .voucher-value {
        flex: 0 0 96px;
        display: grid; place-items: center;
        padding: 16px 10px;
        text-align: center;
        background: var(--accent);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.1rem;
        line-height: 1.15;
        border-right: 2px dashed var(--bg-primary);
    }
    .voucher-body { padding: 16px; flex: 1; min-width: 0; }
    .voucher-terms { list-style: none; margin-top: 10px; font-size: 0.8rem; color: var(--text-secondary); }
    .voucher-terms li { padding-left: 14px; position: relative; margin-bottom: 3px; }
    .voucher-terms li::before { content: '·'; position: absolute; left: 4px; font-weight: 700; }

    .tier-list { display: flex; flex-direction: column; gap: 10px; }
    .tier-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .tier-range { min-width: 120px; }
    .tier-benefit { flex: 1; min-width: 220px; }

    .usage-steps { margin: 10px 0 0 20px; line-height: 1.9; }
</style>

@code {
    private record Tier(string Key, string Range, string Benefit);

    private static readonly Tier[] Tiers =
    {
        new("Bronze", "0 – 99 poin", "Akses semua promo reguler."),
        new("Silver", "100 – 499 poin", "Poin +5% dan voucher khusus member."),
        new("Gold", "500 – 999 poin", "Poin +10%, gratis ongkir 2× sebulan, prioritas bantuan."),
        new("Platinum", "1000+ poin", "Poin +20%, gratis ongkir tanpa batas, akun manager khusus.")
    };

    private List<ProductPromo> _activePromos = new();
    private List<Voucher> _activeVouchers = new();

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;

        _activePromos = await Db.ProductPromos.AsNoTracking()
            .Include(p => p.Product)
            .Where(p => p.IsActive && p.StartDate <= now && p.EndDate >= now)
            .OrderBy(p => p.EndDate)
            .Take(12)
            .ToListAsync();

        _activeVouchers = await Db.Vouchers.AsNoTracking()
            .Where(v => v.IsActive && v.StartDate <= now && v.EndDate >= now && v.CurrentUsage < v.MaxUsage)
            .OrderBy(v => v.EndDate)
            .Take(12)
            .ToListAsync();
    }
}
