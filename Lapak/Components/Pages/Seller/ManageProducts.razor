@page "/seller/manage-products"
@page "/seller/manage-products/{ProductId}"
@using Lapak.Models
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "SellerOnly")]
@inject Lapak.Data.LapakDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Kelola produk — Lapak</PageTitle>

@if (_store == null)
{
    <div class="empty-state">
        <div class="empty-state-icon">🏪</div>
        <h3>Kamu belum punya toko</h3>
        <p>Daftarkan tokomu dulu, lalu produk bisa langsung ditambahkan.</p>
        <a href="/seller/register-store" class="btn btn-primary">Daftarkan toko</a>
    </div>
}
else if (_mode == Mode.List)
{
    <div class="page-header flex justify-between items-center flex-wrap gap-2">
        <div>
            <h1 class="page-title">Kelola produk</h1>
            <p class="page-subtitle">@_products.Count produk di @_store.Name</p>
        </div>
        <a href="/seller/manage-products/new" class="btn btn-primary">Tambah produk</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert success mb-2">@_message</div>
    }

    @if (!_products.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">📦</div>
            <h3>Belum ada produk</h3>
            <p>Tambahkan produk pertamamu — pembeli baru bisa menemukanmu setelah ada barang yang tayang.</p>
            <a href="/seller/manage-products/new" class="btn btn-primary">Tambah produk pertama</a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Produk</th>
                            <th style="text-align:right;">Harga</th>
                            <th style="text-align:right;">Stok</th>
                            <th style="text-align:right;">Terjual</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _products)
                        {
                            <tr>
                                <td>
                                    <strong>@p.Name</strong>
                                    <div class="text-xs text-muted">@p.Category?.Name</div>
                                </td>
                                <td style="text-align:right;">Rp@(p.Price.ToString("N0"))</td>
                                <td style="text-align:right;">@p.Stock</td>
                                <td style="text-align:right;">@p.SoldCount</td>
                                <td>
                                    <span class="badge-status" style="color:@(p.IsActive ? "var(--success)" : "var(--text-muted)"); border-color:@(p.IsActive ? "var(--success)" : "var(--border-strong)");">
                                        @(p.IsActive ? "Tayang" : "Disembunyikan")
                                    </span>
                                </td>
                                <td>
                                    <div class="flex gap-1">
                                        <a href="/seller/manage-products/@p.Id" class="btn btn-sm btn-secondary">Edit</a>
                                        <button class="btn btn-sm btn-danger" @onclick="() => ToggleActive(p)">
                                            @(p.IsActive ? "Sembunyikan" : "Tayangkan")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <nav class="breadcrumb mb-2">
        <a href="/seller/manage-products">← Kelola produk</a>
    </nav>

    <div class="page-header">
        <h1 class="page-title">@(_mode == Mode.Edit ? "Edit produk" : "Tambah produk")</h1>
        <p class="page-subtitle">Produk akan tayang di @_store.Name</p>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert error mb-2">@_error</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <label class="form-label" for="p-name">Nama produk <span class="text-danger">*</span></label>
                    <input id="p-name" class="form-input" @bind="_fName" placeholder="Contoh: Kopi Gayo Arabica 250g" />
                </div>
                <div class="col-4">
                    <label class="form-label" for="p-slug">Slug URL</label>
                    <input id="p-slug" class="form-input" @bind="_fSlug" placeholder="dibuat otomatis" />
                    <div class="form-hint">Kosongkan untuk membuat otomatis dari nama.</div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-6">
                    <label class="form-label" for="p-short">Deskripsi singkat</label>
                    <input id="p-short" class="form-input" @bind="_fShort" placeholder="Satu kalimat yang muncul di daftar" />
                </div>
                <div class="col-6">
                    <label class="form-label" for="p-cat">Kategori <span class="text-danger">*</span></label>
                    <select id="p-cat" class="form-input" @bind="_fCatId">
                        <option value="@Guid.Empty">Pilih kategori</option>
                        @foreach (var c in _cats)
                        {
                            <optgroup label="@c.Name">
                                <option value="@c.Id">@c.Name (umum)</option>
                                @foreach (var sc in c.SubCategories)
                                {
                                    <option value="@sc.Id">@sc.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
            </div>

            <div class="mt-2">
                <label class="form-label" for="p-desc">Deskripsi lengkap</label>
                <textarea id="p-desc" class="form-input" @bind="_fDesc" rows="4" placeholder="Bahan, ukuran, isi paket, catatan pengiriman"></textarea>
            </div>

            <div class="row mt-2">
                <div class="col-3">
                    <label class="form-label" for="p-price">Harga jual <span class="text-danger">*</span></label>
                    <input id="p-price" class="form-input" type="number" min="0" @bind="_fPrice" />
                </div>
                <div class="col-3">
                    <label class="form-label" for="p-orig">Harga coret</label>
                    <input id="p-orig" class="form-input" type="number" min="0" @bind="_fOrig" />
                    <div class="form-hint">Isi jika sedang diskon.</div>
                </div>
                <div class="col-3">
                    <label class="form-label" for="p-stock">Stok <span class="text-danger">*</span></label>
                    <input id="p-stock" class="form-input" type="number" min="0" @bind="_fStock" />
                </div>
                <div class="col-3">
                    <label class="form-label" for="p-weight">Berat (gram)</label>
                    <input id="p-weight" class="form-input" type="number" min="0" @bind="_fWeight" />
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-4">
                    <label class="form-label" for="p-min">Minimal pembelian</label>
                    <input id="p-min" class="form-input" type="number" min="1" @bind="_fMin" />
                </div>
                <div class="col-4">
                    <label class="form-label" for="p-max">Maksimal per pesanan</label>
                    <input id="p-max" class="form-input" type="number" min="1" @bind="_fMax" />
                </div>
                <div class="col-4">
                    <label class="form-label" for="p-active">Tampilkan di toko</label>
                    <select id="p-active" class="form-input" @bind="_fActive">
                        <option value="true">Ya, tayangkan</option>
                        <option value="false">Simpan sebagai draf</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-1 mt-3">
                <button class="btn btn-primary btn-lg" @onclick="SaveProduct" disabled="@_saving">
                    @(_saving ? "Menyimpan…" : "Simpan produk")
                </button>
                <a href="/seller/manage-products" class="btn btn-secondary btn-lg">Batal</a>
            </div>
        </div>
    </div>
}

@code {
    private enum Mode { List, Create, Edit }

    /// <summary>
    /// Null on the list route, "new" on the create route, otherwise the product id.
    /// It is deliberately a single string parameter: with separate routes that both
    /// left the parameter null, Blazor saw no parameter change on navigation and
    /// never re-ran OnParametersSetAsync, so the page kept showing the old screen.
    /// </summary>
    [Parameter] public string? ProductId { get; set; }

    private Mode _mode = Mode.List;
    private Guid? _editingId;
    private Lapak.Models.Store? _store;
    private List<Product> _products = new();
    private List<Category> _cats = new();
    private string _message = "", _error = "";
    private bool _saving;
    private Guid _userId;

    private string _fName = "", _fSlug = "", _fShort = "", _fDesc = "";
    private Guid _fCatId = Guid.Empty;
    private decimal _fPrice, _fOrig;
    private int _fStock = 10, _fWeight = 1000, _fMin = 1, _fMax = 10;
    private bool _fActive = true;

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(uid, out _userId)) return;

        _store = await Db.Stores.FirstOrDefaultAsync(s => s.UserId == _userId);
        if (_store == null) return;

        _cats = await Db.Categories
            .Where(c => c.ParentCategoryId == null && c.IsActive)
            .Include(c => c.SubCategories)
            .OrderBy(c => c.SortOrder)
            .ToListAsync();

        _error = "";

        if (string.Equals(ProductId, "new", StringComparison.OrdinalIgnoreCase))
        {
            _mode = Mode.Create;
            _editingId = null;
            ResetForm();
        }
        else if (Guid.TryParse(ProductId, out var id))
        {
            _mode = Mode.Edit;
            _editingId = id;
            await LoadForEdit(id);
        }
        else
        {
            _mode = Mode.List;
            _editingId = null;
            await LoadListAsync();
        }
    }

    private async Task LoadListAsync()
    {
        _products = await Db.Products
            .Where(p => p.StoreId == _store!.Id)
            .Include(p => p.Category)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();
    }

    private async Task LoadForEdit(Guid id)
    {
        var p = await Db.Products.FirstOrDefaultAsync(x => x.Id == id && x.StoreId == _store!.Id);
        if (p == null)
        {
            _error = "Produk tidak ditemukan di tokomu.";
            return;
        }

        _fName = p.Name;
        _fSlug = p.Slug;
        _fShort = p.ShortDescription ?? "";
        _fDesc = p.Description ?? "";
        _fCatId = p.CategoryId;
        _fPrice = p.Price;
        _fOrig = p.OriginalPrice ?? 0;
        _fStock = p.Stock;
        _fWeight = (int)p.WeightInGrams;
        _fMin = p.MinOrder;
        _fMax = p.MaxOrder;
        _fActive = p.IsActive;
    }

    private void ResetForm()
    {
        _fName = _fSlug = _fShort = _fDesc = "";
        _fCatId = Guid.Empty;
        _fPrice = _fOrig = 0;
        _fStock = 10;
        _fWeight = 1000;
        _fMin = 1;
        _fMax = 10;
        _fActive = true;
        _error = "";
    }

    private async Task SaveProduct()
    {
        _error = "";
        if (_store == null) { _error = "Toko tidak ditemukan."; return; }
        if (string.IsNullOrWhiteSpace(_fName)) { _error = "Nama produk harus diisi."; return; }
        if (_fCatId == Guid.Empty) { _error = "Pilih kategori produknya dulu."; return; }
        if (_fPrice <= 0) { _error = "Harga jual harus lebih dari nol."; return; }
        if (_fStock < 0) { _error = "Stok tidak boleh negatif."; return; }
        if (_fMax < _fMin) { _error = "Maksimal pembelian tidak boleh lebih kecil dari minimal."; return; }

        _saving = true;
        try
        {
            var slug = Slugify(string.IsNullOrWhiteSpace(_fSlug) ? _fName : _fSlug);
            var discount = _fOrig > _fPrice ? (int)Math.Round((1 - _fPrice / _fOrig) * 100) : 0;

            if (_mode == Mode.Edit && _editingId is { } id)
            {
                var p = await Db.Products.FirstOrDefaultAsync(x => x.Id == id && x.StoreId == _store.Id);
                if (p == null) { _error = "Produk tidak ditemukan di tokomu."; return; }

                if (await Db.Products.AnyAsync(x => x.Slug == slug && x.Id != p.Id))
                {
                    _error = $"Slug \"{slug}\" sudah dipakai produk lain. Ganti slug atau nama produknya.";
                    return;
                }

                Apply(p, slug, discount);
                p.UpdatedAt = DateTime.UtcNow;
                await Db.SaveChangesAsync();
                _message = "Produk berhasil diperbarui.";
            }
            else
            {
                if (await Db.Products.AnyAsync(x => x.Slug == slug))
                {
                    _error = $"Slug \"{slug}\" sudah dipakai. Ganti slug atau nama produknya.";
                    return;
                }

                var p = new Product { StoreId = _store.Id };
                Apply(p, slug, discount);
                Db.Products.Add(p);

                _store.TotalProducts = await Db.Products.CountAsync(x => x.StoreId == _store.Id) + 1;
                await Db.SaveChangesAsync();
                _message = "Produk berhasil ditambahkan.";
            }

            Nav.NavigateTo("/seller/manage-products");
        }
        catch (Exception ex)
        {
            _error = "Gagal menyimpan produk: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Apply(Product p, string slug, int discount)
    {
        p.Name = _fName.Trim();
        p.Slug = slug;
        p.ShortDescription = _fShort;
        p.Description = _fDesc;
        p.CategoryId = _fCatId;
        p.Price = _fPrice;
        p.OriginalPrice = _fOrig > 0 ? _fOrig : null;
        p.DiscountPercentage = discount > 0 ? discount : null;
        p.Stock = _fStock;
        p.MinOrder = _fMin;
        p.MaxOrder = _fMax;
        p.WeightInGrams = _fWeight;
        p.IsActive = _fActive;
        p.StockStatus = _fStock > 10 ? "Available" : (_fStock > 0 ? "LowStock" : "OutOfStock");
    }

    private async Task ToggleActive(Product p)
    {
        p.IsActive = !p.IsActive;
        p.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _message = p.IsActive ? $"\"{p.Name}\" kembali tayang." : $"\"{p.Name}\" disembunyikan dari toko.";
    }

    private static string Slugify(string value)
    {
        var slug = new string(value.ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-')
            .ToArray());

        while (slug.Contains("--")) slug = slug.Replace("--", "-");
        return slug.Trim('-');
    }
}
