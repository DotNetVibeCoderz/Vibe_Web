@page "/dashboard"
@using Lapak.Models
@using Lapak.Services
@using Lapak.Data
@inject LapakDbContext Db
@inject ICustomerScoringService ScoringService

@* 📊 Dashboard & Reporting Page *@

<div class="page-header">
    <h1 class="page-title">📊 Dashboard</h1>
    <p class="page-subtitle">Analitik bisnis real-time dengan data penjualan, pelanggan, dan performa platform</p>
</div>

@* Stats Cards *@
<div class="row mb-3">
    <div class="col-3">
        <div class="stat-card">
            <div class="stat-icon green">💰</div>
            <div>
                <div class="stat-value">Rp@(_totalRevenue.ToString("N0"))</div>
                <div class="stat-label">Total Pendapatan</div>
            </div>
        </div>
    </div>
    <div class="col-3">
        <div class="stat-card">
            <div class="stat-icon purple">📦</div>
            <div>
                <div class="stat-value">@_totalOrders.ToString("N0")</div>
                <div class="stat-label">Total Pesanan</div>
            </div>
        </div>
    </div>
    <div class="col-3">
        <div class="stat-card">
            <div class="stat-icon blue">👥</div>
            <div>
                <div class="stat-value">@_totalCustomers.ToString("N0")</div>
                <div class="stat-label">Pelanggan</div>
            </div>
        </div>
    </div>
    <div class="col-3">
        <div class="stat-card">
            <div class="stat-icon orange">⭐</div>
            <div>
                <div class="stat-value">@_avgRating.ToString("F1")</div>
                <div class="stat-label">Rata-rata Rating</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    @* Charts - Sales Overview *@
    <div class="col-8">
        <div class="chart-container">
            <h4 class="chart-title">📈 Ikhtisar Penjualan (30 Hari Terakhir)</h4>
            <div style="height: 300px; display: flex; align-items: flex-end; gap: 8px; padding: 20px;">
                @{
                    var maxValue = _salesData.Count > 0 ? _salesData.Max() : 1;
                }
                @for (int i = 0; i < _salesData.Count; i++)
                {
                    var height = maxValue > 0 ? (_salesData[i] / (double)maxValue * 250) : 0;
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                        <span style="font-size: 0.7rem; color: var(--text-muted);">@_salesData[i]</span>
                        <div style="width: 100%; height: @(height)px; background: var(--accent); border-radius: var(--radius-sm) var(--radius-sm) 0 0; transition: height 0.3s ease; min-height: 4px;"></div>
                        <span style="font-size: 0.65rem; color: var(--text-muted);">Day @(i+1)</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Customer Tier Distribution *@
    <div class="col-4">
        <div class="chart-container">
            <h4 class="chart-title">🏅 Segmentasi Pelanggan</h4>
            <div style="padding: 20px;">
                @foreach (var tier in _tierDistribution)
                {
                    var percentage = _totalCustomers > 0 ? (double)tier.Value / _totalCustomers * 100 : 0;
                    var color = tier.Key switch
                    {
                        "Platinum" => "#b8b8ff",
                        "Gold" => "#ffd700",
                        "Silver" => "#c0c0c0",
                        _ => "#cd7f32"
                    };
                    <div style="margin-bottom: 16px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                            <span>@tier.Key</span>
                            <span>@tier.Value (@percentage.ToString("F1")%)</span>
                        </div>
                        <div style="height: 8px; background: var(--bg-tertiary); border-radius: var(--radius-full); overflow: hidden;">
                            <div style="height: 100%; width: @(percentage)%; background: @color; border-radius: var(--radius-full); transition: width 0.5s ease;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Recent Orders Table *@
<div class="mt-3">
    <div class="card">
        <div class="card-header flex justify-between items-center">
            <span>📋 Pesanan Terbaru</span>
            <span class="text-muted" style="font-size: 0.8rem;">Realtime dengan SignalR</span>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: var(--bg-tertiary);">
                        <th style="padding: 12px 16px; text-align: left;">No. Pesanan</th>
                        <th style="padding: 12px 16px; text-align: left;">Pelanggan</th>
                        <th style="padding: 12px 16px; text-align: left;">Toko</th>
                        <th style="padding: 12px 16px; text-align: right;">Total</th>
                        <th style="padding: 12px 16px; text-align: center;">Status</th>
                        <th style="padding: 12px 16px; text-align: left;">Tanggal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in _recentOrders)
                    {
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 12px 16px;">@order.OrderNumber</td>
                            <td style="padding: 12px 16px;">@order.User?.FullName</td>
                            <td style="padding: 12px 16px;">@order.Store?.Name</td>
                            <td style="padding: 12px 16px; text-align: right;">Rp@(order.GrandTotal.ToString("N0"))</td>
                            <td style="padding: 12px 16px; text-align: center;">
                                <span style="padding: 4px 10px; border-radius: var(--radius-full); font-size: 0.8rem;
                                    background: @GetStatusColor(order.Status); color: white;">
                                    @order.Status
                                </span>
                            </td>
                            <td style="padding: 12px 16px; font-size: 0.85rem;">@order.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Filter Section *@
<div class="card mt-3">
    <div class="card-body">
        <h4>Filter Lanjutan</h4>
        <div class="row mt-2">
            <div class="col-3">
                <label class="form-label">Tanggal Mulai</label>
                <input type="date" class="form-input" @bind="_filterStartDate" />
            </div>
            <div class="col-3">
                <label class="form-label">Tanggal Akhir</label>
                <input type="date" class="form-input" @bind="_filterEndDate" />
            </div>
            <div class="col-3">
                <label class="form-label">Tier Pelanggan</label>
                <select class="form-input" @bind="_filterTier">
                    <option value="">Semua Tier</option>
                    <option value="Bronze">Bronze</option>
                    <option value="Silver">Silver</option>
                    <option value="Gold">Gold</option>
                    <option value="Platinum">Platinum</option>
                </select>
            </div>
            <div class="col-3" style="display: flex; align-items: flex-end; gap: 8px;">
                <button class="btn btn-primary" @onclick="ApplyAdvancedFilter">🔍 Terapkan Filter</button>
                <button class="btn btn-secondary" @onclick="ExportReport">📥 Export</button>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal _totalRevenue = 0;
    private int _totalOrders = 0;
    private int _totalCustomers = 0;
    private double _avgRating = 0;
    private List<int> _salesData = new();
    private List<Order> _recentOrders = new();
    private Dictionary<string, int> _tierDistribution = new();

    // Advanced filters - use DateTime? for proper binding
    private DateTime? _filterStartDate = null;
    private DateTime? _filterEndDate = null;
    private string _filterTier = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        _totalRevenue = Db.Orders.Where(o => o.Status == "Completed").Sum(o => o.GrandTotal);
        _totalOrders = Db.Orders.Count();
        _totalCustomers = Db.Users.Count(u => u.IsActive);
        _avgRating = Db.Products.Average(p => (double?)p.AverageRating) ?? 0;

        _recentOrders = Db.Orders
            .OrderByDescending(o => o.CreatedAt)
            .Take(10)
            .ToList();

        var random = new Random();
        _salesData = Enumerable.Range(0, 30)
            .Select(_ => random.Next(5, 50))
            .ToList();

        _tierDistribution = await ScoringService.GetTierDistributionAsync();
    }

    private string GetStatusColor(string status) => status switch
    {
        "Completed" => "var(--success)",
        "Paid" => "var(--info)",
        "Processing" => "var(--warning)",
        "Shipped" => "var(--accent)",
        "Cancelled" => "var(--danger)",
        _ => "var(--text-muted)"
    };

    private async Task ApplyAdvancedFilter()
    {
        await LoadDashboardData();
    }

    private async Task ExportReport()
    {
        await Task.CompletedTask;
    }
}
