@page "/chat/tony-kurus"
@using Microsoft.AspNetCore.Components.Forms
@using Lapak.Services.SemanticKernel
@using Lapak.Services.Storage
@using Lapak.Models.Configurations
@using Microsoft.Extensions.Options
@inject ISkChatService SkChatService
@inject IOptions<AiConfig> AiConfig
@inject StorageServiceFactory StorageFactory
@inject IJSRuntime JS

<PageTitle>Tony Kurus — asisten belanja Lapak</PageTitle>

<div class="page-header">
    <h1 class="page-title">Tony Kurus</h1>
    <p class="page-subtitle">Asisten belanja yang membaca katalog Lapak langsung — produk, toko, promo, dan harga terkini.</p>
</div>

<div class="chat-container">
    <div class="chat-header">
        <div class="chat-avatar weave-tile" style="--weave-hue: 212;" aria-hidden="true">🤖</div>
        <div class="flex-1">
            <div class="chat-bot-name">Tony Kurus</div>
            <div class="chat-bot-status">
                @if (_isThinking)
                {
                    <span>Sedang mencari di katalog…</span>
                }
                else
                {
                    <span class="text-success">● Online</span>
                    <span>· @_messages.Count pesan</span>
                }
            </div>
        </div>
        @if (_messages.Any())
        {
            <button class="btn btn-sm btn-ghost" @onclick="ClearChat">Mulai baru</button>
        }
    </div>

    <div class="chat-messages" id="tony-messages">
        <div class="chat-message bot">
            <div class="chat-message-bubble">
                <strong>Halo! Aku Tony Kurus 👋</strong><br />
                Sebutkan barang yang kamu cari — aku carikan langsung dari katalog Lapak, lengkap dengan harga,
                rating, dan tokonya. Bisa juga tanya promo yang sedang jalan, atau kirim foto barang yang mirip.
            </div>
        </div>

        @foreach (var msg in _messages)
        {
            <div class="chat-message @(msg.IsUser ? "user" : "bot")">
                <div class="chat-message-bubble">
                    @if (msg.HasImage)
                    {
                        <a href="@msg.ImageUrl" target="_blank" rel="noopener">
                            <img src="@msg.ImageUrl" class="chat-image" alt="Gambar yang diunggah" />
                        </a>
                    }
                    @((MarkupString)msg.Content)
                </div>
                <span class="chat-message-time">@msg.Timestamp.ToString("HH:mm")</span>
            </div>
        }

        @if (_isThinking)
        {
            <div class="chat-message bot">
                <div class="chat-message-bubble">
                    <div class="typing-indicator">
                        <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="chat-input-area">
        <InputFile OnChange="HandleFileUpload" accept="image/*" id="tony-file" class="visually-hidden-file" />
        <label for="tony-file" class="chat-upload-btn" title="Kirim gambar">📎</label>

        <textarea class="chat-input" @bind="_currentInput" @bind:event="oninput" @onkeydown="HandleKeyDown"
                  placeholder="Contoh: cari headphone di bawah 500 ribu" rows="1" disabled="@_isThinking"
                  aria-label="Tulis pesan untuk Tony Kurus"></textarea>

        <button class="chat-send-btn" @onclick="SendMessage"
                disabled="@(string.IsNullOrWhiteSpace(_currentInput) || _isThinking)" aria-label="Kirim pesan">➤</button>
    </div>

    <div class="chat-quickbar">
        <span class="chat-quick-label">Coba</span>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Rekomendasikan produk terlaris minggu ini")'>Produk terlaris</button>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Promo dan voucher apa yang sedang aktif?")'>Promo aktif</button>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Cari elektronik di bawah 1 juta")'>Elektronik &lt; 1jt</button>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Toko mana yang ratingnya paling bagus?")'>Toko terbaik</button>
    </div>
</div>

@if (!_aiConfigured)
{
    <div class="alert warning mt-3">
        Belum ada API key AI yang terpasang di server, jadi Tony belum bisa menjawab.
        Isi <code>AI:Providers</code> di <code>appsettings.json</code> untuk mengaktifkannya.
    </div>
}

<style>
    .chat-image { max-width: 220px; border-radius: var(--radius-md); margin-bottom: 8px; display: block; }
    .visually-hidden-file { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
</style>

@code {
    private class ChatMsg
    {
        public bool IsUser { get; set; }
        public string Content { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public bool HasImage { get; set; }
        public string? ImageUrl { get; set; }
    }

    private readonly List<ChatMsg> _messages = new();
    private string _currentInput = string.Empty;
    private bool _isThinking;
    private string? _pendingAttachmentUrl;
    private bool _aiConfigured;
    private int _renderedCount;

    protected override void OnInitialized() =>
        _aiConfigured = AiConfig.Value.Providers.Values.Any(p => !string.IsNullOrWhiteSpace(p.ApiKey));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keep the newest message in view without yanking the scroll on every keystroke.
        if (_messages.Count == _renderedCount && !firstRender) return;
        _renderedCount = _messages.Count;
        try { await JS.InvokeVoidAsync("lapak.scrollToBottom", "tony-messages"); }
        catch (JSException) { /* prerender */ }
    }

    private async Task Ask(string prompt)
    {
        _currentInput = prompt;
        await SendMessage();
    }

    private void ClearChat()
    {
        _messages.Clear();
        _pendingAttachmentUrl = null;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_currentInput) || _isThinking) return;

        var userMessage = _currentInput.Trim();
        _currentInput = string.Empty;

        var outgoing = new ChatMsg { IsUser = true, Content = FormatMessage(userMessage) };
        if (_pendingAttachmentUrl != null)
        {
            outgoing.HasImage = true;
            outgoing.ImageUrl = _pendingAttachmentUrl;
        }
        _messages.Add(outgoing);

        _isThinking = true;
        StateHasChanged();

        try
        {
            var history = _messages
                .SkipLast(1)
                .TakeLast(10)
                .Select(m => new Microsoft.SemanticKernel.ChatMessageContent(
                    m.IsUser ? AuthorRole.User : AuthorRole.Assistant, StripHtml(m.Content)))
                .ToList();

            var reply = new ChatMsg { IsUser = false };
            _messages.Add(reply);

            var builder = new System.Text.StringBuilder();
            await foreach (var token in SkChatService.ChatStreamAsync("TonyKurus", userMessage, history, _pendingAttachmentUrl))
            {
                builder.Append(token);
                reply.Content = FormatMessage(builder.ToString());
                StateHasChanged();
            }

            if (builder.Length == 0)
                reply.Content = "Maaf, aku belum bisa menjawab sekarang. Coba lagi sebentar lagi ya.";
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMsg
            {
                IsUser = false,
                Content = FormatMessage("Ada kendala teknis: " + ex.Message + ". Coba lagi sebentar lagi ya.")
            });
        }
        finally
        {
            _isThinking = false;
            _pendingAttachmentUrl = null;
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            if (!file.ContentType.StartsWith("image/"))
            {
                _messages.Add(new ChatMsg { IsUser = false, Content = "File itu bukan gambar. Kirim foto produknya ya." });
                return;
            }

            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            var storage = StorageFactory.GetStorageService();
            var storedName = await storage.UploadAsync(file.Name, ms, file.ContentType);
            _pendingAttachmentUrl = await storage.GetPublicUrlAsync(storedName);

            _messages.Add(new ChatMsg
            {
                IsUser = false,
                Content = $"Gambar <strong>{System.Net.WebUtility.HtmlEncode(file.Name)}</strong> siap dikirim. Tulis pertanyaanmu soal gambar ini.",
                HasImage = true,
                ImageUrl = _pendingAttachmentUrl
            });
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMsg { IsUser = false, Content = "Gagal mengunggah gambar: " + System.Net.WebUtility.HtmlEncode(ex.Message) });
        }
    }

    /// <summary>Escapes first, then re-adds the small subset of formatting we allow.</summary>
    private static string FormatMessage(string message)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(message);
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        return encoded.Replace("\n", "<br/>");
    }

    private static string StripHtml(string html) =>
        System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", " "));

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendMessage();
    }
}
