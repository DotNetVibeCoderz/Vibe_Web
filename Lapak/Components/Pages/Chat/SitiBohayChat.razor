@page "/chat/siti-bohay"
@using Microsoft.AspNetCore.Components.Forms
@using Lapak.Services.SemanticKernel
@using Lapak.Services.Rag
@using Lapak.Services.Storage
@using Lapak.Models.Configurations
@using Microsoft.Extensions.Options
@inject ISkChatService SkChatService
@inject IVectorRagService RagService
@inject IOptions<AiConfig> AiConfig
@inject StorageServiceFactory StorageFactory
@inject IJSRuntime JS

<PageTitle>Siti Bohay — bantuan pelanggan Lapak</PageTitle>

<div class="page-header">
    <h1 class="page-title">Siti Bohay</h1>
    <p class="page-subtitle">Bantuan pelanggan yang menjawab dari dokumen kebijakan resmi Lapak — retur, refund, pengiriman, pembayaran.</p>
</div>

<div class="chat-container">
    <div class="chat-header">
        <div class="chat-avatar weave-tile" style="--weave-hue: 336;" aria-hidden="true">💁</div>
        <div class="flex-1">
            <div class="chat-bot-name">Siti Bohay</div>
            <div class="chat-bot-status">
                @if (_isThinking)
                {
                    <span>Mencari di dokumen kebijakan…</span>
                }
                else
                {
                    <span class="text-success">● Online</span>
                    <span>· @_indexedChunks bagian dokumen terindeks</span>
                }
            </div>
        </div>
        <div class="flex gap-1 flex-wrap">
            <button class="btn btn-sm btn-secondary" @onclick="ReindexDocs" disabled="@_reindexing">
                @(_reindexing ? "Mengindeks…" : "Indeks ulang")
            </button>
            <a href="https://wa.me/6281234567890" target="_blank" rel="noopener" class="btn btn-sm btn-success">WhatsApp</a>
        </div>
    </div>

    <div class="chat-messages" id="siti-messages">
        <div class="chat-message bot">
            <div class="chat-message-bubble">
                <strong>Halo, aku Siti Bohay 👋</strong><br />
                Aku bantu soal retur, refund, status pesanan, pembayaran, dan aturan platform. Jawabanku diambil
                dari dokumen kebijakan resmi Lapak, jadi kamu bisa cek sumbernya. Kalau ada masalah yang perlu
                orang, aku sambungkan ke WhatsApp atau email tim support.
            </div>
        </div>

        @foreach (var msg in _messages)
        {
            <div class="chat-message @(msg.IsUser ? "user" : "bot")">
                <div class="chat-message-bubble">
                    @if (msg.HasImage)
                    {
                        <a href="@msg.ImageUrl" target="_blank" rel="noopener">
                            <img src="@msg.ImageUrl" class="chat-image" alt="Lampiran yang diunggah" />
                        </a>
                    }

                    @if (!msg.IsUser && !string.IsNullOrEmpty(msg.RagInfo))
                    {
                        <details class="rag-source">
                            <summary>Sumber dari dokumen kebijakan</summary>
                            <pre>@msg.RagInfo</pre>
                        </details>
                    }

                    @((MarkupString)msg.Content)

                    @if (msg.HasHandover)
                    {
                        <div class="handover">
                            <strong>Butuh bantuan orang?</strong><br />
                            Email <a href="mailto:support@lapak.com">support@lapak.com</a><br />
                            WhatsApp <a href="https://wa.me/6281234567890" target="_blank" rel="noopener">+62 812-3456-7890</a>
                        </div>
                    }
                </div>
                <span class="chat-message-time">@msg.Timestamp.ToString("HH:mm")</span>
            </div>
        }

        @if (_isThinking)
        {
            <div class="chat-message bot">
                <div class="chat-message-bubble">
                    <div class="typing-indicator">
                        <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="chat-input-area">
        <InputFile OnChange="HandleFileUpload" accept="image/*,.pdf,.doc,.docx" id="siti-file" class="visually-hidden-file" />
        <label for="siti-file" class="chat-upload-btn" title="Kirim screenshot atau dokumen">📎</label>

        <textarea class="chat-input" @bind="_currentInput" @bind:event="oninput" @onkeydown="HandleKeyDown"
                  placeholder="Ceritakan masalahmu, atau kirim screenshot" rows="1" disabled="@_isThinking"
                  aria-label="Tulis pesan untuk Siti Bohay"></textarea>

        <button class="chat-send-btn" @onclick="SendMessage"
                disabled="@(string.IsNullOrWhiteSpace(_currentInput) || _isThinking)" aria-label="Kirim pesan">➤</button>
    </div>

    <div class="chat-quickbar">
        <span class="chat-quick-label">Sering ditanya</span>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Bagaimana cara melacak pesanan saya?")'>Lacak pesanan</button>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Bagaimana cara retur barang?")'>Cara retur</button>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Berapa lama proses refund?")'>Lama refund</button>
        <button class="btn btn-sm btn-secondary" @onclick='() => Ask("Bagaimana cara menghubungi penjual?")'>Hubungi penjual</button>
    </div>
</div>

@if (_indexedChunks == 0)
{
    <div class="alert warning mt-3">
        Belum ada dokumen kebijakan yang terindeks. Taruh berkas <code>.txt</code> atau <code>.md</code>
        di folder <code>Documents/</code>, lalu tekan “Indeks ulang”.
    </div>
}

<style>
    .chat-image { max-width: 220px; border-radius: var(--radius-md); margin-bottom: 8px; display: block; }
    .visually-hidden-file { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

    .rag-source { margin-bottom: 8px; font-size: 0.8rem; }
    .rag-source summary { color: var(--gold-hover); cursor: pointer; font-weight: 600; }
    .rag-source pre {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        padding: 10px;
        border-radius: var(--radius-sm);
        white-space: pre-wrap;
        font-size: 0.74rem;
        margin-top: 6px;
        max-height: 200px;
        overflow-y: auto;
    }

    .handover {
        margin-top: 10px;
        padding: 10px 12px;
        background: var(--bg-primary);
        border: 1px dashed var(--border-strong);
        border-radius: var(--radius-md);
        font-size: 0.85rem;
    }
</style>

@code {
    private class ChatMsg
    {
        public bool IsUser { get; set; }
        public string Content { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string RagInfo { get; set; } = string.Empty;
        public bool HasImage { get; set; }
        public string? ImageUrl { get; set; }
        public bool HasHandover { get; set; }
    }

    private readonly List<ChatMsg> _messages = new();
    private string _currentInput = string.Empty;
    private bool _isThinking, _reindexing;
    private string? _pendingAttachmentUrl;
    private int _indexedChunks;
    private int _renderedCount;

    // The background indexer already builds the index at startup, so the page only
    // reads the count here instead of re-indexing on every visit.
    protected override void OnInitialized() => _indexedChunks = RagService.GetChunkCount();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_messages.Count == _renderedCount && !firstRender) return;
        _renderedCount = _messages.Count;
        try { await JS.InvokeVoidAsync("lapak.scrollToBottom", "siti-messages"); }
        catch (JSException) { /* prerender */ }
    }

    private async Task ReindexDocs()
    {
        _reindexing = true;
        try
        {
            await RagService.IndexDocumentsAsync();
            _indexedChunks = RagService.GetChunkCount();
            _messages.Add(new ChatMsg
            {
                IsUser = false,
                Content = $"Indeks diperbarui — {_indexedChunks} bagian dokumen siap dicari."
            });
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMsg { IsUser = false, Content = "Indeks ulang gagal: " + System.Net.WebUtility.HtmlEncode(ex.Message) });
        }
        finally
        {
            _reindexing = false;
        }
    }

    private async Task Ask(string prompt)
    {
        _currentInput = prompt;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_currentInput) || _isThinking) return;

        var userMessage = _currentInput.Trim();
        _currentInput = string.Empty;

        var outgoing = new ChatMsg { IsUser = true, Content = FormatMessage(userMessage) };
        if (_pendingAttachmentUrl != null)
        {
            outgoing.HasImage = true;
            outgoing.ImageUrl = _pendingAttachmentUrl;
        }
        _messages.Add(outgoing);

        _isThinking = true;
        StateHasChanged();

        try
        {
            // Retrieve first so the answer — and the citation shown to the user —
            // come from the same passages.
            var ragContext = "";
            try
            {
                var hits = await RagService.SearchAsync(userMessage, topK: 3);
                var usable = hits.Where(h => h.RelevanceScore > 0).ToList();
                if (usable.Any())
                {
                    ragContext = string.Join("\n\n", usable.Select(h =>
                        $"[{h.DocumentName} · relevansi {h.RelevanceScore}]\n{h.Content}"));
                }
            }
            catch { /* the assistant can still answer without retrieval */ }

            var prompt = string.IsNullOrEmpty(ragContext)
                ? userMessage
                : $"PERTANYAAN PELANGGAN:\n{userMessage}\n\n" +
                  $"KUTIPAN DARI DOKUMEN KEBIJAKAN LAPAK:\n{ragContext}\n\n" +
                  "Jawab berdasarkan kutipan di atas. Kalau kutipannya tidak cukup, katakan terus terang dan tawarkan eskalasi.";

            var history = _messages
                .SkipLast(1)
                .TakeLast(10)
                .Select(m => new Microsoft.SemanticKernel.ChatMessageContent(
                    m.IsUser ? AuthorRole.User : AuthorRole.Assistant, StripHtml(m.Content)))
                .ToList();

            var reply = new ChatMsg { IsUser = false, RagInfo = ragContext };
            _messages.Add(reply);

            var builder = new System.Text.StringBuilder();
            await foreach (var token in SkChatService.ChatStreamAsync("SitiBohay", prompt, history, _pendingAttachmentUrl))
            {
                builder.Append(token);
                reply.Content = FormatMessage(builder.ToString());
                StateHasChanged();
            }

            var finalText = builder.ToString();
            if (finalText.Length == 0)
            {
                reply.Content = "Maaf, aku belum bisa menjawab sekarang. Hubungi tim support lewat WhatsApp atau email ya.";
                reply.HasHandover = true;
            }
            else
            {
                reply.HasHandover = finalText.Contains("[HANDOVER]", StringComparison.OrdinalIgnoreCase)
                    || (finalText.Contains("WhatsApp", StringComparison.OrdinalIgnoreCase)
                        && finalText.Contains("mail", StringComparison.OrdinalIgnoreCase));
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMsg
            {
                IsUser = false,
                Content = FormatMessage("Ada kendala teknis: " + ex.Message),
                HasHandover = true
            });
        }
        finally
        {
            _isThinking = false;
            _pendingAttachmentUrl = null;
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            var storage = StorageFactory.GetStorageService();
            var storedName = await storage.UploadAsync(file.Name, ms, file.ContentType);
            _pendingAttachmentUrl = await storage.GetPublicUrlAsync(storedName);

            var isImage = file.ContentType.StartsWith("image/");
            _messages.Add(new ChatMsg
            {
                IsUser = false,
                Content = $"{(isImage ? "Gambar" : "Dokumen")} <strong>{System.Net.WebUtility.HtmlEncode(file.Name)}</strong> " +
                          $"({file.Size / 1024} KB) sudah diterima. Ceritakan masalahnya ya.",
                HasImage = isImage,
                ImageUrl = isImage ? _pendingAttachmentUrl : null
            });
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMsg { IsUser = false, Content = "Gagal mengunggah: " + System.Net.WebUtility.HtmlEncode(ex.Message) });
        }
    }

    private static string FormatMessage(string message)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(message);
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        return encoded.Replace("\n", "<br/>");
    }

    private static string StripHtml(string html) =>
        System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", " "));

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendMessage();
    }
}
