@page "/account/forgot-password"

<PageTitle>Lupa password — Lapak</PageTitle>

<div class="auth-container">
    <h2 class="auth-title">Atur ulang password</h2>
    <p class="auth-subtitle">Masukkan email akunmu. Kami kirim tautan untuk membuat password baru.</p>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @_messageKind mb-2">@_message</div>
    }

    <div class="form-group">
        <label class="form-label" for="fp-email">Email</label>
        <input id="fp-email" class="form-input" @bind="_email" type="email" autocomplete="email" placeholder="nama@email.com" />
    </div>

    <button class="btn btn-primary btn-lg btn-block" @onclick="SendReset">Kirim tautan reset</button>

    <p class="text-center text-sm mt-3">
        Sudah ingat passwordnya? <a href="/account/login">Masuk</a>
    </p>
</div>

@code {
    private string _email = string.Empty;
    private string _message = string.Empty;
    private string _messageKind = "success";

    private void SendReset()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _messageKind = "error";
            _message = "Email harus diisi.";
            return;
        }

        // Worded so it never confirms whether an address is registered.
        _messageKind = "success";
        _message = "Kalau email itu terdaftar, tautan reset sudah dikirim. Cek kotak masuk dan folder spam ya.";
    }
}
