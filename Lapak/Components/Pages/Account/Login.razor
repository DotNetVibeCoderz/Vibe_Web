@page "/account/login"

<PageTitle>Masuk — Lapak</PageTitle>

<div class="auth-container">
    <h2 class="auth-title">Masuk ke Lapak</h2>
    <p class="auth-subtitle">Selamat datang kembali. Keranjangmu masih tersimpan.</p>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert error mb-2">@error</div>
    }

    @* A real form post, not a Blazor callback: the auth cookie can only be written
       on a full HTTP response, never from inside an interactive circuit. *@
    <form method="post" action="/api/account/login">
        <AntiforgeryToken />
        <input type="hidden" name="Redirect" value="@redirect" />

        <div class="form-group">
            <label class="form-label" for="login-email">Email</label>
            <input id="login-email" class="form-input" name="Email" type="email" autocomplete="email" placeholder="nama@email.com" required />
        </div>

        <div class="form-group">
            <label class="form-label" for="login-password">Password</label>
            <input id="login-password" class="form-input" name="Password" type="password" autocomplete="current-password" placeholder="Minimal 8 karakter" required />
        </div>

        <div class="flex justify-between items-center mb-3">
            <label class="text-sm flex items-center gap-1">
                <input type="checkbox" name="RememberMe" value="true" /> Ingat saya
            </label>
            <a href="/account/forgot-password" class="text-sm">Lupa password?</a>
        </div>

        <button class="btn btn-primary btn-lg btn-block" type="submit">Masuk</button>
    </form>

    <div class="auth-divider">atau</div>
    <button class="btn-google" type="button" disabled title="Belum tersedia">Masuk dengan Google (segera hadir)</button>

    <p class="text-center text-sm mt-3">
        Belum punya akun? <a href="/account/register">Daftar sekarang</a>
    </p>
</div>

@code {
    [SupplyParameterFromQuery] private string? redirect { get; set; }
    [SupplyParameterFromQuery] private string? error { get; set; }
}
