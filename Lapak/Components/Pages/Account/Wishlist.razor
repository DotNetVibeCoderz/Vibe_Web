@page "/account/wishlist"
@using Lapak.Models
@using Microsoft.EntityFrameworkCore
@using Lapak.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Lapak.Data.LapakDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Wishlist — Lapak</PageTitle>

<div class="page-header">
    <h1 class="page-title">Wishlist</h1>
    <p class="page-subtitle">@_items.Count produk kamu simpan</p>
</div>

@if (!_items.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">❤️</div>
        <h3>Wishlist masih kosong</h3>
        <p>Tekan “Simpan” di halaman produk untuk menyimpannya di sini.</p>
        <a href="/products" class="btn btn-primary">Jelajahi produk</a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var item in _items)
        {
            var product = item.Product;
            var url = "/products/" + product.Slug;
            <div class="product-card">
                <div class="product-image weave" style="--weave-hue: @ProductIcons.HueFor(product.Category?.Name, product.Slug);" @onclick="() => Nav.NavigateTo(url)">
                    <span class="product-glyph"><GlyphIcon Name="@ProductIcons.For(product.Category?.Name)" Size="2rem" /></span>
                    <button class="wishlist-remove" @onclick:stopPropagation="true" @onclick="() => Remove(item)"
                            title="Hapus dari wishlist" aria-label="Hapus @product.Name dari wishlist">✕</button>
                </div>

                <div class="product-info" @onclick="() => Nav.NavigateTo(url)">
                    <div class="product-name">@product.Name</div>
                    <div class="product-store">🏪 @product.Store?.Name</div>
                    <div class="product-price-row">
                        <span class="product-price">Rp@(product.Price.ToString("N0"))</span>
                    </div>
                </div>

                <div style="padding: 0 14px 14px;">
                    <button class="btn btn-primary btn-sm btn-block" @onclick="() => AddToCart(product)" disabled="@(product.Stock <= 0)">
                        @(product.Stock > 0 ? "Masukkan keranjang" : "Stok habis")
                    </button>
                </div>
            </div>
        }
    </div>
}

<style>
    .wishlist-remove {
        position: absolute;
        top: 10px; right: 10px;
        width: 30px; height: 30px;
        border-radius: var(--radius-circle);
        border: none;
        background: var(--bg-secondary);
        color: var(--danger);
        font-size: 0.85rem;
        cursor: pointer;
        box-shadow: var(--shadow-sm);
        display: grid; place-items: center;
        z-index: 2;
    }
    .wishlist-remove:hover { background: var(--danger); color: #fff; }
</style>

@code {
    private List<WishlistItem> _items = new();
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(uid, out _userId)) return;

        _items = await Db.WishlistItems
            .Include(w => w.Product).ThenInclude(p => p.Store)
            .Include(w => w.Product).ThenInclude(p => p.Category)
            .Where(w => w.UserId == _userId)
            .OrderByDescending(w => w.CreatedAt)
            .ToListAsync();
    }

    private async Task Remove(WishlistItem item)
    {
        Db.WishlistItems.Remove(item);
        if (item.Product.LikeCount > 0) item.Product.LikeCount--;
        await Db.SaveChangesAsync();
        _items.Remove(item);
    }

    private async Task AddToCart(Product product)
    {
        var max = Math.Max(1, Math.Min(product.MaxOrder, product.Stock));
        var existing = await Db.CartItems.FirstOrDefaultAsync(c => c.UserId == _userId && c.ProductId == product.Id);

        if (existing != null) existing.Quantity = Math.Min(existing.Quantity + 1, max);
        else Db.CartItems.Add(new CartItem { UserId = _userId, ProductId = product.Id, Quantity = 1 });

        await Db.SaveChangesAsync();
        Nav.NavigateTo("/cart");
    }

}
