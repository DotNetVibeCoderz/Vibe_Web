@page "/account/register"

<PageTitle>Daftar — Lapak</PageTitle>

<div class="auth-container">
    <h2 class="auth-title">Buka akun Lapak</h2>
    <p class="auth-subtitle">Gratis. Bisa belanja, bisa juga langsung berjualan.</p>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert error mb-2">@error</div>
    }

    <form method="post" action="/api/account/register">
        <AntiforgeryToken />

        <div class="form-group">
            <label class="form-label" for="reg-name">Nama lengkap</label>
            <input id="reg-name" class="form-input" name="FullName" autocomplete="name" placeholder="Nama sesuai identitas" required />
        </div>

        <div class="form-group">
            <label class="form-label" for="reg-email">Email</label>
            <input id="reg-email" class="form-input" name="Email" type="email" autocomplete="email" placeholder="nama@email.com" required />
        </div>

        <div class="form-group">
            <label class="form-label" for="reg-phone">No. telepon</label>
            <input id="reg-phone" class="form-input" name="Phone" type="tel" autocomplete="tel" placeholder="08123456789" />
        </div>

        <div class="form-group">
            <label class="form-label" for="reg-password">Password</label>
            <input id="reg-password" class="form-input" name="Password" type="password" autocomplete="new-password" required />
            <div class="form-hint">Minimal 8 karakter, dengan huruf besar, huruf kecil, dan angka.</div>
        </div>

        <div class="form-group">
            <label class="form-label" for="reg-confirm">Ulangi password</label>
            <input id="reg-confirm" class="form-input" name="ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>

        <div class="form-group">
            <label class="form-label" for="reg-type">Daftar sebagai</label>
            <select id="reg-type" class="form-input" name="UserType">
                <option value="Buyer" selected>Pembeli</option>
                <option value="Seller">Penjual</option>
            </select>
            <div class="form-hint">Pilih penjual kalau kamu mau langsung membuka toko.</div>
        </div>

        <button class="btn btn-primary btn-lg btn-block" type="submit">Daftar</button>
    </form>

    <p class="text-center text-sm mt-3">
        Sudah punya akun? <a href="/account/login">Masuk</a>
    </p>
</div>

@code {
    [SupplyParameterFromQuery] private string? error { get; set; }
}
