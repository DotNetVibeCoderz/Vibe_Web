@page "/Error"
@using System.Diagnostics

<PageTitle>Terjadi kesalahan — Lapak</PageTitle>

<div class="empty-state" style="margin-top: 48px;">
    <div class="empty-state-icon">⚠️</div>
    <h3>Ada yang tidak beres di sisi kami</h3>
    <p>Permintaanmu gagal diproses. Coba muat ulang halaman ini — kalau masih gagal, hubungi tim support.</p>

    @if (ShowRequestId)
    {
        <p class="text-xs text-muted">
            Sebutkan kode ini saat menghubungi support: <code>@RequestId</code>
        </p>
    }

    <div class="flex gap-1 justify-center flex-wrap mt-2">
        <a href="/" class="btn btn-primary">Kembali ke beranda</a>
        <a href="mailto:support@lapak.com" class="btn btn-secondary">Email support</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
