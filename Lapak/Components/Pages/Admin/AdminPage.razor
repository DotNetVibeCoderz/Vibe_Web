@page "/admin"
@page "/admin/{Section}"
@using Lapak.Models
@using Microsoft.EntityFrameworkCore
@using Lapak.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@inject Lapak.Data.LapakDbContext Db
@inject NavigationManager Nav

<PageTitle>Panel admin — Lapak</PageTitle>

<div class="page-header">
    <h1 class="page-title">Panel admin</h1>
    <p class="page-subtitle">Kelola katalog, voucher, dan verifikasi toko.</p>
</div>

<div class="admin-tabs mb-3">
    <a href="/admin" class="btn btn-sm @(_sec == "" ? "btn-primary" : "btn-secondary")">Ringkasan</a>
    <a href="/admin/categories" class="btn btn-sm @(_sec == "categories" ? "btn-primary" : "btn-secondary")">Kategori</a>
    <a href="/admin/vouchers" class="btn btn-sm @(_sec == "vouchers" ? "btn-primary" : "btn-secondary")">Voucher</a>
    <a href="/admin/stores" class="btn btn-sm @(_sec == "stores" ? "btn-primary" : "btn-secondary")">Verifikasi toko</a>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert success mb-3">@_message</div>
}
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert error mb-3">@_error</div>
}

@switch (_sec)
{
    case "categories":
        <div class="flex justify-between items-center mb-3 flex-wrap gap-1">
            <h2>Kategori</h2>
            <button class="btn btn-primary" @onclick="() => _showCat = !_showCat">@(_showCat ? "Tutup form" : "Tambah kategori")</button>
        </div>

        @if (_showCat)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label" for="c-name">Nama kategori</label>
                            <input id="c-name" class="form-input" @bind="_cn" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="c-parent">Induk</label>
                            <select id="c-parent" class="form-input" @bind="_cp">
                                <option value="">Kategori utama</option>
                                @foreach (var c in _cats) { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-6">
                            <label class="form-label" for="c-slug">Slug</label>
                            <input id="c-slug" class="form-input" @bind="_cs" placeholder="dibuat otomatis" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="c-order">Urutan tampil</label>
                            <input id="c-order" class="form-input" type="number" @bind="_co" />
                        </div>
                    </div>
                    <div class="flex gap-1 mt-3">
                        <button class="btn btn-primary" @onclick="SaveCategory">Simpan kategori</button>
                        <button class="btn btn-secondary" @onclick="() => _showCat = false">Batal</button>
                    </div>
                </div>
            </div>
        }

        @foreach (var cat in _cats)
        {
            <div class="card mb-2">
                <div class="card-header flex justify-between items-center">
                    <span>@cat.Name</span>
                    <span class="text-xs text-muted">@cat.SubCategories.Count sub-kategori · /@cat.Slug</span>
                </div>
                @if (cat.SubCategories.Any())
                {
                    <div class="card-body">
                        <div class="flex gap-1 flex-wrap">
                            @foreach (var sub in cat.SubCategories.OrderBy(s => s.SortOrder))
                            {
                                <span class="chip">@sub.Name</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        break;

    case "vouchers":
        <div class="flex justify-between items-center mb-3 flex-wrap gap-1">
            <h2>Voucher</h2>
            <button class="btn btn-primary" @onclick="() => _showV = !_showV">@(_showV ? "Tutup form" : "Tambah voucher")</button>
        </div>

        @if (_showV)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row">
                        <div class="col-4">
                            <label class="form-label" for="v-code">Kode</label>
                            <input id="v-code" class="form-input" @bind="_vc" placeholder="HEMAT10" />
                        </div>
                        <div class="col-4">
                            <label class="form-label" for="v-name">Nama</label>
                            <input id="v-name" class="form-input" @bind="_vn" />
                        </div>
                        <div class="col-4">
                            <label class="form-label" for="v-type">Tipe</label>
                            <select id="v-type" class="form-input" @bind="_vt">
                                <option value="Percentage">Persentase</option>
                                <option value="Fixed">Nominal tetap</option>
                                <option value="Shipping">Gratis ongkir</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-3">
                            <label class="form-label" for="v-value">Nilai</label>
                            <input id="v-value" class="form-input" type="number" @bind="_vv" />
                        </div>
                        <div class="col-3">
                            <label class="form-label" for="v-max">Potongan maksimal</label>
                            <input id="v-max" class="form-input" type="number" @bind="_vmd" />
                        </div>
                        <div class="col-3">
                            <label class="form-label" for="v-min">Minimal belanja</label>
                            <input id="v-min" class="form-input" type="number" @bind="_vmp" />
                        </div>
                        <div class="col-3">
                            <label class="form-label" for="v-usage">Kuota pemakaian</label>
                            <input id="v-usage" class="form-input" type="number" @bind="_vmu" />
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-6">
                            <label class="form-label" for="v-start">Mulai berlaku</label>
                            <input id="v-start" class="form-input" type="date" @bind="_vstart" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="v-end">Berakhir</label>
                            <input id="v-end" class="form-input" type="date" @bind="_vend" />
                        </div>
                    </div>
                    <div class="flex gap-1 mt-3">
                        <button class="btn btn-primary" @onclick="SaveVoucher">Simpan voucher</button>
                        <button class="btn btn-secondary" @onclick="() => _showV = false">Batal</button>
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr><th>Kode</th><th>Nama</th><th>Tipe</th><th>Nilai</th><th>Terpakai</th><th>Berakhir</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _vouchers)
                        {
                            var expired = v.EndDate < DateTime.UtcNow;
                            <tr>
                                <td><span class="voucher-code">@v.Code</span></td>
                                <td>@v.Name</td>
                                <td>@v.Type</td>
                                <td>@(v.Type == "Percentage" ? $"{v.Value:0.#}%" : $"Rp{v.Value:N0}")</td>
                                <td>@v.CurrentUsage / @v.MaxUsage</td>
                                <td>@v.EndDate.ToString("d MMM yyyy")</td>
                                <td>
                                    <span class="badge-status" style="color:@(expired || !v.IsActive ? "var(--text-muted)" : "var(--success)"); border-color:@(expired || !v.IsActive ? "var(--border-strong)" : "var(--success)");">
                                        @(expired ? "Kedaluwarsa" : v.IsActive ? "Aktif" : "Nonaktif")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        break;

    case "stores":
        <h2 class="mb-3">Verifikasi toko</h2>
        @if (!_pending.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">✅</div>
                <h3>Tidak ada antrean</h3>
                <p>Semua pengajuan toko sudah diproses.</p>
            </div>
        }
        else
        {
            <div class="card">
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr><th>Toko</th><th>Pemilik</th><th>Kota</th><th>Diajukan</th><th>Aksi</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _pending)
                            {
                                <tr>
                                    <td><strong>@s.Name</strong><div class="text-xs text-muted">/@s.Slug</div></td>
                                    <td>@s.User?.FullName<div class="text-xs text-muted">@s.User?.Email</div></td>
                                    <td>@(s.City ?? "—")</td>
                                    <td class="text-sm">@s.CreatedAt.ToString("d MMM yyyy")</td>
                                    <td>
                                        <div class="flex gap-1">
                                            <button class="btn btn-sm btn-success" @onclick="() => Verify(s, true)">Setujui</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => Verify(s, false)">Tolak</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        break;

    default:
        <div class="row mb-3">
            <div class="col-3">
                <div class="stat-card">
                    <div class="stat-icon purple"><GlyphIcon Name="kotak" Size="1.35rem" /></div>
                    <div><div class="stat-value">@_totalProducts.ToString("N0")</div><div class="stat-label">Produk</div></div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-card">
                    <div class="stat-icon green"><GlyphIcon Name="toko" Size="1.35rem" /></div>
                    <div><div class="stat-value">@_totalStores.ToString("N0")</div><div class="stat-label">Toko</div></div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-card">
                    <div class="stat-icon blue"><GlyphIcon Name="orang-grup" Size="1.35rem" /></div>
                    <div><div class="stat-value">@_totalUsers.ToString("N0")</div><div class="stat-label">Pengguna</div></div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-card">
                    <div class="stat-icon orange"><GlyphIcon Name="nota" Size="1.35rem" /></div>
                    <div><div class="stat-value">@_pending.Count</div><div class="stat-label">Menunggu verifikasi</div></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h3>Yang bisa dikerjakan di sini</h3>
                <ul class="admin-links">
                    <li><a href="/admin/stores">Verifikasi toko</a> — @_pending.Count toko menunggu keputusan.</li>
                    <li><a href="/admin/vouchers">Voucher</a> — @_vouchers.Count(v => v.IsActive && v.EndDate >= DateTime.UtcNow) voucher masih aktif.</li>
                    <li><a href="/admin/categories">Kategori</a> — @_cats.Count kategori utama.</li>
                    <li><a href="/dashboard">Dashboard</a> — angka penjualan dan segmentasi pelanggan.</li>
                </ul>
            </div>
        </div>
        break;
}

<style>
    .admin-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
    .admin-links { list-style: none; margin-top: 10px; line-height: 2.1; }
    .admin-links li { padding-left: 16px; position: relative; }
    .admin-links li::before { content: '→'; position: absolute; left: 0; color: var(--gold); }
</style>

@code {
    [Parameter] public string? Section { get; set; }
    private string _sec => Section?.ToLowerInvariant() ?? "";

    private int _totalProducts, _totalStores, _totalUsers;
    private List<Lapak.Models.Store> _pending = new();
    private List<Category> _cats = new();
    private List<Voucher> _vouchers = new();
    private string _message = "", _error = "";

    private bool _showCat;
    private string _cn = "", _cs = "", _cp = "";
    private int _co;

    private bool _showV;
    private string _vc = "", _vn = "", _vt = "Percentage";
    private decimal _vv, _vmd, _vmp;
    private int _vmu = 100;
    private DateTime _vstart = DateTime.UtcNow.Date;
    private DateTime _vend = DateTime.UtcNow.Date.AddMonths(1);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _totalProducts = await Db.Products.CountAsync();
        _totalStores = await Db.Stores.CountAsync();
        _totalUsers = await Db.Users.CountAsync();

        _pending = await Db.Stores
            .Where(s => s.VerificationStatus == "Pending")
            .Include(s => s.User)
            .OrderBy(s => s.CreatedAt)
            .ToListAsync();

        _cats = await Db.Categories
            .Include(c => c.SubCategories)
            .Where(c => c.ParentCategoryId == null)
            .OrderBy(c => c.SortOrder)
            .ToListAsync();

        _vouchers = await Db.Vouchers.OrderByDescending(v => v.CreatedAt).Take(30).ToListAsync();
    }

    private async Task SaveCategory()
    {
        _message = _error = "";

        if (string.IsNullOrWhiteSpace(_cn)) { _error = "Nama kategori harus diisi."; return; }

        var slug = Slugify(string.IsNullOrWhiteSpace(_cs) ? _cn : _cs);
        if (await Db.Categories.AnyAsync(c => c.Slug == slug))
        {
            _error = $"Slug \"{slug}\" sudah dipakai kategori lain.";
            return;
        }

        Db.Categories.Add(new Category
        {
            Name = _cn.Trim(),
            Slug = slug,
            SortOrder = _co,
            ParentCategoryId = Guid.TryParse(_cp, out var parentId) ? parentId : null
        });

        await Db.SaveChangesAsync();
        _showCat = false;
        _cn = _cs = _cp = "";
        _co = 0;
        _message = "Kategori ditambahkan.";
        await LoadAsync();
    }

    private async Task SaveVoucher()
    {
        _message = _error = "";

        if (string.IsNullOrWhiteSpace(_vc)) { _error = "Kode voucher harus diisi."; return; }
        if (string.IsNullOrWhiteSpace(_vn)) { _error = "Nama voucher harus diisi."; return; }
        if (_vv <= 0 && _vt != "Shipping") { _error = "Nilai voucher harus lebih dari nol."; return; }
        if (_vend <= _vstart) { _error = "Tanggal berakhir harus setelah tanggal mulai."; return; }

        var code = _vc.Trim().ToUpperInvariant();
        if (await Db.Vouchers.AnyAsync(v => v.Code == code))
        {
            _error = $"Kode \"{code}\" sudah dipakai.";
            return;
        }

        Db.Vouchers.Add(new Voucher
        {
            Code = code,
            Name = _vn.Trim(),
            Type = _vt,
            Value = _vv,
            MaxDiscount = _vmd > 0 ? _vmd : null,
            MinPurchase = _vmp > 0 ? _vmp : null,
            MaxUsage = Math.Max(1, _vmu),
            StartDate = _vstart,
            EndDate = _vend
        });

        await Db.SaveChangesAsync();
        _showV = false;
        _vc = _vn = "";
        _vv = _vmd = _vmp = 0;
        _vmu = 100;
        _message = $"Voucher {code} dibuat.";
        await LoadAsync();
    }

    private async Task Verify(Lapak.Models.Store store, bool approve)
    {
        store.VerificationStatus = approve ? "Verified" : "Rejected";
        store.IsVerified = approve;
        if (approve) store.VerifiedAt = DateTime.UtcNow;
        store.UpdatedAt = DateTime.UtcNow;

        await Db.SaveChangesAsync();
        _pending.Remove(store);
        _message = approve ? $"Toko \"{store.Name}\" disetujui." : $"Pengajuan \"{store.Name}\" ditolak.";
    }

    private static string Slugify(string value)
    {
        var slug = new string(value.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray());
        while (slug.Contains("--")) slug = slug.Replace("--", "-");
        return slug.Trim('-');
    }
}
