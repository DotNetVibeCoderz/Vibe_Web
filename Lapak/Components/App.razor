<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Lapak — pasar digital Indonesia dengan asisten belanja AI." />
    <meta name="theme-color" content="#1B2A4A" />
    <base href="/" />
    <ResourcePreloader />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Bricolage Grotesque for display; Plus Jakarta Sans — drawn for Jakarta — for body. *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..600&display=swap" />

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Lapak.styles.css"]" />
    <ImportMap />
    <HeadOutlet />

    @* Applies the stored theme to <html> before first paint, so the page never
       flashes light before the circuit connects. Kept inline and dependency-free
       for that reason. *@
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('lapak-theme');
                var dark = stored === 'dark' ||
                    (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (dark) document.documentElement.classList.add('dark-theme');
            } catch (e) { /* blocked storage — fall back to the light theme */ }
        })();
    </script>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    @* autostart="false" so the SignalR timeout below is applied before the circuit
       opens. Calling Blazor.start() ahead of this script throws — Blazor is not
       defined until it loads. *@
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["lapak.js"]"></script>
    <script>
        Blazor.start({
            circuit: {
                configureSignalR: builder => builder.withServerTimeout(120000)
            }
        });
    </script>
</body>

</html>
