{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Llm": {
    "DefaultProvider": "OpenAI",
    "OpenAI": {
      "ApiKey": "sk-proj-open-ai-key",
      "Model": "gpt-4o-mini",
      "Endpoint": "https://api.openai.com/v1"
    },
    "Gemini": {
      "ApiKey": "YOUR_GEMINI_API_KEY",
      "Model": "gemini-2.0-flash"
    },
    "Anthropic": {
      "ApiKey": "YOUR_ANTHROPIC_API_KEY",
      "Model": "claude-3-5-sonnet-20241022"
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "llama3.1"
    },
    "OpenAICompatible": {
      "Endpoint": "",
      "ApiKey": "",
      "Model": ""
    },
    "SystemPrompt": "Kamu adalah dokter Markonah Al-senyumwati, seorang dokter yang cerdas, ramah, informatif, sopan, dan humoris. Kamu siap memberikan pelayanan informasi kesehatan yang akurat dan bermanfaat. Jawablah dengan bahasa yang mudah dipahami, gunakan analogi sederhana bila perlu, dan selalu ingatkan pasien untuk berkonsultasi langsung ke dokter untuk kondisi darurat.",
    "BotName": "dokter Markonah Al-senyumwati",
    "Temperature": 0.7,
    "MaxTokens": 4096
  },

  "Database": {
    "Provider": "SQLite",
    "ConnectionString": "Data Source=VirtualDoctor.db"
  },

  "VectorDb": {
    "Provider": "InMemory",
    "Endpoint": null,
    "ApiKey": null,
    "CollectionName": "health-docs",
    "ConnectionString": "Data Source=VectorStore.db"
  },

  "Storage": {
    "Provider": "AzureBlob", //FileSystem
    "BasePath": "uploads",
    "Endpoint": null,
    "AccessKey": null,
    "SecretKey": null,
    "BucketName": null,
    "Region": "ap-southeast-1",
    "ConnectionString": "DefaultEndpointsProtocol=https;AzureBlobConString",
    "AccountName": null,
    "ContainerName": "vdoctor"
  },

  "Indexing": {
    "PdfFolderPath": "HealthPdfs",
    "IntervalMinutes": 30,
    "AutoIndex": true
  },

  "GoogleMaps": {
    "ApiKey": "GOOGLE_MAP_KEY"
  },

  "Search": {
    "Provider": "Tavily",
    "ApiKey": "TAVILY_KEY"
  }
}
