@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Services.IAuthService AuthService

<a class="vd-skip-link" href="#vd-main-content">Lompat ke konten</a>

<div class="vd-app">
    <aside class="vd-sidebar @(_railCollapsed ? "collapsed" : "") @(_drawerOpen ? "is-open" : "")"
           id="vd-sidebar" aria-label="Navigasi utama">
        <div class="vd-sidebar-header">
            <a href="/" class="vd-logo">
                <span class="vd-logo-mark vd-icon vd-icon-brand"></span>
                @if (!_railCollapsed) { <span>VirtualDoctor</span> }
            </a>
            <button class="btn-toggle" @onclick="ToggleRail"
                    title="@(_railCollapsed ? "Lebarkan menu" : "Ciutkan menu")"
                    aria-label="@(_railCollapsed ? "Lebarkan menu" : "Ciutkan menu")">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <nav class="vd-nav">
            @foreach (var item in _mainNav)
            {
                <NavLink href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         @onclick="CloseDrawer">
                    <span class="vd-icon @item.Icon"></span> <span>@item.Label</span>
                </NavLink>
            }

            @if (_isDoctor)
            {
                <div class="vd-nav-divider"></div>
                <NavLink href="/doctor/consultations" @onclick="CloseDrawer"><span class="vd-icon vd-icon-chat"></span> <span>Dokter · Konsultasi</span></NavLink>
                <NavLink href="/doctor/appointments" @onclick="CloseDrawer"><span class="vd-icon vd-icon-calendar"></span> <span>Dokter · Janji Temu</span></NavLink>
            }

            @if (_isAdmin)
            {
                <div class="vd-nav-divider"></div>
                @foreach (var item in _adminNav)
                {
                    <NavLink href="@item.Href" @onclick="CloseDrawer">
                        <span class="vd-icon vd-icon-admin"></span> <span>@item.Label</span>
                    </NavLink>
                }
            }
        </nav>

        <div class="vd-sidebar-footer">
            <small class="text-muted">© 2025 VirtualDoctor</small>
        </div>
    </aside>

    @if (_drawerOpen)
    {
        <button class="vd-scrim" @onclick="CloseDrawer" aria-label="Tutup menu"></button>
    }

    <main class="vd-main">
        <header class="vd-topbar">
            <div class="vd-topbar-left">
                <button class="btn btn-icon vd-nav-toggle" @onclick="ToggleDrawer"
                        aria-label="Buka menu" aria-controls="vd-sidebar" aria-expanded="@_drawerOpen">
                    <i class="bi bi-list"></i>
                </button>
                <span class="vd-page-title">@_pageTitle</span>
            </div>
            <div class="vd-topbar-right">
                <button class="vd-theme-toggle @(_darkMode ? "is-dark" : "")" @onclick="ToggleDarkMode"
                        title="@(_darkMode ? "Ganti ke tema terang" : "Ganti ke tema gelap")"
                        aria-label="@(_darkMode ? "Ganti ke tema terang" : "Ganti ke tema gelap")"
                        aria-pressed="@_darkMode">
                    <span class="vd-icon vd-icon-sun"></span>
                    <span class="vd-icon vd-icon-moon"></span>
                </button>
                <div class="dropdown">
                    <button class="btn btn-icon dropdown-toggle" data-bs-toggle="dropdown"
                            aria-label="Menu akun" aria-expanded="false">
                        <span class="vd-icon vd-icon-user"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <span class="dropdown-item-text fw-bold">@_userName</span>
                        <div class="dropdown-divider"></div>
                        <a href="/profile" class="dropdown-item"><i class="bi bi-person"></i> Profil</a>
                        @if (_isAdmin)
                        {
                            <a href="/admin/users" class="dropdown-item"><i class="bi bi-people"></i> Kelola Pengguna</a>
                            <a href="/admin/settings" class="dropdown-item"><i class="bi bi-sliders"></i> Pengaturan Sistem</a>
                        }
                        <a href="/settings" class="dropdown-item"><i class="bi bi-gear"></i> Pengaturan</a>
                        <div class="dropdown-divider"></div>
                        <a href="/auth/logout" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Keluar</a>
                    </div>
                </div>
            </div>
        </header>

        <div class="vd-content vd-page-enter" id="vd-main-content" tabindex="-1">@Body</div>
    </main>
</div>

@code {
    private record NavItem(string Href, string Label, string Icon);

    private static readonly NavItem[] _mainNav =
    {
        new("/", "Beranda", "vd-icon-home"),
        new("/ai-chat", "AI Chat", "vd-icon-ai"),
        new("/doctors", "Dokter", "vd-icon-doctor"),
        new("/consultations", "Konsultasi", "vd-icon-chat"),
        new("/appointments", "Janji Temu", "vd-icon-calendar"),
        new("/pharmacy", "Farmasi", "vd-icon-pharmacy"),
        new("/homecare", "Homecare", "vd-icon-homecare"),
        new("/hospitals", "RS & Klinik", "vd-icon-hospital"),
        new("/articles", "Artikel", "vd-icon-article"),
        new("/tagihan", "Tagihan Saya", "vd-icon-billing"),
        new("/dashboard", "Dashboard", "vd-icon-dashboard"),
        new("/settings", "Pengaturan", "vd-icon-settings")
    };

    private static readonly NavItem[] _adminNav =
    {
        new("/admin/users", "Kelola Pengguna", "vd-icon-admin"),
        new("/admin/doctors", "Kelola Dokter", "vd-icon-admin"),
        new("/admin/hospitals", "Kelola RS/Klinik", "vd-icon-admin"),
        new("/admin/medicines", "Kelola Obat", "vd-icon-admin"),
        new("/admin/articles", "Kelola Artikel", "vd-icon-admin"),
        new("/admin/appointments", "Kelola Janji Temu", "vd-icon-admin"),
        new("/admin/doctor-schedules", "Kelola Jadwal", "vd-icon-admin"),
        new("/admin/homecare", "Kelola Homecare", "vd-icon-admin"),
        new("/admin/orders", "Kelola Pesanan", "vd-icon-admin"),
        new("/admin/payments", "Verifikasi Pembayaran", "vd-icon-admin"),
        new("/admin/webhooks", "Jejak Webhook", "vd-icon-admin"),
        new("/admin/consultations", "Pantau Konsultasi", "vd-icon-admin"),
        new("/admin/settings", "Pengaturan Sistem", "vd-icon-admin")
    };

    private bool _railCollapsed;
    private bool _drawerOpen;
    private bool _darkMode;
    private string _pageTitle = "Beranda";
    private string _userName = "Pengguna";
    private bool _isAdmin;
    private bool _isDoctor;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user != null) _userName = user.FullName;
        _isAdmin = AuthService.IsAdmin();
        _isDoctor = AuthService.IsDoctor();

        _pageTitle = TitleFor(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var theme = await JS.InvokeAsync<string>("vdApp.initTheme");
            var isDark = theme == "dark";
            if (isDark != _darkMode) { _darkMode = isDark; StateHasChanged(); }
        }
        catch (JSDisconnectedException) { }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _pageTitle = TitleFor(e.Location);
        _drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private static string TitleFor(string location)
    {
        var path = Uri.TryCreate(location, UriKind.Absolute, out var uri) ? uri.AbsolutePath : location;
        path = path.TrimEnd('/');
        if (string.IsNullOrEmpty(path)) return "Beranda";

        var admin = _adminNav.FirstOrDefault(i => path.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase));
        if (admin != null) return admin.Label;

        if (path.StartsWith("/doctor/consultations")) return "Dokter · Konsultasi";
        if (path.StartsWith("/doctor/appointments")) return "Dokter · Janji Temu";

        var main = _mainNav.Where(i => i.Href != "/")
                           .FirstOrDefault(i => path.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase));
        if (main != null) return main.Label;

        return path.StartsWith("/profile") ? "Profil" : "VirtualDoctor";
    }

    private void ToggleRail() => _railCollapsed = !_railCollapsed;

    private async Task ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        await SafeLockScroll(_drawerOpen);
    }

    private async Task CloseDrawer()
    {
        if (!_drawerOpen) return;
        _drawerOpen = false;
        await SafeLockScroll(false);
    }

    private async Task SafeLockScroll(bool locked)
    {
        try { await JS.InvokeVoidAsync("vdApp.lockScroll", locked); }
        catch (JSDisconnectedException) { }
    }

    private async Task ToggleDarkMode()
    {
        _darkMode = !_darkMode;
        try { await JS.InvokeAsync<string>("vdApp.setTheme", _darkMode ? "dark" : "light"); }
        catch (JSDisconnectedException) { }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
