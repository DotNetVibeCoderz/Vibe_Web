@page "/auth/reset-password"
@layout MinimalLayout
@attribute [AllowAnonymous]

<div class="vd-auth-container">
    <div class="vd-auth-card">
        <div class="vd-auth-logo"><i class="bi bi-heart-pulse-fill"></i><h2>Reset Password</h2><p class="vd-text-muted">Masukkan email untuk mereset password</p></div>
        @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger">@_error</div> }
        @if (!string.IsNullOrEmpty(_success)) { <div class="alert alert-success">@_success</div> }

        @if (!_sent)
        {
            <!-- data-enhanced="false" agar redirect bekerja -->
            <form method="post" action="/auth/reset-password-handler" data-enhanced="false">
                <div class="vd-form-group"><label class="vd-form-label">Email Terdaftar</label><input type="email" name="email" class="vd-form-control" placeholder="Masukkan email..." required /></div>
                <button type="submit" class="vd-btn vd-btn-primary vd-btn-lg vd-w-100 vd-mb-2"><i class="bi bi-envelope"></i> Reset Password</button>
            </form>
        }
        else
        {
            <div class="text-center">
                <i class="bi bi-check-circle-fill" style="font-size:3rem;color:var(--vd-accent);"></i>
                <h5 class="mt-2">Password Direset!</h5><p>Password baru: <strong>Reset123!</strong></p>
                <p class="vd-text-muted small">Login dan segera ganti password di menu Profil.</p>
                <a href="/auth/login" class="vd-btn vd-btn-primary">Ke Halaman Login</a>
            </div>
        }
        <div class="text-center mt-3"><a href="/auth/login">← Kembali ke Login</a></div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? error { get; set; }
    [SupplyParameterFromQuery] private bool sent { get; set; }
    private string? _error; private string? _success; private bool _sent;
    protected override void OnInitialized()
    { _sent = sent; _error = error == "notfound" ? "Email tidak ditemukan." : null; if (_sent) _success = "Password di-reset!"; }
}
