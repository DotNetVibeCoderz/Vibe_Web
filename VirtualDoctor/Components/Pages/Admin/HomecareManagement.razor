@page "/admin/homecare"
@rendermode InteractiveServer
@attribute [Authorize]
@using VirtualDoctor.Models
@inject Services.IHomecareService HomecareServiceApi
@inject Services.IAuthService AuthService

@if (!_isAdmin)
{
    <div class="vd-card text-center p-5 mt-5">
        <i class="bi bi-shield-lock-fill" style="font-size:4rem;color:var(--vd-danger);"></i>
        <h3 class="mt-3">Akses Ditolak</h3>
        <p class="vd-text-muted">Halaman ini hanya untuk administrator.</p>
        <a href="/" class="vd-btn vd-btn-primary">Kembali ke Beranda</a>
    </div>
}
else
{
    <div class="vd-mb-2 vd-flex vd-flex-between">
        <div>
            <h3 class="mb-0"><i class="bi bi-house-heart"></i> Master Homecare</h3>
            <small class="vd-text-muted">CRUD + Export + Filter + Paging</small>
        </div>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="OpenCreateForm"><i class="bi bi-plus-circle"></i> Tambah Homecare</button>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/homecare?format=csv"><i class="bi bi-filetype-csv"></i> CSV</a>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/homecare?format=xlsx"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        </div>
    </div>

    <div class="vd-card vd-mb-2">
        <div class="vd-grid vd-grid-3">
            <div><label class="vd-form-label">Cari</label><input class="vd-form-control" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="UserId" /></div>
            <div><label class="vd-form-label">Status</label><select class="vd-form-control" @bind="_statusFilter" @bind:after="ApplyFilter"><option value="">Semua</option>@foreach (var s in Enum.GetValues<HomecareServiceStatus>()) { <option value="@s">@s</option> }</select></div>
            <div><label class="vd-form-label">Page Size</label><select class="vd-form-control" @bind="_pageSize" @bind:after="ApplyFilter"><option value="5">5</option><option value="10">10</option><option value="20">20</option></select></div>
        </div>
    </div>

    <div class="vd-card" style="overflow-x:auto;">
        <table class="vd-table">
            <thead><tr>
                <th @onclick="() => SortBy(nameof(HomecareService.UserId))" style="cursor:pointer;">UserId <span class="ms-1">@SortIcon(nameof(HomecareService.UserId))</span></th>
                <th @onclick="() => SortBy(nameof(HomecareService.ServiceType))" style="cursor:pointer;">Tipe <span class="ms-1">@SortIcon(nameof(HomecareService.ServiceType))</span></th>
                <th @onclick="() => SortBy(nameof(HomecareService.Status))" style="cursor:pointer;">Status <span class="ms-1">@SortIcon(nameof(HomecareService.Status))</span></th>
                <th @onclick="() => SortBy(nameof(HomecareService.ScheduledDate))" style="cursor:pointer;">Tanggal <span class="ms-1">@SortIcon(nameof(HomecareService.ScheduledDate))</span></th>
                <th>Biaya</th><th style="width:120px;">Aksi</th></tr></thead>
            <tbody>
                @foreach (var h in PagedItems)
                {
                    <tr>
                        <td>@h.UserId</td>
                        <td>@h.ServiceType</td>
                        <td>@h.Status</td>
                        <td>@h.ScheduledDate.ToString("dd/MM/yyyy")</td>
                        <td>Rp@(h.Fee.ToString("N0"))</td>
                        <td>
                            <div class="vd-flex vd-gap-1">
                                <button class="vd-btn vd-btn-outline vd-btn-sm" @onclick="() => OpenEditForm(h)"><i class="bi bi-pencil"></i></button>
                                <button class="vd-btn vd-btn-outline vd-btn-sm" style="color:var(--vd-danger);" @onclick="() => Delete(h)"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="vd-flex vd-flex-between mt-2">
        <small class="vd-text-muted">Hal @_page/@_totalPages · Total @_filtered.Count</small>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page <= 1)" @onclick="() => GoPage(_page - 1)">◀</button>
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page >= _totalPages)" @onclick="() => GoPage(_page + 1)">▶</button>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="vd-modal-overlay" @onclick="CloseForm">
        <div class="vd-modal-content" @onclick:stopPropagation="true">
            <div class="vd-card-header">
                <span class="vd-card-title">@(_isEdit ? "✏️ Edit Homecare" : "➕ Tambah Homecare")</span>
                <button class="btn btn-icon" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="vd-grid vd-grid-2">
                <div class="vd-form-group"><label class="vd-form-label">UserId</label><input class="vd-form-control" @bind="_formUserId" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Tipe Layanan</label><select class="vd-form-control" @bind="_formType">@foreach (var t in Enum.GetValues<HomecareServiceType>()) { <option value="@t">@t</option> }</select></div>
                <div class="vd-form-group"><label class="vd-form-label">Status</label><select class="vd-form-control" @bind="_formStatus">@foreach (var s in Enum.GetValues<HomecareServiceStatus>()) { <option value="@s">@s</option> }</select></div>
                <div class="vd-form-group"><label class="vd-form-label">Tanggal (yyyy-MM-dd)</label><input type="text" class="vd-form-control" @bind="_formDate" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Alamat</label><input class="vd-form-control" @bind="_formAddress" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Biaya</label><input type="number" class="vd-form-control" @bind="_formFee" /></div>
            </div>
            <div class="vd-flex vd-gap-1" style="justify-content:flex-end;">
                <button class="vd-btn vd-btn-outline" @onclick="CloseForm">Batal</button>
                <button class="vd-btn vd-btn-primary" @onclick="Save">💾 Simpan</button>
            </div>
            @if (!string.IsNullOrEmpty(_formMsg)) { <small class="vd-text-muted d-block mt-1">@_formMsg</small> }
        </div>
    </div>
}

@code {
    private bool _isAdmin;
    private List<HomecareService> _all = new();
    private List<HomecareService> _filtered = new();
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private string _search = "";
    private string _statusFilter = "";
    private string _sortColumn = nameof(HomecareService.ScheduledDate);
    private bool _sortAsc = false;

    private bool _showForm;
    private bool _isEdit;
    private string _editId = "";
    private string _formUserId = "";
    private HomecareServiceType _formType = HomecareServiceType.LabTest;
    private HomecareServiceStatus _formStatus = HomecareServiceStatus.Requested;
    private string _formDate = DateTime.Now.ToString("yyyy-MM-dd");
    private string _formAddress = "";
    private decimal _formFee = 0;
    private string? _formMsg;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = AuthService.IsAdmin();
        if (!_isAdmin) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        _all = await HomecareServiceApi.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim();
        _filtered = _all.Where(h =>
            (string.IsNullOrEmpty(q) || h.UserId.Contains(q, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_statusFilter) || h.Status.ToString() == _statusFilter)
        ).ToList();
        _filtered = ApplySort(_filtered);
        _page = 1;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    }

    private List<HomecareService> ApplySort(List<HomecareService> data)
    {
        return _sortColumn switch
        {
            nameof(HomecareService.UserId) => _sortAsc ? data.OrderBy(x => x.UserId).ToList() : data.OrderByDescending(x => x.UserId).ToList(),
            nameof(HomecareService.ServiceType) => _sortAsc ? data.OrderBy(x => x.ServiceType).ToList() : data.OrderByDescending(x => x.ServiceType).ToList(),
            nameof(HomecareService.Status) => _sortAsc ? data.OrderBy(x => x.Status).ToList() : data.OrderByDescending(x => x.Status).ToList(),
            nameof(HomecareService.ScheduledDate) => _sortAsc ? data.OrderBy(x => x.ScheduledDate).ToList() : data.OrderByDescending(x => x.ScheduledDate).ToList(),
            _ => data
        };
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
        ApplyFilter();
    }

    private string SortIcon(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAsc ? "▲" : "▼";
    }

    private IEnumerable<HomecareService> PagedItems => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private void GoPage(int p) { if (p < 1 || p > _totalPages) return; _page = p; }

    private void OpenCreateForm()
    {
        ResetForm();
        _showForm = true;
    }

    private void OpenEditForm(HomecareService h)
    {
        _showForm = true;
        _isEdit = true;
        _editId = h.Id;
        _formUserId = h.UserId;
        _formType = h.ServiceType;
        _formStatus = h.Status;
        _formDate = h.ScheduledDate.ToString("yyyy-MM-dd");
        _formAddress = h.Address ?? "";
        _formFee = h.Fee;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formMsg = null;
    }

    private async Task Save()
    {
        _formMsg = null;
        if (string.IsNullOrWhiteSpace(_formUserId)) { _formMsg = "UserId wajib diisi."; return; }

        var date = DateTime.TryParse(_formDate, out var d) ? d : DateTime.UtcNow;

        if (_isEdit)
        {
            var h = _all.FirstOrDefault(x => x.Id == _editId);
            if (h == null) return;
            h.UserId = _formUserId.Trim();
            h.ServiceType = _formType;
            h.Status = _formStatus;
            h.ScheduledDate = date;
            h.Address = _formAddress.Trim();
            h.Fee = _formFee;
            await HomecareServiceApi.UpdateAsync(h);
        }
        else
        {
            var h = new HomecareService
            {
                UserId = _formUserId.Trim(),
                ServiceType = _formType,
                Status = _formStatus,
                ScheduledDate = date,
                Address = _formAddress.Trim(),
                Fee = _formFee,
                CreatedAt = DateTime.UtcNow
            };
            await HomecareServiceApi.CreateAsync(h);
        }

        CloseForm();
        await LoadData();
    }

    private async Task Delete(HomecareService h)
    {
        await HomecareServiceApi.DeleteAsync(h.Id);
        await LoadData();
    }

    private void ResetForm()
    {
        _isEdit = false;
        _editId = "";
        _formUserId = "";
        _formType = HomecareServiceType.LabTest;
        _formStatus = HomecareServiceStatus.Requested;
        _formDate = DateTime.Now.ToString("yyyy-MM-dd");
        _formAddress = "";
        _formFee = 0;
        _formMsg = null;
    }
}
