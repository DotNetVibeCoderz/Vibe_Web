@page "/admin/appointments"
@rendermode InteractiveServer
@attribute [Authorize(Roles = VirtualDoctor.Models.AppRoles.Admin)]
@using VirtualDoctor.Models
@inject Services.IAppointmentService AppointmentService
@inject Services.IAuthService AuthService

@if (!_isAdmin)
{
    <div class="vd-card text-center p-5 mt-5">
        <i class="bi bi-shield-lock-fill" style="font-size:4rem;color:var(--vd-danger);"></i>
        <h3 class="mt-3">Akses Ditolak</h3>
        <p class="vd-text-muted">Halaman ini hanya untuk administrator.</p>
        <a href="/" class="vd-btn vd-btn-primary">Kembali ke Beranda</a>
    </div>
}
else
{
    <div class="vd-mb-2 vd-flex vd-flex-between">
        <div>
            <h3 class="mb-0"><i class="bi bi-calendar2-check"></i> Master Booking</h3>
            <small class="vd-text-muted">CRUD + Export + Filter + Paging</small>
        </div>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="OpenCreateForm"><i class="bi bi-plus-circle"></i> Tambah Booking</button>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/appointments?format=csv"><i class="bi bi-filetype-csv"></i> CSV</a>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/appointments?format=xlsx"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        </div>
    </div>

    <div class="vd-card vd-mb-2">
        <div class="vd-grid vd-grid-3">
            <div><label class="vd-form-label">Cari</label><input class="vd-form-control" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="UserId / DoctorId" /></div>
            <div><label class="vd-form-label">Status</label><select class="vd-form-control" @bind="_statusFilter" @bind:after="ApplyFilter"><option value="">Semua</option>@foreach (var s in Enum.GetValues<AppointmentStatus>()) { <option value="@s">@s</option> }</select></div>
            <div><label class="vd-form-label">Page Size</label><select class="vd-form-control" @bind="_pageSize" @bind:after="ApplyFilter"><option value="5">5</option><option value="10">10</option><option value="20">20</option></select></div>
        </div>
    </div>

    <div class="vd-card" style="overflow-x:auto;">
        <table class="vd-table">
            <thead><tr>
                <th @onclick="() => SortBy(nameof(Appointment.UserId))" style="cursor:pointer;">User <span class="ms-1">@SortIcon(nameof(Appointment.UserId))</span></th>
                <th @onclick="() => SortBy(nameof(Appointment.DoctorId))" style="cursor:pointer;">Doctor <span class="ms-1">@SortIcon(nameof(Appointment.DoctorId))</span></th>
                <th @onclick="() => SortBy(nameof(Appointment.AppointmentDate))" style="cursor:pointer;">Tanggal <span class="ms-1">@SortIcon(nameof(Appointment.AppointmentDate))</span></th>
                <th>Jam</th>
                <th @onclick="() => SortBy(nameof(Appointment.Status))" style="cursor:pointer;">Status <span class="ms-1">@SortIcon(nameof(Appointment.Status))</span></th>
                <th style="width:120px;">Aksi</th></tr></thead>
            <tbody>
                @foreach (var a in PagedItems)
                {
                    <tr>
                        <td>@a.UserId</td>
                        <td>@a.DoctorId</td>
                        <td>@a.AppointmentDate.ToString("dd/MM/yyyy")</td>
                        <td>@a.StartTime.ToString(@"hh\:mm") - @a.EndTime.ToString(@"hh\:mm")</td>
                        <td>@a.Status</td>
                        <td>
                            <div class="vd-flex vd-gap-1">
                                <button class="vd-btn vd-btn-outline vd-btn-sm" @onclick="() => OpenEditForm(a)"><i class="bi bi-pencil"></i></button>
                                <button class="vd-btn vd-btn-outline vd-btn-sm" style="color:var(--vd-danger);" @onclick="() => Delete(a)"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="vd-flex vd-flex-between mt-2">
        <small class="vd-text-muted">Hal @_page/@_totalPages · Total @_filtered.Count</small>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page <= 1)" @onclick="() => GoPage(_page - 1)">◀</button>
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page >= _totalPages)" @onclick="() => GoPage(_page + 1)">▶</button>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="vd-modal-overlay" @onclick="CloseForm">
        <div class="vd-modal-content" @onclick:stopPropagation="true">
            <div class="vd-card-header">
                <span class="vd-card-title">@(_isEdit ? "✏️ Edit Booking" : "➕ Tambah Booking")</span>
                <button class="btn btn-icon" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="vd-grid vd-grid-2">
                <div class="vd-form-group"><label class="vd-form-label">UserId</label><input class="vd-form-control" @bind="_formUserId" /></div>
                <div class="vd-form-group"><label class="vd-form-label">DoctorId</label><input class="vd-form-control" @bind="_formDoctorId" /></div>
                <div class="vd-form-group"><label class="vd-form-label">HospitalId</label><input class="vd-form-control" @bind="_formHospitalId" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Tanggal (yyyy-MM-dd)</label><input type="text" class="vd-form-control" @bind="_formDate" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Mulai (HH:mm)</label><input type="text" class="vd-form-control" @bind="_formStart" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Selesai (HH:mm)</label><input type="text" class="vd-form-control" @bind="_formEnd" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Tipe</label><select class="vd-form-control" @bind="_formType">@foreach (var t in Enum.GetValues<AppointmentType>()) { <option value="@t">@t</option> }</select></div>
                <div class="vd-form-group"><label class="vd-form-label">Status</label><select class="vd-form-control" @bind="_formStatus">@foreach (var s in Enum.GetValues<AppointmentStatus>()) { <option value="@s">@s</option> }</select></div>
                <div class="vd-form-group"><label class="vd-form-label">Estimasi Biaya</label><input type="number" class="vd-form-control" @bind="_formCost" /></div>
            </div>
            <div class="vd-flex vd-gap-1" style="justify-content:flex-end;">
                <button class="vd-btn vd-btn-outline" @onclick="CloseForm">Batal</button>
                <button class="vd-btn vd-btn-primary" @onclick="Save">💾 Simpan</button>
            </div>
            @if (!string.IsNullOrEmpty(_formMsg)) { <small class="vd-text-muted d-block mt-1">@_formMsg</small> }
        </div>
    </div>
}

@code {
    private bool _isAdmin;
    private List<Appointment> _all = new();
    private List<Appointment> _filtered = new();
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private string _search = "";
    private string _statusFilter = "";
    private string _sortColumn = nameof(Appointment.AppointmentDate);
    private bool _sortAsc = false;

    private bool _showForm;
    private bool _isEdit;
    private string _editId = "";
    private string _formUserId = "";
    private string _formDoctorId = "";
    private string _formHospitalId = "";
    private string _formDate = DateTime.Now.ToString("yyyy-MM-dd");
    private string _formStart = "09:00";
    private string _formEnd = "09:30";
    private AppointmentType _formType = AppointmentType.InPerson;
    private AppointmentStatus _formStatus = AppointmentStatus.Scheduled;
    private decimal _formCost = 0;
    private string? _formMsg;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = AuthService.IsAdmin();
        if (!_isAdmin) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        _all = await AppointmentService.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim();
        _filtered = _all.Where(a =>
            (string.IsNullOrEmpty(q) || a.UserId.Contains(q, StringComparison.OrdinalIgnoreCase) || a.DoctorId.Contains(q, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_statusFilter) || a.Status.ToString() == _statusFilter)
        ).ToList();
        _filtered = ApplySort(_filtered);
        _page = 1;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    }

    private List<Appointment> ApplySort(List<Appointment> data)
    {
        return _sortColumn switch
        {
            nameof(Appointment.UserId) => _sortAsc ? data.OrderBy(x => x.UserId).ToList() : data.OrderByDescending(x => x.UserId).ToList(),
            nameof(Appointment.DoctorId) => _sortAsc ? data.OrderBy(x => x.DoctorId).ToList() : data.OrderByDescending(x => x.DoctorId).ToList(),
            nameof(Appointment.AppointmentDate) => _sortAsc ? data.OrderBy(x => x.AppointmentDate).ToList() : data.OrderByDescending(x => x.AppointmentDate).ToList(),
            nameof(Appointment.Status) => _sortAsc ? data.OrderBy(x => x.Status).ToList() : data.OrderByDescending(x => x.Status).ToList(),
            _ => data
        };
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
        ApplyFilter();
    }

    private string SortIcon(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAsc ? "▲" : "▼";
    }

    private IEnumerable<Appointment> PagedItems => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private void GoPage(int p) { if (p < 1 || p > _totalPages) return; _page = p; }

    private void OpenCreateForm()
    {
        ResetForm();
        _showForm = true;
    }

    private void OpenEditForm(Appointment a)
    {
        _showForm = true;
        _isEdit = true;
        _editId = a.Id;
        _formUserId = a.UserId;
        _formDoctorId = a.DoctorId;
        _formHospitalId = a.HospitalId ?? "";
        _formDate = a.AppointmentDate.ToString("yyyy-MM-dd");
        _formStart = a.StartTime.ToString(@"hh\:mm");
        _formEnd = a.EndTime.ToString(@"hh\:mm");
        _formType = a.Type;
        _formStatus = a.Status;
        _formCost = a.EstimatedCost;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formMsg = null;
    }

    private async Task Save()
    {
        _formMsg = null;
        if (string.IsNullOrWhiteSpace(_formUserId) || string.IsNullOrWhiteSpace(_formDoctorId))
        {
            _formMsg = "UserId dan DoctorId wajib diisi.";
            return;
        }

        var date = DateTime.TryParse(_formDate, out var d) ? d : DateTime.UtcNow;
        var start = TimeSpan.TryParse(_formStart, out var st) ? st : new TimeSpan(9, 0, 0);
        var end = TimeSpan.TryParse(_formEnd, out var et) ? et : new TimeSpan(9, 30, 0);

        if (_isEdit)
        {
            var a = _all.FirstOrDefault(x => x.Id == _editId);
            if (a == null) return;
            a.UserId = _formUserId.Trim();
            a.DoctorId = _formDoctorId.Trim();
            a.HospitalId = string.IsNullOrWhiteSpace(_formHospitalId) ? null : _formHospitalId.Trim();
            a.AppointmentDate = date;
            a.StartTime = start;
            a.EndTime = end;
            a.Type = _formType;
            a.Status = _formStatus;
            a.EstimatedCost = _formCost;
            await AppointmentService.UpdateAsync(a);
        }
        else
        {
            var a = new Appointment
            {
                UserId = _formUserId.Trim(),
                DoctorId = _formDoctorId.Trim(),
                HospitalId = string.IsNullOrWhiteSpace(_formHospitalId) ? null : _formHospitalId.Trim(),
                AppointmentDate = date,
                StartTime = start,
                EndTime = end,
                Type = _formType,
                Status = _formStatus,
                EstimatedCost = _formCost,
                CreatedAt = DateTime.UtcNow
            };
            await AppointmentService.CreateAsync(a);
        }

        CloseForm();
        await LoadData();
    }

    private async Task Delete(Appointment a)
    {
        await AppointmentService.DeleteAsync(a.Id);
        await LoadData();
    }

    private void ResetForm()
    {
        _isEdit = false;
        _editId = "";
        _formUserId = "";
        _formDoctorId = "";
        _formHospitalId = "";
        _formDate = DateTime.Now.ToString("yyyy-MM-dd");
        _formStart = "09:00";
        _formEnd = "09:30";
        _formType = AppointmentType.InPerson;
        _formStatus = AppointmentStatus.Scheduled;
        _formCost = 0;
        _formMsg = null;
    }
}
