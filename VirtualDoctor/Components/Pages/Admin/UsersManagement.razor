@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = VirtualDoctor.Models.AppRoles.Admin)]
@inject Services.IUserService UserService
@inject Services.IAuthService AuthService

@if (!_isAdmin)
{
    <div class="vd-card text-center p-5 mt-5">
        <i class="bi bi-shield-lock-fill" style="font-size:4rem;color:var(--vd-danger);"></i>
        <h3 class="mt-3">Akses Ditolak</h3>
        <p class="vd-text-muted">Halaman ini hanya untuk administrator.</p>
        <a href="/" class="vd-btn vd-btn-primary">Kembali ke Beranda</a>
    </div>
}
else
{
    <div class="vd-mb-2 vd-flex vd-flex-between">
        <div>
            <h3 class="mb-0"><i class="bi bi-people"></i> Master Users</h3>
            <small class="vd-text-muted">CRUD + Export + Filter + Paging</small>
        </div>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="OpenCreateForm"><i class="bi bi-plus-circle"></i> Tambah User</button>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/users?format=csv"><i class="bi bi-filetype-csv"></i> CSV</a>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/users?format=xlsx"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        </div>
    </div>

    <div class="vd-card vd-mb-2">
        <div class="vd-grid vd-grid-3">
            <div>
                <label class="vd-form-label">Cari</label>
                <input class="vd-form-control" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Nama / Email" />
            </div>
            <div>
                <label class="vd-form-label">Status</label>
                <select class="vd-form-control" @bind="_statusFilter" @bind:after="ApplyFilter">
                    <option value="">Semua</option>
                    <option value="active">Aktif</option>
                    <option value="inactive">Nonaktif</option>
                </select>
            </div>
            <div>
                <label class="vd-form-label">Page Size</label>
                <select class="vd-form-control" @bind="_pageSize" @bind:after="ApplyFilter">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </div>
        </div>
    </div>

    <div class="vd-card" style="overflow-x:auto;">
        <table class="vd-table">
            <thead>
                <tr>
                    <th @onclick="() => SortBy(nameof(VirtualDoctor.Models.ApplicationUser.FullName))" style="cursor:pointer;">Nama <span class="ms-1">@SortIcon(nameof(VirtualDoctor.Models.ApplicationUser.FullName))</span></th>
                    <th @onclick="() => SortBy(nameof(VirtualDoctor.Models.ApplicationUser.Email))" style="cursor:pointer;">Email <span class="ms-1">@SortIcon(nameof(VirtualDoctor.Models.ApplicationUser.Email))</span></th>
                    <th>Telepon</th>
                    <th>Peran</th>
                    <th>Status</th>
                    <th @onclick="() => SortBy(nameof(VirtualDoctor.Models.ApplicationUser.CreatedAt))" style="cursor:pointer;">Created <span class="ms-1">@SortIcon(nameof(VirtualDoctor.Models.ApplicationUser.CreatedAt))</span></th>
                    <th style="width:160px;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in PagedItems)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@(u.PhoneNumber ?? "-")</td>
                        <td>
                            @foreach (var role in RolesOf(u.Id))
                            {
                                <span class="vd-pill @RolePillClass(role)">@VirtualDoctor.Models.AppRoles.Label(role)</span>
                            }
                        </td>
                        <td>@(u.IsActive ? "Aktif" : "Nonaktif")</td>
                        <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="vd-flex vd-gap-1">
                                <button class="vd-btn vd-btn-outline vd-btn-sm" title="Ubah peran"
                                        aria-label="Ubah peran @u.FullName" @onclick="() => OpenRoleForm(u)">
                                    <i class="bi bi-person-gear"></i>
                                </button>
                                <button class="vd-btn vd-btn-outline vd-btn-sm" title="Ubah data"
                                        aria-label="Ubah data @u.FullName" @onclick="() => OpenEditForm(u)"><i class="bi bi-pencil"></i></button>
                                <button class="vd-btn vd-btn-outline vd-btn-sm" style="color:var(--vd-danger);" title="Nonaktifkan"
                                        aria-label="Nonaktifkan @u.FullName" @onclick="() => Delete(u)"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="vd-flex vd-flex-between mt-2">
        <small class="vd-text-muted">Hal @_page/@_totalPages · Total @_filtered.Count</small>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page <= 1)" @onclick="() => GoPage(_page - 1)">◀</button>
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page >= _totalPages)" @onclick="() => GoPage(_page + 1)">▶</button>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="vd-modal-overlay" @onclick="CloseForm">
        <div class="vd-modal-content" @onclick:stopPropagation="true">
            <div class="vd-card-header">
                <span class="vd-card-title">@(_isEdit ? "✏️ Edit User" : "➕ Tambah User")</span>
                <button class="btn btn-icon" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="vd-grid vd-grid-2">
                <div class="vd-form-group"><label class="vd-form-label">Nama Lengkap</label><input class="vd-form-control" @bind="_formFullName" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Email</label><input class="vd-form-control" @bind="_formEmail" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Telepon</label><input class="vd-form-control" @bind="_formPhone" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Alamat</label><input class="vd-form-control" @bind="_formAddress" /></div>
                @if (!_isEdit)
                {
                    <div class="vd-form-group"><label class="vd-form-label">Password</label><input type="password" class="vd-form-control" @bind="_formPassword" /></div>
                }
                <div class="vd-form-group"><label class="vd-form-label">Status Aktif</label><select class="vd-form-control" @bind="_formIsActive"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div>
            </div>
            <div class="vd-flex vd-gap-1" style="justify-content:flex-end;">
                <button class="vd-btn vd-btn-outline" @onclick="CloseForm">Batal</button>
                <button class="vd-btn vd-btn-primary" @onclick="Save">💾 Simpan</button>
            </div>
            @if (!string.IsNullOrEmpty(_formMsg)) { <small class="vd-text-muted d-block mt-1">@_formMsg</small> }
        </div>
    </div>
}

@if (_roleUser != null)
{
    <div class="vd-modal-overlay" @onclick="CloseRoleForm">
        <div class="vd-modal-content" @onclick:stopPropagation="true" style="max-width:520px;"
             role="dialog" aria-modal="true" aria-label="Ubah peran pengguna">
            <div class="vd-card-header">
                <span class="vd-card-title">Peran · @_roleUser.FullName</span>
                <button class="btn btn-icon" @onclick="CloseRoleForm" aria-label="Tutup"><i class="bi bi-x-lg"></i></button>
            </div>

            <p class="vd-text-muted" style="font-size:0.86rem;">
                Peran menentukan halaman yang dapat dibuka. Perubahan berlaku saat pengguna
                masuk berikutnya, karena peran disimpan di dalam cookie sesi.
            </p>

            @foreach (var role in VirtualDoctor.Models.AppRoles.All)
            {
                var current = role;
                <label class="vd-flex vd-gap-1 vd-mb-1" style="align-items:flex-start;cursor:pointer;">
                    <input type="checkbox" checked="@_roleSelection.Contains(current)"
                           @onchange="e => ToggleRole(current, e)" style="margin-top:4px;" />
                    <span>
                        <strong>@VirtualDoctor.Models.AppRoles.Label(current)</strong><br />
                        <small class="vd-text-muted">@RoleDescription(current)</small>
                    </span>
                </label>
            }

            @if (!string.IsNullOrEmpty(_roleMsg))
            {
                <div class="vd-toast-item is-error vd-mb-2" role="alert">
                    <div><div class="vd-toast-body">@_roleMsg</div></div>
                </div>
            }

            <div class="vd-flex vd-gap-1" style="justify-content:flex-end;">
                <button class="vd-btn vd-btn-outline" @onclick="CloseRoleForm">Batal</button>
                <button class="vd-btn vd-btn-primary" @onclick="SaveRoles" disabled="@_savingRoles">
                    <i class="bi @(_savingRoles ? "bi-arrow-repeat spin" : "bi-check2")"></i> Simpan peran
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isAdmin;
    private Dictionary<string, List<string>> _roles = new();
    private VirtualDoctor.Models.ApplicationUser? _roleUser;
    private HashSet<string> _roleSelection = new();
    private bool _savingRoles;
    private string? _roleMsg;
    private List<VirtualDoctor.Models.ApplicationUser> _all = new();
    private List<VirtualDoctor.Models.ApplicationUser> _filtered = new();
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private string _search = "";
    private string _statusFilter = "";
    private string _sortColumn = nameof(VirtualDoctor.Models.ApplicationUser.CreatedAt);
    private bool _sortAsc = false;

    private bool _showForm;
    private bool _isEdit;
    private string _editId = "";
    private string _formFullName = "";
    private string _formEmail = "";
    private string _formPhone = "";
    private string _formAddress = "";
    private string _formPassword = "Password123!";
    private bool _formIsActive = true;
    private string? _formMsg;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = AuthService.IsAdmin();
        if (!_isAdmin) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        _all = await UserService.GetAllAsync();
        _roles = await AuthService.GetRolesForAllAsync();
        ApplyFilter();
    }

    // ============ Peran ============

    private IEnumerable<string> RolesOf(string userId) =>
        _roles.TryGetValue(userId, out var list) && list.Count > 0
            ? list.OrderBy(r => r)
            : new[] { VirtualDoctor.Models.AppRoles.Patient };

    private static string RolePillClass(string role) => role switch
    {
        VirtualDoctor.Models.AppRoles.Admin => "vd-pill-danger",
        VirtualDoctor.Models.AppRoles.Doctor => "vd-pill-info",
        _ => "vd-pill-neutral"
    };

    private static string RoleDescription(string role) => role switch
    {
        VirtualDoctor.Models.AppRoles.Admin => "Akses penuh ke seluruh backoffice dan pengaturan sistem.",
        VirtualDoctor.Models.AppRoles.Doctor => "Membuka antrean konsultasi dan janji temu miliknya sendiri.",
        _ => "Akses layanan pasien: konsultasi, farmasi, homecare, dan janji temu."
    };

    private void OpenRoleForm(VirtualDoctor.Models.ApplicationUser user)
    {
        _roleUser = user;
        _roleSelection = RolesOf(user.Id).ToHashSet();
        _roleMsg = null;
    }

    private void CloseRoleForm()
    {
        _roleUser = null;
        _roleMsg = null;
    }

    private void ToggleRole(string role, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _roleSelection.Add(role);
        else _roleSelection.Remove(role);
    }

    private async Task SaveRoles()
    {
        if (_roleUser == null) return;
        _savingRoles = true;
        _roleMsg = null;
        try
        {
            if (_roleSelection.Count == 0)
            {
                _roleMsg = "Pilih minimal satu peran.";
                return;
            }

            var actor = await AuthService.GetCurrentUserAsync();
            var ok = await AuthService.SetRolesAsync(_roleUser.Id, _roleSelection, actor?.Email);

            if (!ok)
            {
                _roleMsg = "Peran administrator terakhir tidak dapat dicabut. Tunjuk administrator lain lebih dulu.";
                return;
            }

            await LoadData();
            _roleUser = null;
        }
        finally { _savingRoles = false; }
    }

    private void ApplyFilter()
    {
        var q = _search.Trim();
        _filtered = _all.Where(u =>
            (string.IsNullOrEmpty(q) || u.FullName.Contains(q, StringComparison.OrdinalIgnoreCase) || u.Email.Contains(q, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_statusFilter) || (_statusFilter == "active" && u.IsActive) || (_statusFilter == "inactive" && !u.IsActive))
        ).ToList();

        _filtered = ApplySort(_filtered);
        _page = 1;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    }

    private List<VirtualDoctor.Models.ApplicationUser> ApplySort(List<VirtualDoctor.Models.ApplicationUser> data)
    {
        return _sortColumn switch
        {
            nameof(VirtualDoctor.Models.ApplicationUser.FullName) => _sortAsc ? data.OrderBy(x => x.FullName).ToList() : data.OrderByDescending(x => x.FullName).ToList(),
            nameof(VirtualDoctor.Models.ApplicationUser.Email) => _sortAsc ? data.OrderBy(x => x.Email).ToList() : data.OrderByDescending(x => x.Email).ToList(),
            nameof(VirtualDoctor.Models.ApplicationUser.CreatedAt) => _sortAsc ? data.OrderBy(x => x.CreatedAt).ToList() : data.OrderByDescending(x => x.CreatedAt).ToList(),
            _ => data
        };
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
        ApplyFilter();
    }

    private string SortIcon(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAsc ? "▲" : "▼";
    }

    private IEnumerable<VirtualDoctor.Models.ApplicationUser> PagedItems
        => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private void GoPage(int p)
    {
        if (p < 1 || p > _totalPages) return;
        _page = p;
    }

    private void OpenCreateForm()
    {
        ResetForm();
        _showForm = true;
    }

    private void OpenEditForm(VirtualDoctor.Models.ApplicationUser u)
    {
        _showForm = true;
        _isEdit = true;
        _editId = u.Id;
        _formFullName = u.FullName;
        _formEmail = u.Email;
        _formPhone = u.PhoneNumber ?? "";
        _formAddress = u.Address ?? "";
        _formIsActive = u.IsActive;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formMsg = null;
    }

    private async Task Save()
    {
        _formMsg = null;
        if (string.IsNullOrWhiteSpace(_formFullName) || string.IsNullOrWhiteSpace(_formEmail))
        {
            _formMsg = "Nama dan email wajib diisi.";
            return;
        }

        if (_isEdit)
        {
            var user = _all.FirstOrDefault(u => u.Id == _editId);
            if (user == null) return;
            user.FullName = _formFullName.Trim();
            user.Email = _formEmail.Trim();
            user.PhoneNumber = _formPhone.Trim();
            user.Address = _formAddress.Trim();
            user.IsActive = _formIsActive;
            await UserService.UpdateAsync(user);
        }
        else
        {
            var user = new VirtualDoctor.Models.ApplicationUser
            {
                FullName = _formFullName.Trim(),
                Email = _formEmail.Trim(),
                PhoneNumber = _formPhone.Trim(),
                Address = _formAddress.Trim(),
                IsActive = _formIsActive,
                CreatedAt = DateTime.UtcNow
            };

            var password = string.IsNullOrWhiteSpace(_formPassword) ? "Password123!" : _formPassword;
            await UserService.CreateAsync(user, password);
        }

        CloseForm();
        await LoadData();
    }

    private async Task Delete(VirtualDoctor.Models.ApplicationUser u)
    {
        await UserService.DeleteAsync(u.Id);
        await LoadData();
    }

    private void ResetForm()
    {
        _isEdit = false;
        _editId = "";
        _formFullName = "";
        _formEmail = "";
        _formPhone = "";
        _formAddress = "";
        _formPassword = "Password123!";
        _formIsActive = true;
        _formMsg = null;
    }
}
