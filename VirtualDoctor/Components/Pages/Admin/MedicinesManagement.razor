@page "/admin/medicines"
@rendermode InteractiveServer
@attribute [Authorize(Roles = VirtualDoctor.Models.AppRoles.Admin)]
@inject Services.IMedicineService MedicineService
@inject Services.IAuthService AuthService

@if (!_isAdmin)
{
    <div class="vd-card text-center p-5 mt-5">
        <i class="bi bi-shield-lock-fill" style="font-size:4rem;color:var(--vd-danger);"></i>
        <h3 class="mt-3">Akses Ditolak</h3>
        <p class="vd-text-muted">Halaman ini hanya untuk administrator.</p>
        <a href="/" class="vd-btn vd-btn-primary">Kembali ke Beranda</a>
    </div>
}
else
{
    <div class="vd-mb-2 vd-flex vd-flex-between">
        <div>
            <h3 class="mb-0"><i class="bi bi-capsule"></i> Master Obat</h3>
            <small class="vd-text-muted">CRUD + Export + Filter + Paging</small>
        </div>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="OpenCreateForm"><i class="bi bi-plus-circle"></i> Tambah Obat</button>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/medicines?format=csv"><i class="bi bi-filetype-csv"></i> CSV</a>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/medicines?format=xlsx"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        </div>
    </div>

    <div class="vd-card vd-mb-2">
        <div class="vd-grid vd-grid-3">
            <div><label class="vd-form-label">Cari</label><input class="vd-form-control" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Nama / Kategori" /></div>
            <div><label class="vd-form-label">Status</label><select class="vd-form-control" @bind="_statusFilter" @bind:after="ApplyFilter"><option value="">Semua</option><option value="active">Aktif</option><option value="inactive">Nonaktif</option></select></div>
            <div><label class="vd-form-label">Page Size</label><select class="vd-form-control" @bind="_pageSize" @bind:after="ApplyFilter"><option value="5">5</option><option value="10">10</option><option value="20">20</option></select></div>
        </div>
    </div>

    <div class="vd-card" style="overflow-x:auto;">
        <table class="vd-table">
            <thead><tr>
                <th @onclick="() => SortBy(nameof(VirtualDoctor.Models.Medicine.Name))" style="cursor:pointer;">Nama <span class="ms-1">@SortIcon(nameof(VirtualDoctor.Models.Medicine.Name))</span></th>
                <th @onclick="() => SortBy(nameof(VirtualDoctor.Models.Medicine.Category))" style="cursor:pointer;">Kategori <span class="ms-1">@SortIcon(nameof(VirtualDoctor.Models.Medicine.Category))</span></th>
                <th @onclick="() => SortBy(nameof(VirtualDoctor.Models.Medicine.Price))" style="cursor:pointer;">Harga <span class="ms-1">@SortIcon(nameof(VirtualDoctor.Models.Medicine.Price))</span></th>
                <th>Stok</th><th>Aktif</th><th style="width:120px;">Aksi</th></tr></thead>
            <tbody>
                @foreach (var m in PagedItems)
                {
                    <tr>
                        <td>@m.Name</td>
                        <td>@m.Category</td>
                        <td>Rp@(m.Price.ToString("N0"))</td>
                        <td>@m.Stock</td>
                        <td>@(m.IsActive ? "Aktif" : "Nonaktif")</td>
                        <td>
                            <div class="vd-flex vd-gap-1">
                                <button class="vd-btn vd-btn-outline vd-btn-sm" @onclick="() => OpenEditForm(m)"><i class="bi bi-pencil"></i></button>
                                <button class="vd-btn vd-btn-outline vd-btn-sm" style="color:var(--vd-danger);" @onclick="() => Delete(m)"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="vd-flex vd-flex-between mt-2">
        <small class="vd-text-muted">Hal @_page/@_totalPages · Total @_filtered.Count</small>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page <= 1)" @onclick="() => GoPage(_page - 1)">◀</button>
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page >= _totalPages)" @onclick="() => GoPage(_page + 1)">▶</button>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="vd-modal-overlay" @onclick="CloseForm">
        <div class="vd-modal-content" @onclick:stopPropagation="true">
            <div class="vd-card-header">
                <span class="vd-card-title">@(_isEdit ? "✏️ Edit Obat" : "➕ Tambah Obat")</span>
                <button class="btn btn-icon" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="vd-grid vd-grid-2">
                <div class="vd-form-group"><label class="vd-form-label">Nama</label><input class="vd-form-control" @bind="_formName" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Kategori</label><input class="vd-form-control" @bind="_formCategory" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Harga</label><input type="number" class="vd-form-control" @bind="_formPrice" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Stok</label><input type="number" class="vd-form-control" @bind="_formStock" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Resep?</label><select class="vd-form-control" @bind="_formRx"><option value="false">Tidak</option><option value="true">Ya</option></select></div>
                <div class="vd-form-group"><label class="vd-form-label">Aktif</label><select class="vd-form-control" @bind="_formActive"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div>
            </div>
            <div class="vd-flex vd-gap-1" style="justify-content:flex-end;">
                <button class="vd-btn vd-btn-outline" @onclick="CloseForm">Batal</button>
                <button class="vd-btn vd-btn-primary" @onclick="Save">💾 Simpan</button>
            </div>
            @if (!string.IsNullOrEmpty(_formMsg)) { <small class="vd-text-muted d-block mt-1">@_formMsg</small> }
        </div>
    </div>
}

@code {
    private bool _isAdmin;
    private List<VirtualDoctor.Models.Medicine> _all = new();
    private List<VirtualDoctor.Models.Medicine> _filtered = new();
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private string _search = "";
    private string _statusFilter = "";
    private string _sortColumn = nameof(VirtualDoctor.Models.Medicine.Name);
    private bool _sortAsc = true;

    private bool _showForm;
    private bool _isEdit;
    private string _editId = "";
    private string _formName = "";
    private string _formCategory = "";
    private decimal _formPrice = 0;
    private int _formStock = 0;
    private bool _formRx = false;
    private bool _formActive = true;
    private string? _formMsg;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = AuthService.IsAdmin();
        if (!_isAdmin) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        _all = await MedicineService.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim();
        _filtered = _all.Where(m =>
            (string.IsNullOrEmpty(q) || m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || m.Category.Contains(q, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_statusFilter) || (_statusFilter == "active" && m.IsActive) || (_statusFilter == "inactive" && !m.IsActive))
        ).ToList();
        _filtered = ApplySort(_filtered);
        _page = 1;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    }

    private List<VirtualDoctor.Models.Medicine> ApplySort(List<VirtualDoctor.Models.Medicine> data)
    {
        return _sortColumn switch
        {
            nameof(VirtualDoctor.Models.Medicine.Name) => _sortAsc ? data.OrderBy(x => x.Name).ToList() : data.OrderByDescending(x => x.Name).ToList(),
            nameof(VirtualDoctor.Models.Medicine.Category) => _sortAsc ? data.OrderBy(x => x.Category).ToList() : data.OrderByDescending(x => x.Category).ToList(),
            nameof(VirtualDoctor.Models.Medicine.Price) => _sortAsc ? data.OrderBy(x => x.Price).ToList() : data.OrderByDescending(x => x.Price).ToList(),
            _ => data
        };
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
        ApplyFilter();
    }

    private string SortIcon(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAsc ? "▲" : "▼";
    }

    private IEnumerable<VirtualDoctor.Models.Medicine> PagedItems => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private void GoPage(int p) { if (p < 1 || p > _totalPages) return; _page = p; }

    private void OpenCreateForm()
    {
        ResetForm();
        _showForm = true;
    }

    private void OpenEditForm(VirtualDoctor.Models.Medicine m)
    {
        _showForm = true;
        _isEdit = true;
        _editId = m.Id;
        _formName = m.Name;
        _formCategory = m.Category;
        _formPrice = m.Price;
        _formStock = m.Stock;
        _formRx = m.RequiresPrescription;
        _formActive = m.IsActive;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formMsg = null;
    }

    private async Task Save()
    {
        _formMsg = null;
        if (string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formCategory)) { _formMsg = "Nama dan kategori wajib diisi."; return; }

        if (_isEdit)
        {
            var m = _all.FirstOrDefault(x => x.Id == _editId);
            if (m == null) return;
            m.Name = _formName.Trim();
            m.Category = _formCategory.Trim();
            m.Price = _formPrice;
            m.Stock = _formStock;
            m.RequiresPrescription = _formRx;
            m.IsActive = _formActive;
            await MedicineService.UpdateAsync(m);
        }
        else
        {
            var m = new VirtualDoctor.Models.Medicine
            {
                Name = _formName.Trim(),
                Category = _formCategory.Trim(),
                Price = _formPrice,
                Stock = _formStock,
                RequiresPrescription = _formRx,
                IsActive = _formActive,
                CreatedAt = DateTime.UtcNow
            };
            await MedicineService.CreateAsync(m);
        }

        CloseForm();
        await LoadData();
    }

    private async Task Delete(VirtualDoctor.Models.Medicine m)
    {
        await MedicineService.DeleteAsync(m.Id);
        await LoadData();
    }

    private void ResetForm()
    {
        _isEdit = false;
        _editId = "";
        _formName = "";
        _formCategory = "";
        _formPrice = 0;
        _formStock = 0;
        _formRx = false;
        _formActive = true;
        _formMsg = null;
    }
}
