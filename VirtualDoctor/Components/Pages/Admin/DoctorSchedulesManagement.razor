@page "/admin/doctor-schedules"
@rendermode InteractiveServer
@attribute [Authorize(Roles = VirtualDoctor.Models.AppRoles.Admin)]
@using VirtualDoctor.Models
@inject Services.IDoctorScheduleService ScheduleService
@inject Services.IAuthService AuthService

@if (!_isAdmin)
{
    <div class="vd-card text-center p-5 mt-5">
        <i class="bi bi-shield-lock-fill" style="font-size:4rem;color:var(--vd-danger);"></i>
        <h3 class="mt-3">Akses Ditolak</h3>
        <p class="vd-text-muted">Halaman ini hanya untuk administrator.</p>
        <a href="/" class="vd-btn vd-btn-primary">Kembali ke Beranda</a>
    </div>
}
else
{
    <div class="vd-mb-2 vd-flex vd-flex-between">
        <div>
            <h3 class="mb-0"><i class="bi bi-clock"></i> Master Jadwal Dokter</h3>
            <small class="vd-text-muted">CRUD + Export + Filter + Paging</small>
        </div>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-primary vd-btn-sm" @onclick="OpenCreateForm"><i class="bi bi-plus-circle"></i> Tambah Jadwal</button>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/doctor-schedules?format=csv"><i class="bi bi-filetype-csv"></i> CSV</a>
            <a class="vd-btn vd-btn-outline vd-btn-sm" href="/admin/export/doctor-schedules?format=xlsx"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        </div>
    </div>

    <div class="vd-card vd-mb-2">
        <div class="vd-grid vd-grid-3">
            <div><label class="vd-form-label">Cari</label><input class="vd-form-control" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="DoctorId" /></div>
            <div><label class="vd-form-label">Hari</label><select class="vd-form-control" @bind="_dayFilter" @bind:after="ApplyFilter"><option value="">Semua</option>@foreach (var d in Enum.GetValues<DayOfWeek>()) { <option value="@d">@d</option> }</select></div>
            <div><label class="vd-form-label">Page Size</label><select class="vd-form-control" @bind="_pageSize" @bind:after="ApplyFilter"><option value="5">5</option><option value="10">10</option><option value="20">20</option></select></div>
        </div>
    </div>

    <div class="vd-card" style="overflow-x:auto;">
        <table class="vd-table">
            <thead><tr>
                <th @onclick="() => SortBy(nameof(DoctorSchedule.DoctorId))" style="cursor:pointer;">DoctorId <span class="ms-1">@SortIcon(nameof(DoctorSchedule.DoctorId))</span></th>
                <th @onclick="() => SortBy(nameof(DoctorSchedule.Day))" style="cursor:pointer;">Hari <span class="ms-1">@SortIcon(nameof(DoctorSchedule.Day))</span></th>
                <th @onclick="() => SortBy(nameof(DoctorSchedule.StartTime))" style="cursor:pointer;">Jam <span class="ms-1">@SortIcon(nameof(DoctorSchedule.StartTime))</span></th>
                <th>Max</th><th>Aktif</th><th style="width:120px;">Aksi</th></tr></thead>
            <tbody>
                @foreach (var s in PagedItems)
                {
                    <tr>
                        <td>@s.DoctorId</td>
                        <td>@s.Day</td>
                        <td>@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</td>
                        <td>@s.MaxPatients</td>
                        <td>@(s.IsActive ? "Aktif" : "Nonaktif")</td>
                        <td>
                            <div class="vd-flex vd-gap-1">
                                <button class="vd-btn vd-btn-outline vd-btn-sm" @onclick="() => OpenEditForm(s)"><i class="bi bi-pencil"></i></button>
                                <button class="vd-btn vd-btn-outline vd-btn-sm" style="color:var(--vd-danger);" @onclick="() => Delete(s)"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="vd-flex vd-flex-between mt-2">
        <small class="vd-text-muted">Hal @_page/@_totalPages · Total @_filtered.Count</small>
        <div class="vd-flex vd-gap-1">
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page <= 1)" @onclick="() => GoPage(_page - 1)">◀</button>
            <button class="vd-btn vd-btn-outline vd-btn-sm" disabled="@(_page >= _totalPages)" @onclick="() => GoPage(_page + 1)">▶</button>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="vd-modal-overlay" @onclick="CloseForm">
        <div class="vd-modal-content" @onclick:stopPropagation="true">
            <div class="vd-card-header">
                <span class="vd-card-title">@(_isEdit ? "✏️ Edit Jadwal" : "➕ Tambah Jadwal")</span>
                <button class="btn btn-icon" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="vd-grid vd-grid-2">
                <div class="vd-form-group"><label class="vd-form-label">DoctorId</label><input class="vd-form-control" @bind="_formDoctorId" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Hari</label><select class="vd-form-control" @bind="_formDay">@foreach (var d in Enum.GetValues<DayOfWeek>()) { <option value="@d">@d</option> }</select></div>
                <div class="vd-form-group"><label class="vd-form-label">Mulai (HH:mm)</label><input type="text" class="vd-form-control" @bind="_formStart" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Selesai (HH:mm)</label><input type="text" class="vd-form-control" @bind="_formEnd" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Max Pasien</label><input type="number" class="vd-form-control" @bind="_formMax" /></div>
                <div class="vd-form-group"><label class="vd-form-label">Aktif</label><select class="vd-form-control" @bind="_formActive"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div>
            </div>
            <div class="vd-flex vd-gap-1" style="justify-content:flex-end;">
                <button class="vd-btn vd-btn-outline" @onclick="CloseForm">Batal</button>
                <button class="vd-btn vd-btn-primary" @onclick="Save">💾 Simpan</button>
            </div>
            @if (!string.IsNullOrEmpty(_formMsg)) { <small class="vd-text-muted d-block mt-1">@_formMsg</small> }
        </div>
    </div>
}

@code {
    private bool _isAdmin;
    private List<DoctorSchedule> _all = new();
    private List<DoctorSchedule> _filtered = new();
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private string _search = "";
    private string _dayFilter = "";
    private string _sortColumn = nameof(DoctorSchedule.DoctorId);
    private bool _sortAsc = true;

    private bool _showForm;
    private bool _isEdit;
    private string _editId = "";
    private string _formDoctorId = "";
    private DayOfWeek _formDay = DayOfWeek.Monday;
    private string _formStart = "08:00";
    private string _formEnd = "16:00";
    private int _formMax = 10;
    private bool _formActive = true;
    private string? _formMsg;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = AuthService.IsAdmin();
        if (!_isAdmin) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        _all = await ScheduleService.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim();
        _filtered = _all.Where(s =>
            (string.IsNullOrEmpty(q) || s.DoctorId.Contains(q, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_dayFilter) || s.Day.ToString() == _dayFilter)
        ).ToList();
        _filtered = ApplySort(_filtered);
        _page = 1;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    }

    private List<DoctorSchedule> ApplySort(List<DoctorSchedule> data)
    {
        return _sortColumn switch
        {
            nameof(DoctorSchedule.DoctorId) => _sortAsc ? data.OrderBy(x => x.DoctorId).ToList() : data.OrderByDescending(x => x.DoctorId).ToList(),
            nameof(DoctorSchedule.Day) => _sortAsc ? data.OrderBy(x => x.Day).ToList() : data.OrderByDescending(x => x.Day).ToList(),
            nameof(DoctorSchedule.StartTime) => _sortAsc ? data.OrderBy(x => x.StartTime).ToList() : data.OrderByDescending(x => x.StartTime).ToList(),
            _ => data
        };
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
        ApplyFilter();
    }

    private string SortIcon(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAsc ? "▲" : "▼";
    }

    private IEnumerable<DoctorSchedule> PagedItems => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private void GoPage(int p) { if (p < 1 || p > _totalPages) return; _page = p; }

    private void OpenCreateForm()
    {
        ResetForm();
        _showForm = true;
    }

    private void OpenEditForm(DoctorSchedule s)
    {
        _showForm = true;
        _isEdit = true;
        _editId = s.Id;
        _formDoctorId = s.DoctorId;
        _formDay = s.Day;
        _formStart = s.StartTime.ToString(@"hh\:mm");
        _formEnd = s.EndTime.ToString(@"hh\:mm");
        _formMax = s.MaxPatients;
        _formActive = s.IsActive;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formMsg = null;
    }

    private async Task Save()
    {
        _formMsg = null;
        if (string.IsNullOrWhiteSpace(_formDoctorId)) { _formMsg = "DoctorId wajib diisi."; return; }

        var start = TimeSpan.TryParse(_formStart, out var st) ? st : new TimeSpan(8, 0, 0);
        var end = TimeSpan.TryParse(_formEnd, out var et) ? et : new TimeSpan(16, 0, 0);

        if (_isEdit)
        {
            var s = _all.FirstOrDefault(x => x.Id == _editId);
            if (s == null) return;
            s.DoctorId = _formDoctorId.Trim();
            s.Day = _formDay;
            s.StartTime = start;
            s.EndTime = end;
            s.MaxPatients = _formMax;
            s.IsActive = _formActive;
            await ScheduleService.UpdateAsync(s);
        }
        else
        {
            var s = new DoctorSchedule
            {
                DoctorId = _formDoctorId.Trim(),
                Day = _formDay,
                StartTime = start,
                EndTime = end,
                MaxPatients = _formMax,
                IsActive = _formActive
            };
            await ScheduleService.CreateAsync(s);
        }

        CloseForm();
        await LoadData();
    }

    private async Task Delete(DoctorSchedule s)
    {
        await ScheduleService.DeleteAsync(s.Id);
        await LoadData();
    }

    private void ResetForm()
    {
        _isEdit = false;
        _editId = "";
        _formDoctorId = "";
        _formDay = DayOfWeek.Monday;
        _formStart = "08:00";
        _formEnd = "16:00";
        _formMax = 10;
        _formActive = true;
        _formMsg = null;
    }
}
